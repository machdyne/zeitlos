# Written by release/zrelease for the duration of a release build and
# removed again afterwards. Ignored so that a build interrupted at the
# wrong moment cannot leave behind something that looks committable.
# See rtl/boards.vh's ZSPEC note and release/lib/gen.py.
/rtl/zspec.vh
/boards/.zrelease-*.lpf

# Build output
/output/

# Build products (BIOS, kernel, apps)
*.o
*.elf
*.map
*.asm
*.dasm
*.bit
*.svf
*.config
*.json
*.bin
!sw/data/images/zeitlos.bin
!sw/data/images/zeitlos_fb.bin
*.hex
!rtl/ext/usb_hid_host/src/usb_hid_host_rom.hex
sw/bios/bios_seed.hex

# gcc -MD leftovers
sw/apps/**/*.d
sw/os/*.d
sw/os/fs/*.d
sw/os/fs/fatfs/*.d

# App configure crumbs
sw/apps/net/.net_config_selected
sw/apps/repl/ms_stdlib.h

# ESP-IDF (esp32/zeitlos-nic): build tree and the generated sdkconfig
esp32/zeitlos-nic/build/
esp32/zeitlos-nic/sdkconfig
esp32/zeitlos-nic/sdkconfig.old

# usb_hid_host microcode listing (regenerated by asukp.py)
rtl/ext/usb_hid_host/src/firmware/ukp.lst

# zcc host build
sw/apps/zcc/zcc
sw/apps/zcc/*.o

# libz runtime blob (built artefacts)
sw/apps/zcc/libz/*.o
sw/apps/zcc/libz/*.d
sw/apps/zcc/libz/libz.elf
sw/apps/zcc/libz/libz.bin
sw/apps/zcc/libz/libz.sym
sw/apps/zcc/libz/libz.map
sw/apps/zcc/libz/libz.dasm
sw/apps/zcc/build/
sw/apps/zcc/zcc.elf
sw/apps/zcc/zcc.bin
sw/apps/zcc/zcc.map
sw/apps/zcc/zcc.dasm
sw/apps/posix/*.o
sw/apps/posix/*.d
sw/apps/posix/posix.elf
sw/apps/posix/posix.bin
sw/apps/posix/posix.map
sw/apps/posix/posix.dasm
sw/apps/posix/tests/px_shell_test
