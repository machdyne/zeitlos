# Written by release/zrelease for the duration of a release build and
# removed again afterwards. Ignored so that a build interrupted at the
# wrong moment cannot leave behind something that looks committable.
# See rtl/boards.vh's ZSPEC note and release/lib/gen.py.
/rtl/zspec.vh
/boards/.zrelease-*.lpf

# Build output
/output/
/images/

# Build products (BIOS, kernel, apps)
*.o
# Dependency files from -MD (the kernel's USB drivers leave them
# beside their sources)
*.d
*.elf
*.map
*.asm
*.dasm
*.bit
*.svf
*.config
*.json
*.bin
!sw/data/images/zeitlos.bin
*.hex
!rtl/ext/usb_hid_host/src/usb_hid_host_rom.hex
sw/bios/bios_seed.hex

# gcc -MD leftovers
sw/apps/**/*.d
sw/os/*.d
sw/os/fs/*.d
sw/os/fs/fatfs/*.d

# App configure crumbs
sw/apps/net/.net_config_selected
sw/apps/web/.web_config_selected
sw/apps/repl/ms_stdlib.h
sw/apps/info/feat_names.h
sw/apps/zerdesk/page.h

# ESP-IDF (esp32/zeitlos-nic): build tree and the generated sdkconfig
esp32/zeitlos-nic/build/
esp32/zeitlos-nic/sdkconfig
esp32/zeitlos-nic/sdkconfig.old

# usb_hid_host microcode listing (regenerated by asukp.py)
rtl/ext/usb_hid_host/src/firmware/ukp.lst
sw/apps/repl/te_max_file_size.h

# zcc host build
sw/apps/zcc/zcc
sw/apps/zcc/*.o

# libz runtime blob (built artefacts)
sw/apps/zcc/libz/*.o
sw/apps/zcc/libz/*.d
sw/apps/zcc/libz/libz.elf
sw/apps/zcc/libz/libz.bin
sw/apps/zcc/libz/libz.sym
sw/apps/zcc/libz/libz.map
sw/apps/zcc/libz/libz.dasm
sw/apps/zcc/build/
sw/apps/zcc/zcc.elf
sw/apps/zcc/zcc.bin
sw/apps/zcc/zcc.map
sw/apps/zcc/zcc.dasm
sw/apps/posix/*.o
sw/apps/posix/*.d
sw/apps/posix/posix.elf
sw/apps/posix/posix.bin
sw/apps/posix/posix.map
sw/apps/posix/posix.dasm
sw/apps/posix/tests/px_shell_test
sw/apps/posix/tests/px_case_test

# Host test and render products, built in place by `make test` /
# `make render` (the web browser's go in build/, which also holds the
# live TLS test's generated certificates and server log)
sw/apps/web/build/
sw/apps/sheet/sheet_test
sw/apps/sheet/sheet_layout
sw/apps/sheet/sheet_files
sw/apps/sheet/sheet_render
sw/apps/read/md_test
sw/apps/ask/test/hosttest
sw/apps/gpu3d/test/stl_test
sw/apps/gpu3d/test/teapot*.stl

# python bytecode (esp32/flash.py imports nic_selftest)
__pycache__/

# What fed and the BBS write when tried inside the source tree. Never
# committed: a node key is a node's identity, and a user file holds
# password hashes.
node.key
/sw/apps/fed/DIR/
/sw/apps/fed/fed-linux
/sw/apps/bbs/bbs-linux
/sw/apps/bbs/data/users.dat
/sw/apps/bbs/data/node.id
/sw/apps/bbs/data/msgs/
/sw/apps/bbs/data/fed-outbox
/sw/apps/bbs/data/fed-names
/sw/apps/bbs/data/*.sock

# cryptobench's symbol-renaming table (its Makefile; `make clean` removes it)
sw/apps/cryptobench/o2.syms

# What fed and the BBS write when tried inside the source tree. Never
# committed: a node key is a node's identity, and a user file holds
# password hashes.
node.key
/sw/apps/fed/fed-linux
/sw/apps/bbs/bbs-linux
/sw/apps/bbs/data/users.dat
/sw/apps/bbs/data/node.id
/sw/apps/bbs/data/msgs/
/sw/apps/bbs/data/fed-outbox
/sw/apps/bbs/data/fed-names
/sw/apps/bbs/data/*.sock

sw/bios/.build-flags
sw/bios/bios.hex.tmp
sw/bios/*.synthbak
