; slide deck (docs/slide_app.md) -- the deck slide.zds shows off (docs/demo.md).
; The demo adds a card of its own after the first, live, then shows it all.
(deck (version 1)
	(page "classic" landscape)
	(title "slide on Zeitlos")
	(background "band"
		(rect "band" (box 0 0 512 30) (fill shade 12) (line 0 16))
		(text "deck" (box 8 6 300 20) (font "m6x13" 13) (color 0) (pad 0) (text "slide on Zeitlos")))
	(card "title" (transition wipe 500)
		(rect "frame" (box 16 16 480 310) (fill none) (line 3 16))
		(text "name" (box 0 70 512 80) (font "serif" 64 bold) (align center middle) (text "slide"))
		(text "sub" (box 0 150 512 30) (font "sans" 20) (align center middle)
			(text "design, show and print decks"))
		(oval "o1" (box 150 210 50 50) (fill pattern 4) (line 2 16))
		(rrect "r1" (box 231 210 50 50) (fill shade 8) (line 2 16) (radius 10))
		(diamond "d1" (box 306 205 60 60) (fill pattern 13) (line 2 16)))
	(card "pitch" (background "band") (transition push 500)
		(text "h" (box 24 40 464 40) (font "heavy" 30) (text "Zeitlos: the seed round"))
		(text "t" (box 36 92 250 200) (font "sans" 15)
			(text "A computer and its OS,\ndesigned together.\n\nOne FPGA. No legacy.\nApps that last.\n\nRaising EUR 10M\nto build a toaster\nscreensaver."))
		(text "ct" (box 296 92 190 20) (font "sans" 13) (align center top) (text "Toasters (plan)"))
		(rect "b1" (box 312 254 30 16) (fill pattern 3) (line 1 16))
		(rect "b2" (box 352 230 30 40) (fill pattern 3) (line 1 16))
		(rect "b3" (box 392 180 30 90) (fill pattern 13) (line 1 16))
		(rect "b4" (box 432 120 30 150) (fill shade 12) (line 1 16))
		(line "ax" (box 300 270 176 0) (line 2 16) (arrows none))
		(text "y1" (box 307 274 40 14) (font "sans" 11) (align center top) (pad 0) (text "2026"))
		(text "y2" (box 347 274 40 14) (font "sans" 11) (align center top) (pad 0) (text "2027"))
		(text "y3" (box 387 274 40 14) (font "sans" 11) (align center top) (pad 0) (text "2028"))
		(text "y4" (box 427 274 40 14) (font "sans" 11) (align center top) (pad 0) (text "2029"))
		(text "fic" (box 300 300 176 12) (font "mono5x8" 8) (align right top) (text "a fictional pitch")))
	(card "cards" (background "band") (transition iris 600)
		(text "h" (box 24 44 464 40) (font "heavy" 30) (text "Draw once, show anywhere"))
		(text "t" (box 36 96 300 200) (font "sans" 17)
			(text "Shapes, text and pictures,\ndrawn at any scale:\non the screen, full screen,\nand on paper.\n\nButtons, fields and lists,\nwith actions in Scheme."))
		(rrect "c3" (box 360 110 110 80) (fill shade 3) (line 1 16) (radius 8))
		(rrect "c2" (box 350 120 110 80) (fill shade 6) (line 1 16) (radius 8))
		(rrect "c1" (box 340 130 110 80) (fill shade 0) (line 2 16) (radius 8))
		(text "c1t" (box 340 130 110 80) (font "script" 26) (align center middle) (text "hello"))
		(button "b" (box 352 230 90 30) (radius 8) (font "sans" 15) (align center middle) (text "Next")
			(action "(go 'next)")))
	(card "type" (background "band") (transition dissolve 600)
		(text "h" (box 24 44 464 40) (font "heavy" 30) (text "Type in any size"))
		(text "a" (box 36 96 440 40) (font "serif" 30 italic) (text "Hershey's public-domain"))
		(text "b" (box 36 136 440 44) (font "script" 36) (text "script,"))
		(text "c" (box 36 182 440 40) (font "gothic" 32) (text "blackletter"))
		(text "d" (box 36 228 440 24) (font "m9x15" 15) (text "and crisp misc-fixed."))
		(poly "w" (box 300 150 180 60) (line 2 16) (smooth)
			(points 300 210 345 150 390 210 435 150 480 210)))
	(card "end" (transition push 500)
		(text "t" (box 0 100 512 80) (font "script" 54) (align center middle) (text "Made on Zeitlos"))
		(text "s" (box 0 190 512 24) (font "sans" 16) (align center middle)
			(text "github.com/machdyne/zeitlos"))))
