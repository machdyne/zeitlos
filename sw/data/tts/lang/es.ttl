# Spanish: the rules the formant voice speaks it by (docs/tts.md,
# "Other languages"). Written from Spanish spelling, which is close to
# one letter, one sound. Stress: the second-last syllable, the last
# after a consonant other than n or s, and wherever an accent says.
name Spanish
stress penult
last-if-ends bcdfghjklmpqrtvwxyzñ
unstressed 2
vowels aeiouáéíóúü
weak el la lo los las un una unos unas de del al y e o u a en con por para que se le les me te nos su sus mi tu es

# accented vowels are the stressed ones
r [á] = A'
r [é] = E'
r [í] = I'
r [ó] = O'
r [ú] = U'
r g[ü] = W
r [ü] = U

# consonants
r [ch] = CH
r [ll] = Y
r [rr] = DX DX
r #[r] = DX DX
r {lns}[r] = DX DX
r [r] = DX
r [qu]{eiéí} = K
r [qu] = K W
r [gu]{eiéí} = G
r [g]{eiéí} = X
r [g] = G
r [c]{eiéí} = S
r [c] = K
r [z] = S
r [j] = X
r [h] = -
r [ñ] = NY
r #[x] = S
r [x] = K S
r #[y]# = I
r [y]V = Y
r V[y]# = Y
r [y] = I
r [v] = B
r [b] = B
r [d] = D
r [f] = F
r [k] = K
r [l] = L
r [m] = M
r [n] = N
r [p] = P
r [s] = S
r [t] = T
r [w] = W

# vowels: i and u beside another vowel glide
r [i]{aeoáéó} = Y
r {aeo}[i] = Y
r [u]{aeioáéíó} = W
r {aeo}[u] = W
r [a] = A
r [e] = E
r [i] = I
r [o] = O
r [u] = U

