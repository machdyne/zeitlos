; slide deck (docs/slide_app.md) -- the tour, shipped as /data/slide/tour.zsl
(deck (version 1)
	(page "classic" landscape)
	(title "A tour of slide")
	(background "tour"
		(rect "band" (box 0 0 512 30) (fill shade 12) (line 0 16))
		(text "deck" (box 8 6 300 20) (font "m6x13" 13) (color 0) (pad 0) (text "A tour of slide"))
		(line "rule" (box 16 318 480 0) (line 1 8) (arrows none))
		(text "keys" (box 16 322 480 16) (font "mono5x8" 8) (align right top) (pad 0)
			(text "Right: next   Left: back   F5: show   F6: all cards   F1: help")))
	(card "welcome" (background "tour") (transition wipe 500)
		(text "title" (box 0 70 512 70) (font "serif" 54 bold) (align center middle) (text "slide"))
		(text "sub" (box 0 140 512 30) (font "sans" 18) (align center middle)
			(text "cards, slides and pages for Zeitlos"))
		(rrect "panel" (box 96 190 320 100) (fill pattern 2) (line 2 16) (radius 14))
		(text "what" (box 106 198 300 86) (font "sans" 13) (align center middle)
			(text "Draw shapes, set text in public-domain fonts, place pictures, and show the deck full screen. Every card is drawn at any scale, on screen and on paper.")))
	(card "drawing" (background "tour") (transition push 400)
		(text "h" (box 20 40 472 34) (font "heavy" 26) (text "Drawing"))
		(rect "r" (box 30 90 90 60) (fill pattern 4) (line 1 16))
		(rrect "rr" (box 140 90 90 60) (fill shade 6) (line 2 16) (radius 12))
		(oval "o" (box 250 90 90 60) (fill pattern 13) (line 3 16))
		(poly "p" (box 360 88 110 66) (fill pattern 9) (line 1 16) (closed)
			(points 415 88 470 154 360 154))
		(line "l" (box 40 190 200 40) (line 2 16) (arrows end))
		(text "t" (box 260 175 230 120) (font "sans" 12)
			(text "The tools are on the left: browse, select, text, rectangle, rounded rectangle, oval, line, arrow, polygon and picture.\nDrag to draw; Shift keeps squares, circles and 45-degree lines.")))
	(card "text" (background "tour") (transition wipe 400)
		(text "h" (box 20 40 472 34) (font "heavy" 26) (text "Text"))
		(text "a" (box 30 82 460 26) (font "sans" 20) (text "sans: a clean single-stroke face"))
		(text "b" (box 30 110 460 28) (font "serif" 22) (text "serif: for reading, and bold"))
		(text "c" (box 30 140 460 30) (font "serif" 22 italic) (text "serif italic"))
		(text "d" (box 30 172 460 34) (font "script" 28) (text "script, for a flourish"))
		(text "e" (box 30 208 460 34) (font "gothic" 28) (text "Gothic blackletter"))
		(text "f" (box 30 248 460 20) (font "m9x15" 15) (text "m9x15: misc-fixed, crisp at 100%"))
		(text "g" (box 30 272 460 40) (font "sans" 12)
			(text "Hershey fonts (public domain, A. V. Hershey, NBS) scale to any size; type /font NAME SIZE to change one.")))
	(card "pictures" (background "tour") (transition push 400)
		(text "h" (box 20 40 472 34) (font "heavy" 26) (text "Pictures"))
		(image "squirrel" (box 30 82 220 146) (src "/media/images/squirrel.jpg") (line 1 16))
		(text "t" (box 270 82 220 150) (font "sans" 13)
			(text "PNG, JPEG, GIF, BMP and PNM. A picture is decoded to grey once and dithered at the size it is shown, so resizing it stays sharp. /contrast and /bright adjust it.")))
	(card "commands" (background "tour") (transition wipe 400)
		(text "h" (box 20 40 472 34) (font "heavy" 26) (text "The / command line"))
		(text "t" (box 30 82 460 220) (font "m7x13" 13)
			(text "/fill shade 6      /line 3      /radius 12\n/font serif 30 bold    /align center middle\n/new    /dup card    /go 3    /name intro\n/page 16:9    /page letter portrait\n/background plain    /edit background\n/transition push 400    /advance 8\n/lineup left    /front    /back    /grid 8\n\nUndo is Ctrl+Z, all the way back.")))
	(card "showing" (background "tour") (transition push 400)
		(text "h" (box 20 40 472 34) (font "heavy" 26) (text "Showing"))
		(text "t" (box 30 82 460 200) (font "sans" 15)
			(text "F5 shows the deck on the whole screen, from this card (Shift+F5: from the first).\n\nSpace, Right or a click: next. Left or Backspace: back. A number and Enter: that card. B blanks, S shows the card at its own size. Escape ends the show.")))
	(card "controls" (background "tour") (transition iris 500)
		(text "h" (box 20 40 472 34) (font "heavy" 26) (text "Buttons and controls"))
		(text "t" (box 20 78 250 150) (font "sans" 12)
			(text "With the browse tool (b), in a show, or in a deck run as an app (F7), the controls work. Try them.\n\n/button Next, /check, /radio, /field, /slider, /list A, B, C place one; /action go next says what a click does."))
		(check "c" (box 290 80 200 18) (font "sans" 14) (align left middle) (text "Show the secret") (value 0)
			(action "(toggle \"secret\")"))
		(text "secret" (box 290 102 200 20) (font "script" 18) (hidden) (text "slide can do this!"))
		(radio "r1" (box 290 130 90 18) (font "sans" 14) (align left middle) (text "Tea") (value 1) (group "drink"))
		(radio "r2" (box 380 130 110 18) (font "sans" 14) (align left middle) (text "Coffee") (value 0) (group "drink"))
		(slider "s" (box 290 160 200 18) (value 30) (range 0 100) (action "(set-text \"said\" \"Slid!\")"))
		(field "f" (box 290 188 200 24) (font "sans" 14) (text "Type here"))
		(text "said" (box 20 236 250 20) (font "sans" 13) (text ""))
		(button "speak" (box 290 230 96 26) (radius 6) (font "sans" 14) (align center middle) (text "Speak")
			(action "(speak-text \"f\")"))
		(button "go" (box 394 230 96 26) (radius 6) (font "sans" 14) (align center middle) (text "First card")
			(action "(go 'first)")))
	(card "scripts" (background "tour") (transition push 400)
		(text "h" (box 20 40 472 34) (font "heavy" 26) (text "Scripts"))
		(text "t" (box 20 78 472 120) (font "sans" 13)
			(text "An action can be Scheme: (if (> score 5) (go 'next) (speak \"Not yet\")). /script deck and /script card open a deck's or a card's script in text; (every 1000 ...) and (after 500 ...) run things later; (when-clicked \"ok\" ...) answers a click.\n\nType /(+ 1 2) for Scheme at once. The decks in /data/slide/examples are small apps: a quiz, a calculator, a to-do list, a clock."))
		(text "n" (box 20 246 200 20) (font "sans" 14) (text "Clicks:"))
		(text "count" (box 90 246 60 20) (font "heavy" 16) (text "0"))
		(button "more" (box 160 242 110 26) (radius 6) (font "sans" 14) (align center middle) (text "Click me")
			(action "(set-text \"count\" (+ 1 (string->number (get-text \"count\"))))")))
	(card "diagrams" (background "tour") (transition dissolve 400)
		(text "h" (box 20 40 472 34) (font "heavy" 26) (text "Diagrams"))
		(pill "start" (box 24 84 96 34) (line 1 16) (font "sans" 13) (text "Start"))
		(slant "ask" (box 20 146 104 40) (line 1 16) (font "sans" 13) (text "Ask"))
		(diamond "ok" (box 150 136 104 60) (fill pattern 2) (line 1 16) (font "sans" 13) (text "Right?"))
		(document "note" (box 150 228 104 44) (line 1 16) (font "sans" 13) (text "Note it"))
		(cylinder "keep" (box 24 226 96 50) (line 1 16) (font "sans" 13) (text "Keep"))
		(line "c1" (box 72 118 0 28) (line 1 16) (arrows end) (connect "start" "ask"))
		(line "c2" (box 124 166 26 0) (line 1 16) (arrows end) (connect "ask" "ok"))
		(poly "c3" (box 202 196 0 32) (line 1 16) (arrows end) (points 202 196 202 212 202 212 202 228) (connect "ok" "note"))
		(line "c4" (box 150 250 -30 0) (line 1 16) (arrows end) (connect "note" "keep"))
		(text "t" (box 272 82 220 230) (font "sans" 12)
			(text "/diamond, /slant, /pill, /document and /cylinder hold their words. Select two shapes and /connect: the arrow follows them when they move (/connect elbow turns corners).\n\nf draws freehand, smoothed; /smooth curves a polygon. Ctrl+G groups.\n\n/export svg writes the card for the web; /import brings an SVG drawing in as shapes.")))
	(card "the end" (background "tour") (transition wipe 600)
		(text "t" (box 0 110 512 80) (font "script" 48) (align center middle) (text "Have fun"))
		(text "s" (box 0 200 512 24) (font "sans" 14) (align center middle)
			(text "Ctrl+N starts a deck of your own"))))
