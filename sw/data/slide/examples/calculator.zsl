; slide deck (docs/slide_app.md) -- an example: a calculator (docs/slide_scripting.md)
(deck (version 1)
	(page "classic" landscape)
	(title "Calculator")
	(app)
	(script ";; A four-function calculator. The display is the field \"d\".\n(define acc 0)\n(define op #f)\n(define fresh #t)\n(define (digit s)\n  (if fresh (begin (set-text \"d\" s) (set! fresh #f))\n      (set-text \"d\" (string-append (get-text \"d\") s))))\n(define (value) (let ((n (string->number (get-text \"d\")))) (if n n 0)))\n(define (apply-op)\n  (cond ((not op) (value))\n        ((eq? op '+) (+ acc (value)))\n        ((eq? op '-) (- acc (value)))\n        ((eq? op '*) (* acc (value)))\n        ((eq? op '/) (if (= (value) 0) 0 (/ acc (value))))))\n(define (operator o) (set! acc (apply-op)) (set! op o) (set! fresh #t) (set-text \"d\" (number->string acc)))\n(define (equals) (set! acc (apply-op)) (set! op #f) (set! fresh #t) (set-text \"d\" (number->string acc)))\n(define (clear) (set! acc 0) (set! op #f) (set! fresh #t) (set-text \"d\" \"0\"))")
	(background "band"
		(rect "band" (box 0 0 512 30) (fill shade 12) (line 0 16))
		(text "title" (box 8 6 400 20) (font "m6x13" 13) (color 0) (pad 0) (text "Calculator")))

	(card "calc" (background "band")
		(field "d" (box 136 44 240 40) (font "heavy" 28) (align right middle) (pad 6) (text "0"))
		(button "k00" (box 136 96 54 48) (radius 8) (font "sans" 22) (align center middle) (text "7") (action "(digit \"7\")"))
		(button "k01" (box 198 96 54 48) (radius 8) (font "sans" 22) (align center middle) (text "8") (action "(digit \"8\")"))
		(button "k02" (box 260 96 54 48) (radius 8) (font "sans" 22) (align center middle) (text "9") (action "(digit \"9\")"))
		(button "k03" (box 322 96 54 48) (radius 8) (font "heavy" 22) (align center middle) (line 2 16) (text "/") (action "(operator '/)"))
		(button "k10" (box 136 152 54 48) (radius 8) (font "sans" 22) (align center middle) (text "4") (action "(digit \"4\")"))
		(button "k11" (box 198 152 54 48) (radius 8) (font "sans" 22) (align center middle) (text "5") (action "(digit \"5\")"))
		(button "k12" (box 260 152 54 48) (radius 8) (font "sans" 22) (align center middle) (text "6") (action "(digit \"6\")"))
		(button "k13" (box 322 152 54 48) (radius 8) (font "heavy" 22) (align center middle) (line 2 16) (text "*") (action "(operator '*)"))
		(button "k20" (box 136 208 54 48) (radius 8) (font "sans" 22) (align center middle) (text "1") (action "(digit \"1\")"))
		(button "k21" (box 198 208 54 48) (radius 8) (font "sans" 22) (align center middle) (text "2") (action "(digit \"2\")"))
		(button "k22" (box 260 208 54 48) (radius 8) (font "sans" 22) (align center middle) (text "3") (action "(digit \"3\")"))
		(button "k23" (box 322 208 54 48) (radius 8) (font "heavy" 22) (align center middle) (line 2 16) (text "-") (action "(operator '-)"))
		(button "k30" (box 136 264 54 48) (radius 8) (font "heavy" 22) (align center middle) (line 2 16) (text "C") (action "(clear)"))
		(button "k31" (box 198 264 54 48) (radius 8) (font "sans" 22) (align center middle) (text "0") (action "(digit \"0\")"))
		(button "k32" (box 260 264 54 48) (radius 8) (font "heavy" 22) (align center middle) (line 2 16) (text "=") (action "(equals)"))
		(button "k33" (box 322 264 54 48) (radius 8) (font "heavy" 22) (align center middle) (line 2 16) (text "+") (action "(operator '+)"))))
