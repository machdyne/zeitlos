; slide deck (docs/slide_app.md) -- an example: a clock and a stopwatch (docs/slide_scripting.md)
(deck (version 1)
	(page "classic" landscape)
	(title "Clock")
	(app)
	(script ";; The time (UTC) on a card, and a stopwatch on another.\n(define (two n) (if (< n 10) (string-append \"0\" (number->string n)) (number->string n)))\n(define (hms d) (string-append (two (list-ref d 3)) \":\" (two (list-ref d 4)) \":\" (two (list-ref d 5))))\n(define started #f)\n(define elapsed 0)\n(define (show-watch)\n  (let ((s (quotient elapsed 10)))\n    (set-text \"watch\" (string-append (two (quotient s 60)) \":\" (two (remainder s 60)) \".\" (number->string (remainder elapsed 10))))))")
	(background "band"
		(rect "band" (box 0 0 512 30) (fill shade 12) (line 0 16))
		(text "title" (box 8 6 400 20) (font "m6x13" 13) (color 0) (pad 0) (text "Clock")))

	(card "clock" (background "band") (script "(define (tick) (let ((d (current-date))) (set-text \"time\" (if d (hms d) \"the clock is not set\")))) (tick) (every 1000 (tick))")
		(text "time" (box 0 90 512 90) (font "heavy" 64) (align center middle) (text "--:--:--"))
		(text "utc" (box 0 180 512 20) (font "sans" 14) (align center middle) (text "UTC"))
		(button "sw" (box 186 240 140 30) (radius 8) (font "sans" 15) (align center middle) (text "Stopwatch") (action "(go 'next)")))
	(card "stopwatch" (background "band") (transition push 300)
		(text "watch" (box 0 80 512 90) (font "heavy" 64) (align center middle) (text "00:00.0"))
		(button "start" (box 90 200 100 30) (radius 8) (font "sans" 15) (align center middle) (text "Start")
			(action "(if (not started) (set! started (every 100 (set! elapsed (+ elapsed 1)) (show-watch))))"))
		(button "stop" (box 206 200 100 30) (radius 8) (font "sans" 15) (align center middle) (text "Stop")
			(action "(if started (begin (cancel started) (set! started #f)))"))
		(button "reset" (box 322 200 100 30) (radius 8) (font "sans" 15) (align center middle) (text "Reset")
			(action "(set! elapsed 0) (show-watch)"))
		(button "back" (box 196 250 120 26) (radius 8) (font "sans" 14) (align center middle) (text "Clock") (action "(go 'prev)"))))
