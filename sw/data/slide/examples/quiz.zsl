; slide deck (docs/slide_app.md) -- an example: a quiz (docs/slide_scripting.md)
(deck (version 1)
	(page "classic" landscape)
	(title "A small quiz")
	(app)
	(script ";; A three-question quiz. Each card has radios in a group \"a\" and a\n;; Check button; (answer RIGHT) says whether the chosen one is right.\n(define score 0)\n(define (chosen)\n  (cond ((get-value \"a1\") 1) ((get-value \"a2\") 2) ((get-value \"a3\") 3) (else 0)))\n(define (answer right)\n  (if (= (chosen) 0)\n      (set-text \"said\" \"Choose one first.\")\n      (begin\n        (if (= (chosen) right)\n            (begin (set! score (+ score 1)) (set-text \"said\" \"Right!\") (speak \"Right!\"))\n            (begin (set-text \"said\" \"Not quite.\") (speak \"Not quite.\")))\n        (after 1200 (go 'next)))))\n(when-clicked \"again\" (set! score 0) (go 'first))")
	(background "band"
		(rect "band" (box 0 0 512 30) (fill shade 12) (line 0 16))
		(text "title" (box 8 6 400 20) (font "m6x13" 13) (color 0) (pad 0) (text "A small quiz")))

	(card "start" (background "band")
		(text "t" (box 0 80 512 60) (font "serif" 40 bold) (align center middle) (text "A small quiz"))
		(text "s" (box 0 150 512 24) (font "sans" 16) (align center middle) (text "Three questions about Zeitlos."))
		(button "go" (box 196 210 120 32) (radius 8) (font "sans" 17) (align center middle) (text "Start") (action "(go 'next)")))
	(card "q1" (background "band") (transition dissolve 400)
		(text "q" (box 30 50 452 60) (font "serif" 22 bold) (text "What does Zeitlos run on?"))
		(radio "a1" (box 60 125 300 22) (font "sans" 17) (align left middle) (text "A graphics card") (value 0) (group "a"))
		(radio "a2" (box 60 157 300 22) (font "sans" 17) (align left middle) (text "An FPGA") (value 0) (group "a"))
		(radio "a3" (box 60 189 300 22) (font "sans" 17) (align left middle) (text "A typewriter") (value 0) (group "a"))
		(button "check" (box 60 236 110 30) (radius 8) (font "sans" 16) (align center middle) (text "Check") (action "(answer 2)"))
		(text "said" (box 190 240 280 24) (font "sans" 16) (align left middle) (text "")))
	(card "q2" (background "band") (transition dissolve 400)
		(text "q" (box 30 50 452 60) (font "serif" 22 bold) (text "How many colours does the desktop have?"))
		(radio "a1" (box 60 125 300 22) (font "sans" 17) (align left middle) (text "Two: it is 1 bit per pixel") (value 0) (group "a"))
		(radio "a2" (box 60 157 300 22) (font "sans" 17) (align left middle) (text "256") (value 0) (group "a"))
		(radio "a3" (box 60 189 300 22) (font "sans" 17) (align left middle) (text "Millions") (value 0) (group "a"))
		(button "check" (box 60 236 110 30) (radius 8) (font "sans" 16) (align center middle) (text "Check") (action "(answer 1)"))
		(text "said" (box 190 240 280 24) (font "sans" 16) (align left middle) (text "")))
	(card "q3" (background "band") (transition dissolve 400)
		(text "q" (box 30 50 452 60) (font "serif" 22 bold) (text "What is a slide deck's file made of?"))
		(radio "a1" (box 60 125 300 22) (font "sans" 17) (align left middle) (text "Bytecode") (value 0) (group "a"))
		(radio "a2" (box 60 157 300 22) (font "sans" 17) (align left middle) (text "XML") (value 0) (group "a"))
		(radio "a3" (box 60 189 300 22) (font "sans" 17) (align left middle) (text "S-expressions") (value 0) (group "a"))
		(button "check" (box 60 236 110 30) (radius 8) (font "sans" 16) (align center middle) (text "Check") (action "(answer 3)"))
		(text "said" (box 190 240 280 24) (font "sans" 16) (align left middle) (text "")))
	(card "end" (background "band") (transition iris 600) (script "(set-text \"score\" (string-append \"You scored \" (number->string score) \" of 3.\"))")
		(text "t" (box 0 70 512 50) (font "script" 40) (align center middle) (text "Well done"))
		(text "score" (box 0 140 512 30) (font "sans" 20) (align center middle) (text ""))
		(button "again" (box 196 210 120 32) (radius 8) (font "sans" 17) (align center middle) (text "Again"))))
