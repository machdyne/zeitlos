PREFIX ?= $(RISCV_PREFIX)
# ARCH/ABI come from one place -- see that file for why
include ../../common/arch.mk
CC = $(PREFIX)gcc
AS = $(PREFIX)as
ASFLAGS = -march=$(ARCH) -mabi=$(ABI)
CFLAGS = --std=gnu99 -Os -MD -Wall -march=$(ARCH) -mabi=$(ABI) $(ARCH_DEFS) $(LIBC_FLAGS)
LDFLAGS = -march=$(ARCH) -mabi=$(ABI)  $(LIBC_FLAGS)
LDSCRIPT = ../../common/riscv-app.ld

OBJS = zeitlos.o zobj.o zgfx.o zfont_data.o zwin.o zgame.o \
	sprites.o level.o music.o gamedemo.o

gamedemo: gamedemo.elf gamedemo.bin

zeitlos.o: ../../common/zeitlos.c ../../common/zeitlos.h
	$(CC) $(CFLAGS) -c ../../common/zeitlos.c -o zeitlos.o

zobj.o: ../../common/zobj.c ../../common/zobj.h
	$(CC) $(CFLAGS) -c ../../common/zobj.c -o zobj.o

zgfx.o: ../../common/zgfx.c ../../common/zgfx.h
	$(CC) $(CFLAGS) -c ../../common/zgfx.c -o zgfx.o

zwin.o: ../../common/zwin.c ../../common/zwin.h
	$(CC) $(CFLAGS) -c ../../common/zwin.c -o zwin.o

# zgfx.c references the font tables (z_font_5x8 and friends) whenever
# anything draws text, and they live in their own translation unit --
# so an app that draws a single character needs this even though it
# never mentions zfont_data itself. Every other app that draws text
# links it; this one did not, and the link failed with an undefined
# z_font_5x8 rather than with anything pointing at the cause.
zfont_data.o: ../../common/zfont_data.c ../../common/zfont.h
	$(CC) $(CFLAGS) -c ../../common/zfont_data.c -o zfont_data.o

zgame.o: ../../common/zgame.c ../../common/zgame.h
	$(CC) $(CFLAGS) -c ../../common/zgame.c -o zgame.o

# sprites.c/.h are GENERATED by gen_sprites.py and committed, so a
# normal build needs no Python. Re-run the generator by hand after
# editing the art in it; there is deliberately no make rule doing that
# automatically, because a generated file rebuilding itself mid-build
# is how you get a tree that differs from what was committed without
# anyone noticing.
sprites.o: sprites.c sprites.h
	$(CC) $(CFLAGS) -c sprites.c -o sprites.o

music.o: music.c music.h
	$(CC) $(CFLAGS) -c music.c -o music.o

level.o: level.c level.h sprites.h
	$(CC) $(CFLAGS) -c level.c -o level.o

gamedemo.o: gamedemo.c
	$(CC) $(CFLAGS) -c gamedemo.c -S -o gamedemo.asm
	$(CC) $(CFLAGS) -c gamedemo.c -o gamedemo.o

gamedemo.elf: $(OBJS)
	$(CC) $(LDFLAGS) -T $(LDSCRIPT) -Wl,-Map,gamedemo.map -o gamedemo.elf $(OBJS)
	$(PREFIX)objdump -S --disassemble gamedemo.elf > gamedemo.dasm

gamedemo.bin: gamedemo.elf
	@EDATA=$$($(PREFIX)nm gamedemo.elf | awk '$$3=="_edata"{print "0x"$$1}'); \
	END=$$($(PREFIX)nm gamedemo.elf | awk '$$3=="_end"{print "0x"$$1}'); \
	$(PREFIX)objcopy -O binary gamedemo.elf gamedemo.data; \
	python3 ../../../tools/mkexec.py gamedemo.data gamedemo.bin $$(($$END - $$EDATA)); \
	rm -f gamedemo.data

clean:
	rm -f gamedemo.elf gamedemo.bin gamedemo.data gamedemo.asm gamedemo.dasm gamedemo.map *.o *.d

.PHONY: gamedemo clean

# Header dependency tracking.
#
# CFLAGS has carried -MD all along, so gcc has been writing .d files
# listing every header each object depends on -- but nothing included
# them, and the object rules below have no prerequisites at all
# (`wm.o:` rather than `wm.o: wm.c`). The effect is that once an object
# file exists, make considers it permanently up to date: editing a .c
# or a .h rebuilds nothing, and the link silently produces a binary
# from stale objects.
#
# That is not a theoretical problem -- it has twice produced hardware
# that behaved like a broken feature when the real cause was simply
# that the change was never compiled in. Including the .d files makes
# every object depend on its own source and headers, so `make` alone is
# correct and `make clean` stops being a required ritual.
-include $(wildcard *.d)
-include $(wildcard */*.d)
-include $(wildcard */*/*.d)
