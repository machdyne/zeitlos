msgid ""
msgstr ""
"Project-Id-Version: Zeitlos cal\n"
"Language: uk\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

#, c-format
msgid "Year %s%s"
msgstr "Рік %s%s"

msgid "Enter to go, Esc to cancel"
msgstr "Enter: перейти, Esc: скасувати"

msgid "No RTC: `RTC off, make flash"
msgstr "Немає RTC: `RTC вимк., make flash"

msgid "Clock not set -- type a year"
msgstr "Годинник не налаштовано -- введіть рік"

#, c-format
msgid "Today %s %d %s %04ld %s"
msgstr "Сьогодні %s %d %s %04ld %s"

msgid ""
"A month calendar, with today marked.\n"
"\n"
"Left/Right\tPrevious / next month\n"
"Up/Down\tPrevious / next year\n"
"Home, t\tBack to today\n"
"0-9\tType a year\n"
"Enter\tGo to it (or press the arrow)\n"
"Esc\tAbandon the typed year\n"
"Backspace\tDelete a digit\n"
"z\tThe time zone: settings\n"
"\n"
"Click < or > to change month. Type four digits and Enter to jump to a year (1970-2105). Today needs the clock set: run net. Click the date at the bottom, or press z, to choose the time zone."
msgstr ""
"Календар на місяць, сьогоднішній день позначено.\n"
"\n"
"Вліво/Вправо\tПопередній / наступний місяць\n"
"Вгору/Вниз\tПопередній / наступний рік\n"
"Home, t\tНазад до сьогодні\n"
"0-9\tВвести рік\n"
"Enter\tПерейти (або натиснути стрілку)\n"
"Esc\tСкинути введений рік\n"
"Backspace\tВидалити цифру\n"
"z\tЧасовий пояс: settings\n"
"\n"
"Натисніть < або >, щоб змінити місяць. Чотири цифри й Enter переходять до року (1970-2105). Для сьогоднішнього дня потрібен налаштований годинник: запустіть net. Натисніть на дату внизу або клавішу z, щоб вибрати часовий пояс."

msgid "Cal help"
msgstr "Довідка cal"
