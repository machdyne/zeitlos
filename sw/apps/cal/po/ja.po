msgid ""
msgstr ""
"Project-Id-Version: Zeitlos cal\n"
"Language: ja\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

#, c-format
msgid "Year %s%s"
msgstr "%s%s年"

msgid "Enter to go, Esc to cancel"
msgstr "Enterで移動、Escで取消"

msgid "No RTC: `RTC off, make flash"
msgstr "RTCなし: `RTCがオフ、make flash"

msgid "Clock not set -- type a year"
msgstr "時計が未設定 -- 年を入力"

#, c-format
msgid "Today %s %d %s %04ld %s"
msgstr "今日 %s %d %s %04ld %s"

msgid ""
"A month calendar, with today marked.\n"
"\n"
"Left/Right\tPrevious / next month\n"
"Up/Down\tPrevious / next year\n"
"Home, t\tBack to today\n"
"0-9\tType a year\n"
"Enter\tGo to it (or press the arrow)\n"
"Esc\tAbandon the typed year\n"
"Backspace\tDelete a digit\n"
"z\tThe time zone: settings\n"
"\n"
"Click < or > to change month. Type four digits and Enter to jump to a year (1970-2105). Today needs the clock set: run net. Click the date at the bottom, or press z, to choose the time zone."
msgstr ""
"今日に印のある月のカレンダーです。\n"
"\n"
"左/右\t前月 / 翌月\n"
"上/下\t前年 / 翌年\n"
"Home, t\t今日に戻る\n"
"0-9\t年を入力\n"
"Enter\tその年へ移動(または矢印を押す)\n"
"Esc\t入力した年を取り消す\n"
"Backspace\t数字を1つ消す\n"
"z\tタイムゾーン: settings\n"
"\n"
"< か > をクリックすると月が変わります。4桁の数字とEnterで年へ移動します(1970-2105)。今日の表示には時計の設定が必要です: netを実行してください。下の日付をクリックするか z を押すとタイムゾーンを選べます。"

msgid "Cal help"
msgstr "calのヘルプ"
