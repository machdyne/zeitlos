msgid ""
msgstr ""
"Project-Id-Version: Zeitlos cal\n"
"Language: nl\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#, c-format
msgid "Year %s%s"
msgstr "Jaar %s%s"

msgid "Enter to go, Esc to cancel"
msgstr "Enter: ga, Esc: annuleren"

msgid "No RTC: `RTC off, make flash"
msgstr "Geen RTC: `RTC uit, make flash"

msgid "Clock not set -- type a year"
msgstr "Klok niet gezet -- typ een jaar"

#, c-format
msgid "Today %s %d %s %04ld %s"
msgstr "Vandaag %s %d %s %04ld %s"

msgid ""
"A month calendar, with today marked.\n"
"\n"
"Left/Right\tPrevious / next month\n"
"Up/Down\tPrevious / next year\n"
"Home, t\tBack to today\n"
"0-9\tType a year\n"
"Enter\tGo to it (or press the arrow)\n"
"Esc\tAbandon the typed year\n"
"Backspace\tDelete a digit\n"
"z\tThe time zone: settings\n"
"\n"
"Click < or > to change month. Type four digits and Enter to jump to a year (1970-2105). Today needs the clock set: run net. Click the date at the bottom, or press z, to choose the time zone."
msgstr ""
"Een maandkalender, met vandaag gemarkeerd.\n"
"\n"
"Links/Rechts\tVorige / volgende maand\n"
"Omhoog/Omlaag\tVorig / volgend jaar\n"
"Home, t\tTerug naar vandaag\n"
"0-9\tEen jaar typen\n"
"Enter\tErheen gaan (of de pijl indrukken)\n"
"Esc\tHet getypte jaar laten vallen\n"
"Backspace\tEen cijfer wissen\n"
"z\tDe tijdzone: settings\n"
"\n"
"Klik op < of > om van maand te wisselen. Typ vier cijfers en Enter om naar een jaar te springen (1970-2105). Voor vandaag moet de klok gezet zijn: start net. Klik op de datum onderaan, of druk op z, om de tijdzone te kiezen."

msgid "Cal help"
msgstr "Hulp bij cal"
