# modpanel.net -- an LS10 reading buttons and lighting LEDs on a
# TCA9535 through its own I2C bus (pins C and D): /basic/PANEL.BAS.
#
# Hold a button: its LED lights. The buttons are in the module's REG 0:
#
#   sechs -b main reg 0x0c 0

module   m1  LS10  program=/basic/PANEL.BAS
bus      main  m1

tca9535  x1  addr=0x20
bus      local  master=m1  x1

led      l0  x1.P00
led      l1  x1.P01
led      l2  x1.P02
led      l3  x1.P03
button   b0  x1.P10  pullup
button   b1  x1.P11  pullup
button   b2  x1.P12  pullup
button   b3  x1.P13  pullup
pullup   x1.P14
pullup   x1.P15
pullup   x1.P16
pullup   x1.P17
