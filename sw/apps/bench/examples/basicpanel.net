# basicpanel.net -- the BASIC computer on an I/O expander.
#
# Open this in bench, then in the BASIC computer:
#
#   LOAD PANEL
#   RUN
#
# Hold a button: its LED lights. PANEL.BAS is the program
# /bench/modpanel.net runs on a virtual LS10, unchanged: PINS NET, NET,
# I2C, I2C works on both. Or try it by hand:
#
#   10 PINS -, -, I2C, I2C
#   20 I2C 32, 6, 0: I2C 32, 2, 85
#   RUN
#
# 85 is binary 01010101: P00, P02, P04 and P06 go high, so l0 and l2
# light (l1 and l3 stay dark). 15 (00001111) lights all four.

tca9535  x1  addr=0x20
bus      main  x1
basic    main

led      l0  x1.P00
led      l1  x1.P01
led      l2  x1.P02
led      l3  x1.P03
button   b0  x1.P10  pullup
button   b1  x1.P11  pullup
button   b2  x1.P12  pullup
button   b3  x1.P13  pullup
pullup   x1.P14
pullup   x1.P15
pullup   x1.P16
pullup   x1.P17
