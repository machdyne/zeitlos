# Machdyne Minze: ECP5 LFE5U-12F in CABGA256.
#
#   zfpga build /fpga/examples/blink.v -b minze
#
# The pins are the tree's own boards/minze_v1.lpf, installed beside
# this file as minze.lpf. The 12F is the 25F die: db/lfe5u25f.zdb is
# built with --also LFE5U-12F. `pack -c`: compressed.
device  LFE5U-12F
package CABGA256
lpf     minze.lpf
pack    -c
