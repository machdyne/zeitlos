# tests/fixtures/blinkf_c.zl: examples/blinkf.v, synth_ecp5 -nowidelut -nodsp -nobram -nolutram (carry chains on), via tools/ys2zl.py
device LFE5U-25F
package CABGA256

input CLK_48 A7 net=n2 io_type=LVCMOS33
output LED_B A2 net=n3 io_type=LVCMOS33

ccu2 LED_B_CCU2C_B1 init0=0x96AA init1=0x96AA inject0=NO inject1=NO a0=0 b0=n4 c0=0 d0=1 a1=0 b1=n3 c1=0 d1=1 cin=n5 cout=n6 s0=n7 s1=n8
ccu2 LED_B_CCU2C_B1_S0_CCU2C_S0 init0=0x96AA init1=0x96AA inject0=NO inject1=NO a0=1 b0=n9 c0=0 d0=1 a1=0 b1=n10 c1=0 d1=1 cin=0 cout=n5 s0=n11 s1=n12
ff LED_B_TRELLIS_FF_Q d=n8 q=n3 clk=n2 lsr=0 gsr=DISABLED regset=RESET cemux=1 clkmux=CLK lsrmux=LSR
ff ctr_TRELLIS_FF_Q d=n7 q=n4 clk=n2 lsr=0 gsr=DISABLED regset=RESET cemux=1 clkmux=CLK lsrmux=LSR
ff ctr_TRELLIS_FF_Q_1 d=n12 q=n10 clk=n2 lsr=0 gsr=DISABLED regset=RESET cemux=1 clkmux=CLK lsrmux=LSR
ff ctr_TRELLIS_FF_Q_2 d=n11 q=n9 clk=n2 lsr=0 gsr=DISABLED regset=RESET cemux=1 clkmux=CLK lsrmux=LSR
