# tests/fixtures/blink_route.zn: examples/blink.v's nets by terminal, from nextpnr via tools/np2zn.py --route
device LFE5U-25F
package CABGA256
speed 6

comb R3C2 SLICEB 1 mode=LOGIC init=0x0000 pins=-
