# sw/apps/poker -- build rules are shared: sw/common/app.mk, docs/build.md.

APP = poker
APP_LISTING = 0
# Zeitlos poker.

# The engine (pk_*.o) has no I/O of any kind in it, which is what lets
# the host tests below build the SHIPPED sources rather than a copy.

# Objects, and why each is linked:
#
#   zrng.o: The ChaCha20 generator, seeded from rtl/trng.v where there is one.
#   See $(GAMES)/zdeck.h on why a board without one still deals a fine
#   game.
#
#   zfsapp.o: zbank reads and writes /data/casino/bank.dat, so the filesystem half of the
#   app runtime comes with it.
OBJS = zeitlos.o zobj.o zgfx.o zfont_data.o zwin.o zrng.o \
	zcard.o zdeck.o zrand.o zrand_sys.o zbank.o zfsapp.o zcardart.o \
	pk_eval.o pk_game.o pk_ai.o table_ui.o input.o poker.o

# Generated by $(GAMES)/gen_cards.py and committed alongside it, so the
# build
# needs no Python -- same arrangement as sw/apps/chess's pieces.c and
# sw/data/icons. Re-run the generator by hand with `make cards`; it is
# deliberately NOT a make rule, because a build that silently
# regenerates committed source hides what changed.
zcard.o:
	$(CC) $(CFLAGS) -c $(GAMES)/zcard.c -o zcard.o
zdeck.o:
	$(CC) $(CFLAGS) -c $(GAMES)/zdeck.c -o zdeck.o
zrand.o:
	$(CC) $(CFLAGS) -c $(GAMES)/zrand.c -o zrand.o
zrand_sys.o:
	$(CC) $(CFLAGS) -c $(GAMES)/zrand_sys.c -o zrand_sys.o
zbank.o:
	$(CC) $(CFLAGS) -c $(GAMES)/zbank.c -o zbank.o
zcardart.o:
	$(CC) $(CFLAGS) -c $(GAMES)/zcardart.c -o zcardart.o

# A .zexe rather than a raw --pad-to binary: the header carries .bss
# as a NUMBER instead of writing it out as literal zeros to be read
# off the SD card on every launch. See sw/common/zexec.h.

# -- host-side tests --
#
# Native cc, no RISC-V toolchain involved, and the REAL sources in
# every target. There is no second copy of the evaluator, the betting
# engine or the layout anywhere in this tree.
HOSTCC ?= cc

# -I ../../common is deliberately ABSENT.
#
# sw/apps/chess/Makefile records why this matters: the host builds
# there carry -I ../../common (their render harness needs it), which
# let a bare #include "zgfx.h" compile in every host target and fail
# on the first line of the target build. Four green test binaries and
# a broken build.
#
# Phases 1-3 have no Zeitlos dependency at all, so they need no -I and
# do not get one. When tests/render.c arrives it will need the flag for
# sw/common/tests/zrender.h's own sake, and it will be added to THAT
# TARGET ALONE rather than to a shared variable.
HOSTFLAGS = -std=gnu99 -Wall -Wextra -no-pie -O2

# The engine: no I/O, no Zeitlos headers, links with nothing.
GAMES = ../../common/games

# The card encoding, the shoe and the card art moved to
# sw/common/games when blackjack arrived and became a second caller --
# see docs/casino_bank.md. They are compiled in from there rather than
# copied, which is the whole point of the move.
ENGINESRC = pk_eval.c pk_game.c pk_ai.c \
	$(GAMES)/zcard.c $(GAMES)/zdeck.c $(GAMES)/zrand.c

# The engine plus the drawing, for the two targets that include
# tests/poker_shim.h and therefore do have software pixel primitives.
# zgfx.c is deliberately absent -- see sw/common/tests/zrender.h's
# header for why the plotting is stubbed and the layout is not.
PANELSRC = $(ENGINESRC) table_ui.c $(GAMES)/zcardart.c \
	../../common/zwin.c ../../common/zwidget.c ../../common/tests/zspeak_stub.c \
	../../common/zfont_data.c ../../common/zobj.c ../../common/zeitlos.c

# -I ../../common, for the two panel targets ONLY.
#
# It is here and not in HOSTFLAGS for the reason sw/apps/chess's
# Makefile records: with the flag in a shared variable, a bare
# #include "zgfx.h" in an app source compiles in every host target and
# fails on the first line of the target build. The flag exists purely
# for sw/common/tests/zrender.h's own sake -- that file lives in
# sw/common/tests/ and includes "zgfx.h", one directory up from it.
# That is zrender.h's business, not this app's.
PANELFLAGS = $(HOSTFLAGS) -I ../../common

# Floating point must not reach an rv32i board from anything SHIPPED.
# zcardart.c is generated integer data; table_ui.c draws.
NOFLOATSRC = pk_eval.c pk_game.c pk_ai.c table_ui.c input.c poker.c

# Every source the target build will compile, checked with the host
# compiler and no -I, which is the header search the target build
# actually has. -fsyntax-only, so this needs no RISC-V toolchain.
TARGETSRC = pk_eval.c pk_game.c pk_ai.c table_ui.c input.c poker.c

includecheck:
	@for f in $(TARGETSRC); do \
		$(HOSTCC) -std=gnu99 -Wall -fsyntax-only $$f || exit 1; \
	done
	@echo "includecheck: every target source resolves its headers with no -I"

# -- the floating-point trap --
#
# Some boards here are rv32i (sw/common/arch.mk), with no FPU and no
# soft-float linked by default. One `double` in the equity code pulls
# in the whole soft-float runtime -- tens of kilobytes, on an app that
# docs/app_runtime.md says can crash on start if it outgrows the
# loader's space. Nothing in the build output would mention it.
#
# So every probability in pk_ai.c is an integer in parts per thousand,
# and this target checks that it stays that way.
#
# This is a LEXICAL check and it is honest about that: it looks for
# float types and decimal literals in the shipped sources. The
# definitive check is `nm` on the target objects for __adddf3 and its
# relatives, which needs the RISC-V toolchain and belongs with the
# target build. This one runs everywhere and catches the mistake at
# the point somebody makes it.
#
# COMMENTS AND STRING LITERALS ARE STRIPPED FIRST -- comments with
# -fpreprocessed -dD -E so that macros survive and prose does not.
# The first version grepped the raw text and failed on pk_ai.h's own
# explanation of why there is no floating point here, which is a funny
# way to find out that a check reads its own documentation as evidence
# against itself. String literals went the same way once blackjack
# grew a button labelled "double".
#
# The test files are exempt: they run on the build machine, where a
# double costs nothing and the chi-square legitimately wants one.
nofloat:
	@for f in $(NOFLOATSRC) *.h; do \
		if $(HOSTCC) -fpreprocessed -dD -E $$f 2>/dev/null | \
			sed 's/"[^"]*"//g' | \
			grep -nE '(^|[^_[:alnum:]])(float|double)([^_[:alnum:]]|$$)'; then \
			echo "nofloat: FAILED -- floating point in $$f"; exit 1; \
		fi; \
		if $(HOSTCC) -fpreprocessed -dD -E $$f 2>/dev/null | \
			grep -nE '[0-9]\.[0-9]'; then \
			echo "nofloat: FAILED -- a decimal literal in $$f"; exit 1; \
		fi; \
	done
	@echo "nofloat: the engine is integer-only"

# The DEFINITIVE version of the check above, and the one nofloat's
# comment calls for. Needs the RISC-V toolchain and a completed
# `make`, so it is not part of `test`.
#
# Verified: with every source compiled for rv32i, not one soft-float
# helper is referenced by anything in this app. __divsi3 and friends
# ARE referenced and are expected -- rv32i has no divide instruction
# either, and libgcc supplies those at a cost of a few hundred bytes
# rather than tens of kilobytes.
#
# SCOPED TO THIS APP'S OWN OBJECTS, and that is not the check being
# weakened. sw/common/zobj.c has a float member in z_obj_t and compares
# it with fabsf(), so zobj.o references __subsf3 on an rv32i build --
# and zobj.o is linked by every app in this tree, not just this one.
# That is a property of the shared object system and a separate
# question from whether THIS app kept its own arithmetic integer.
# Failing here on somebody else's float would make the check something
# people turn off.
APPOBJS = zbank.o pk_eval.o pk_game.o pk_ai.o zcard.o zdeck.o zrand.o \
	zcardart.o table_ui.o input.o poker.o

nmcheck:
	@if $(PREFIX)nm $(APPOBJS) | \
		grep -E 'U __(add|sub|mul|div|fix|float|cmp|unord)[ds]f'; then \
		echo "nmcheck: FAILED -- soft-float reached this app's objects"; \
		exit 1; \
	fi
	@echo "nmcheck: no soft-float in this app's target objects"
	@$(PREFIX)size poker.elf 2>/dev/null || true

# Unattended. Around 30 seconds, nearly all of it in the two that earn
# it: the exhaustive hand census and the opponents playing every
# variant at every level.
#
#   includecheck  the headers resolve the way the target build needs
#   nofloat       no floating point reaches an rv32i board
#   eval_test     the evaluator against published combinatorial counts,
#                 a second classifier, and a brute-force best-of-seven;
#                 the deck, the shuffle and the stacking hook
#   game_test     blinds, side pots, incomplete all-in raises, the stud
#                 bring-in and act order, the draw, and a fuzz over
#                 every variant asserting chip conservation
#   ai_test       equity against known matchups, legality at every
#                 level in every variant, the difficulty ladder, and
#                 aborting a search cleanly
#   test_layout   the table geometry, the hit boxes, and -- the one
#                 that earns its keep -- that nothing is drawn outside
#                 the content rectangle
#   test_input    the command line, the mouse, and that typing an
#                 action and clicking it end in the same place
test: includecheck nofloat
	$(HOSTCC) $(HOSTFLAGS) -o /tmp/poker_eval tests/eval_test.c $(ENGINESRC)
	$(HOSTCC) $(HOSTFLAGS) -o /tmp/poker_game tests/game_test.c $(ENGINESRC)
	$(HOSTCC) $(HOSTFLAGS) -o /tmp/poker_ai   tests/ai_test.c   $(ENGINESRC)
	$(HOSTCC) $(PANELFLAGS) -o /tmp/poker_layout tests/test_layout.c $(PANELSRC)
	$(HOSTCC) $(PANELFLAGS) -o /tmp/poker_input tests/test_input.c $(PANELSRC) input.c
	/tmp/poker_eval
	/tmp/poker_game
	/tmp/poker_ai
	/tmp/poker_layout
	/tmp/poker_input

# Every layer at once, under -fsanitize=address,undefined: deal, let
# the opponents act, redraw the table after every step, take the
# hero's turn through the command line, settle, repeat -- across every
# variant, seat count and betting structure.
#
# Separate from `test` because the sanitizers make it slow and because
# a build machine without them should still be able to run the suite.
# Worth running after any change to the drawing or the parsing: a
# one-byte overrun is invisible on the host without it, and on the
# target it is whatever happened to be next in memory.
stress:
	$(HOSTCC) --std=gnu99 -g -O1 -no-pie -I ../../common \
		-fsanitize=address,undefined -fno-omit-frame-pointer \
		-o /tmp/poker_stress tests/stress.c $(PANELSRC) input.c
	ASAN_OPTIONS=detect_leaks=0 /tmp/poker_stress

# LOOK AT THE OUTPUT before changing the art or the layout.
#
# Seven states, because six of them are a nuisance to reach on
# hardware and one of them cannot be reached at all without another
# window covering this one.
#
#   make render                  the flop, six-handed
#   make render WHAT=showdown    everybody's cards turned over
#   make render WHAT=stud        seven-card stud, the overlapped fans
#   make render WHAT=draw        cards marked to throw away
#   make render WHAT=allin       three players in, side pots
#   make render WHAT=game        the 320x240 full-screen page
#   make render WHAT=narrow      too small for a table
WHAT ?= flop

render:
	$(HOSTCC) $(PANELFLAGS) -o /tmp/poker_render tests/render.c $(PANELSRC)
	/tmp/poker_render /tmp/poker.pbm $(WHAT)
	@echo "wrote /tmp/poker.pbm ($(WHAT)) -- other states: make render \
WHAT=showdown|stud|draw|allin|game|narrow"

# Re-runs the art generator. Deliberately NOT a dependency of anything:
# a build that silently regenerates committed source hides what
# changed. Same arrangement as sw/apps/chess's `make pieces`.
cards:
	cd $(GAMES) && python3 gen_cards.py

.PHONY: test includecheck nofloat nmcheck render cards stress

include ../../common/app.mk
