/* -- hardware --
 *
 * maskirq is the entry this whole mechanism was worth building for.
 * It wraps a picorv32 custom instruction that zcc cannot emit, and it
 * is the one function in sw/common/zeitlos.h that Phase 1 could not
 * compile. Here it is ordinary GCC-built code behind an ordinary
 * table slot -- no inline assembler needed in zcc, now or ever.
 * See docs/zcc.md, "The maskirq problem".
 */
LIBZ_ENTRY(maskirq)
LIBZ_ENTRY(z_syscall)
LIBZ_ENTRY(z_heap_used)

/* ===================================================================
 * ABI 2 -- graphics and windows.
 *
 * Appended, never inserted, so every ABI-1 binary keeps working: it
 * simply never reaches these slots. That is the whole point of the
 * ordering rule and this is the first time it has been exercised.
 *
 * These are the tree's OWN functions, compiled from sw/common/zgfx.c
 * and sw/common/zwin.c with no modification -- five small shim headers
 * (libz/shim) supply the freestanding <stdio.h>, <stdlib.h> and
 * <string.h> those files include, declaring only the handful of names
 * they actually call. Nothing in sw/common changed.
 *
 * The blob grows from about 5KB to about 50KB as a result, and every
 * zcc binary carries a copy. That is accepted: docs/posix.md section
 * 10's shared runtime turns it into a one-time cost later, and being
 * able to build a windowed app on the device is worth more now than
 * the megabyte it costs across a dozen of them.
 * ===================================================================
 */

/* -- framebuffer, software path -- */
LIBZ_ENTRY(z_fb_set_pixel)
LIBZ_ENTRY(z_fb_fill_rect)
LIBZ_ENTRY(z_fb_draw_char)
LIBZ_ENTRY(z_fb_draw_text)
LIBZ_ENTRY(z_fb_draw_char2)
LIBZ_ENTRY(z_fb_draw_text2)

/* -- framebuffer, GPU path --
 *
 * z_fb_hw_line and z_fb_hw_box are the sanctioned way into the line
 * rasterizer: they reassert the clip registers on every call and wrap
 * the register-writes-then-trigger sequence in maskirq, which is what
 * makes them safe against the two hazards docs/app_runtime.md
 * documents. An app reaching the registers directly gets neither --
 * and a zcc-compiled app CANNOT reach maskirq inline, so routing
 * through these is not merely advisable here, it is the only correct
 * option.
 */
LIBZ_ENTRY(z_fb_hw_line)
LIBZ_ENTRY(z_fb_hw_box)
LIBZ_ENTRY(z_fb_hw_fill_rect)
LIBZ_ENTRY(z_fb_hw_sync)
LIBZ_ENTRY(z_gfx_hw_font_load)

