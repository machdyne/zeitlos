/* ===================================================================
 * ABI 3 -- the object system.
 *
 * z_obj_uint32/int32/str/none went in with ABI 2 because zgfx.c and
 * zwin.c call them. The rest of sw/common/zobj.h did not, and the gap
 * was not obvious until somebody looked: z_msg_send() was reachable
 * from a zcc-compiled program and there was no way to BUILD anything
 * to send but a scalar. A list, a map or a blob -- the payloads the
 * messaging protocol is actually made of (docs/messaging.md) -- could
 * not be constructed at all.
 * ===================================================================
 */
LIBZ_ENTRY(z_obj_blob)
LIBZ_ENTRY(z_blob_data)
LIBZ_ENTRY(z_blob_len)
LIBZ_ENTRY(z_obj_list)
LIBZ_ENTRY(z_list_append)
LIBZ_ENTRY(z_list_get)
LIBZ_ENTRY(z_obj_map)
LIBZ_ENTRY(z_map_set)
LIBZ_ENTRY(z_map_find)
LIBZ_ENTRY(z_map_get_key)
LIBZ_ENTRY(z_map_get_val)
LIBZ_ENTRY(z_obj_copy)
LIBZ_ENTRY(z_obj_free)
LIBZ_ENTRY(z_obj_size)
LIBZ_ENTRY(z_obj_equal)
/* 112 */
LIBZ_ENTRY(z_obj_float32)

/*
 * -- RETIRED entries --
 *
 * If a function is ever withdrawn, do NOT delete its line: replace the
 * name with libz_retired and leave it in place, so that everything
 * after it keeps its offset. The stub returns 0 and is defined in
 * syscall.c.
 *
 * Nothing is retired yet. The convention is written down now because
 * the moment it is needed is the moment it is tempting to just delete
 * the line.
 */
