msgid "Loading "
msgstr "Cargando: "

msgid "Not found"
msgstr "No encontrado"

msgid ""
"No heading matches\n"
"that link."
msgstr ""
"Ningún título coincide\n"
"con ese enlace."

msgid "End of document"
msgstr "Fin del documento"

msgid "Nothing selected"
msgstr "Nada seleccionado"

msgid "External link"
msgstr "Enlace externo"

msgid ""
"This link points off\n"
"this machine."
msgstr ""
"Este enlace lleva fuera\n"
"de esta máquina."

msgid "Can't open"
msgstr "No se puede abrir"

msgid ""
"That file could not\n"
"be read."
msgstr ""
"No se pudo leer\n"
"ese archivo."

msgid "Finding... "
msgstr "Buscando... "

#, c-format
msgid "%  (Esc stops)"
msgstr "%  (Esc para)"

msgid "  read error"
msgstr "  error de lectura"

msgid ""
"A reader for Markdown and text: manuals, notes, books.\n"
"\n"
"Space, PgDn\tNext page (Shift+Space back)\n"
"Arrows\tA line\n"
"Home, End\tStart, end (Esc stops a long find)\n"
"Tab\tNext link; Enter follows it\n"
"Backspace\tBack\n"
"Ctrl+O\tOpen\n"
"Ctrl+C\tCopy the selection (drag to select)\n"
"\n"
"A .docx, .odt, .rtf or .epub is converted to read."
msgstr ""
"Un lector de Markdown y texto: manuales, notas, libros.\n"
"\n"
"Espacio, AvPág\tPágina siguiente (Mayús+Espacio: atrás)\n"
"Flechas\tUna línea\n"
"Inicio, Fin\tPrincipio, final (Esc para una búsqueda larga)\n"
"Tab\tEnlace siguiente; Intro lo sigue\n"
"Retroceso\tAtrás\n"
"Ctrl+O\tAbrir\n"
"Ctrl+C\tCopiar la selección (arrastre para seleccionar)\n"
"\n"
"Un .docx, .odt, .rtf o .epub se convierte para leerlo."

msgid "Read help"
msgstr "Ayuda de read"
