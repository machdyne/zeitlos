msgid "Loading "
msgstr "Caricamento: "

msgid "Not found"
msgstr "Non trovato"

msgid ""
"No heading matches\n"
"that link."
msgstr ""
"Nessun titolo corrisponde\n"
"a quel collegamento."

msgid "End of document"
msgstr "Fine del documento"

msgid "Nothing selected"
msgstr "Niente selezionato"

msgid "External link"
msgstr "Collegamento esterno"

msgid ""
"This link points off\n"
"this machine."
msgstr ""
"Questo collegamento porta\n"
"fuori da questa macchina."

msgid "Can't open"
msgstr "Impossibile aprire"

msgid ""
"That file could not\n"
"be read."
msgstr ""
"Impossibile leggere\n"
"il file."

msgid "Finding... "
msgstr "Ricerca... "

#, c-format
msgid "%  (Esc stops)"
msgstr "%  (Esc ferma)"

msgid "  read error"
msgstr "  errore di lettura"

msgid ""
"A reader for Markdown and text: manuals, notes, books.\n"
"\n"
"Space, PgDn\tNext page (Shift+Space back)\n"
"Arrows\tA line\n"
"Home, End\tStart, end (Esc stops a long find)\n"
"Tab\tNext link; Enter follows it\n"
"Backspace\tBack\n"
"Ctrl+O\tOpen\n"
"Ctrl+C\tCopy the selection (drag to select)\n"
"\n"
"A .docx, .odt, .rtf or .epub is converted to read."
msgstr ""
"Un lettore per Markdown e testo: manuali, note, libri.\n"
"\n"
"Spazio, PagGiù\tPagina seguente (Maiusc+Spazio indietro)\n"
"Frecce\tUna riga\n"
"Inizio, Fine\tInizio, fine (Esc ferma una ricerca lunga)\n"
"Tab\tCollegamento seguente; Invio lo segue\n"
"Backspace\tIndietro\n"
"Ctrl+O\tApri\n"
"Ctrl+C\tCopia la selezione (trascina per selezionare)\n"
"\n"
"Un .docx, .odt, .rtf o .epub viene convertito per leggerlo."

msgid "Read help"
msgstr "Aiuto di read"
