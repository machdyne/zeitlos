msgid "Loading "
msgstr "Läser in: "

msgid "Not found"
msgstr "Hittades inte"

msgid ""
"No heading matches\n"
"that link."
msgstr ""
"Ingen rubrik passar\n"
"denna länk."

msgid "End of document"
msgstr "Slut på dokumentet"

msgid "Nothing selected"
msgstr "Inget markerat"

msgid "External link"
msgstr "Extern länk"

msgid ""
"This link points off\n"
"this machine."
msgstr ""
"Länken pekar ut ur\n"
"denna maskin."

msgid "Can't open"
msgstr "Kan inte öppna"

msgid ""
"That file could not\n"
"be read."
msgstr ""
"Filen kunde inte\n"
"läsas."

msgid "Finding... "
msgstr "Söker... "

#, c-format
msgid "%  (Esc stops)"
msgstr "%  (Esc stoppar)"

msgid "  read error"
msgstr "  läsfel"

msgid ""
"A reader for Markdown and text: manuals, notes, books.\n"
"\n"
"Space, PgDn\tNext page (Shift+Space back)\n"
"Arrows\tA line\n"
"Home, End\tStart, end (Esc stops a long find)\n"
"Tab\tNext link; Enter follows it\n"
"Backspace\tBack\n"
"Ctrl+O\tOpen\n"
"Ctrl+C\tCopy the selection (drag to select)\n"
"\n"
"A .docx, .odt, .rtf or .epub is converted to read."
msgstr ""
"En läsare för Markdown och text: manualer, anteckningar, böcker.\n"
"\n"
"Mellanslag, PgDn\tNästa sida (Skift+Mellanslag bakåt)\n"
"Pilar\tEn rad\n"
"Home, End\tBörjan, slut (Esc stoppar en lång sökning)\n"
"Tab\tNästa länk; Enter följer den\n"
"Backspace\tTillbaka\n"
"Ctrl+O\tÖppna\n"
"Ctrl+C\tKopiera markeringen (dra för att markera)\n"
"\n"
"En .docx, .odt, .rtf eller .epub konverteras för att läsas."

msgid "Read help"
msgstr "Hjälp för read"
