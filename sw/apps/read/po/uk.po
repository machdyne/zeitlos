msgstr "Пошук... "

#, c-format
msgid "%  (Esc stops)"
msgstr "%  (Esc - стоп)"

msgid "  read error"
msgstr "  помилка читання"

msgid ""
"A reader for Markdown and text: manuals, notes, books.\n"
"\n"
"Space, PgDn\tNext page (Shift+Space back)\n"
"Arrows\tA line\n"
"Home, End\tStart, end (Esc stops a long find)\n"
"Tab\tNext link; Enter follows it\n"
"Backspace\tBack\n"
"Ctrl+O\tOpen\n"
"Ctrl+C\tCopy the selection (drag to select)\n"
"\n"
"A .docx, .odt, .rtf or .epub is converted to read."
msgstr ""
"Переглядач Markdown і тексту: посібники, нотатки, книги.\n"
"\n"
"Пробіл, PgDn\tНаступна сторінка (Shift+Пробіл назад)\n"
"Стрілки\tНа рядок\n"
"Home, End\tПочаток, кінець (Esc перериває довгий пошук)\n"
"Tab\tНаступне посилання; Enter переходить\n"
"Backspace\tНазад\n"
"Ctrl+O\tВідкрити\n"
"Ctrl+C\tКопіювати виділення (тягніть, щоб виділити)\n"
"\n"
"Файли .docx, .odt, .rtf і .epub для читання перетворюються."

msgid "Read help"
msgstr "Довідка read"
