msgid "Loading "
msgstr "A carregar: "

msgid "Not found"
msgstr "Não encontrado"

msgid ""
"No heading matches\n"
"that link."
msgstr ""
"Nenhum título corresponde\n"
"a essa ligação."

msgid "End of document"
msgstr "Fim do documento"

msgid "Nothing selected"
msgstr "Nada selecionado"

msgid "External link"
msgstr "Ligação externa"

msgid ""
"This link points off\n"
"this machine."
msgstr ""
"Esta ligação leva para fora\n"
"desta máquina."

msgid "Can't open"
msgstr "Impossível abrir"

msgid ""
"That file could not\n"
"be read."
msgstr ""
"Não foi possível ler\n"
"esse ficheiro."

msgid "Finding... "
msgstr "A procurar... "

#, c-format
msgid "%  (Esc stops)"
msgstr "%  (Esc para)"

msgid "  read error"
msgstr "  erro de leitura"

msgid ""
"A reader for Markdown and text: manuals, notes, books.\n"
"\n"
"Space, PgDn\tNext page (Shift+Space back)\n"
"Arrows\tA line\n"
"Home, End\tStart, end (Esc stops a long find)\n"
"Tab\tNext link; Enter follows it\n"
"Backspace\tBack\n"
"Ctrl+O\tOpen\n"
"Ctrl+C\tCopy the selection (drag to select)\n"
"\n"
"A .docx, .odt, .rtf or .epub is converted to read."
msgstr ""
"Um leitor de Markdown e texto: manuais, notas, livros.\n"
"\n"
"Espaço, PgDn\tPágina seguinte (Shift+Espaço: anterior)\n"
"Setas\tUma linha\n"
"Home, End\tInício, fim (Esc para uma procura longa)\n"
"Tab\tLigação seguinte; Enter segue-a\n"
"Backspace\tVoltar\n"
"Ctrl+O\tAbrir\n"
"Ctrl+C\tCopiar a seleção (arraste para selecionar)\n"
"\n"
"Um .docx, .odt, .rtf ou .epub é convertido para ler."

msgid "Read help"
msgstr "Ajuda do read"
