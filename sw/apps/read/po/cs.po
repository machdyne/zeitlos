msgid "Loading "
msgstr "Načítání: "

msgid "Not found"
msgstr "Nenalezeno"

msgid ""
"No heading matches\n"
"that link."
msgstr ""
"Žádný nadpis neodpovídá\n"
"tomuto odkazu."

msgid "End of document"
msgstr "Konec dokumentu"

msgid "Nothing selected"
msgstr "Nic není vybráno"

msgid "External link"
msgstr "Vnější odkaz"

msgid ""
"This link points off\n"
"this machine."
msgstr ""
"Tento odkaz vede mimo\n"
"tento stroj."

msgid "Can't open"
msgstr "Nelze otevřít"

msgid ""
"That file could not\n"
"be read."
msgstr ""
"Soubor se nepodařilo\n"
"přečíst."

msgid "Finding... "
msgstr "Hledání... "

#, c-format
msgid "%  (Esc stops)"
msgstr "%  (Esc zastaví)"

msgid "  read error"
msgstr "  chyba čtení"

msgid ""
"A reader for Markdown and text: manuals, notes, books.\n"
"\n"
"Space, PgDn\tNext page (Shift+Space back)\n"
"Arrows\tA line\n"
"Home, End\tStart, end (Esc stops a long find)\n"
"Tab\tNext link; Enter follows it\n"
"Backspace\tBack\n"
"Ctrl+O\tOpen\n"
"Ctrl+C\tCopy the selection (drag to select)\n"
"\n"
"A .docx, .odt, .rtf or .epub is converted to read."
msgstr ""
"Čtečka Markdownu a textu: příručky, poznámky, knihy.\n"
"\n"
"Mezerník, PgDn\tDalší strana (Shift+Mezerník zpět)\n"
"Šipky\tJeden řádek\n"
"Home, End\tZačátek, konec (Esc zastaví dlouhé hledání)\n"
"Tab\tDalší odkaz; Enter jej následuje\n"
"Backspace\tZpět\n"
"Ctrl+O\tOtevřít\n"
"Ctrl+C\tKopírovat výběr (tažením vybrat)\n"
"\n"
"Soubor .docx, .odt, .rtf nebo .epub se ke čtení převede."

msgid "Read help"
msgstr "Nápověda read"
