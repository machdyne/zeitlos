#, c-format
msgid "%  (Esc stops)"
msgstr "%  (Esc stopt)"

msgid "  read error"
msgstr "  leesfout"

msgid ""
"A reader for Markdown and text: manuals, notes, books.\n"
"\n"
"Space, PgDn\tNext page (Shift+Space back)\n"
"Arrows\tA line\n"
"Home, End\tStart, end (Esc stops a long find)\n"
"Tab\tNext link; Enter follows it\n"
"Backspace\tBack\n"
"Ctrl+O\tOpen\n"
"Ctrl+C\tCopy the selection (drag to select)\n"
"\n"
"A .docx, .odt, .rtf or .epub is converted to read."
msgstr ""
"Een lezer voor Markdown en tekst: handleidingen, notities, boeken.\n"
"\n"
"Spatie, PgDn\tVolgende pagina (Shift+Spatie terug)\n"
"Pijlen\tEen regel\n"
"Home, End\tBegin, eind (Esc stopt een lange zoektocht)\n"
"Tab\tVolgende link; Enter volgt hem\n"
"Backspace\tTerug\n"
"Ctrl+O\tOpenen\n"
"Ctrl+C\tDe selectie kopiëren (sleep om te selecteren)\n"
"\n"
"Een .docx, .odt, .rtf of .epub wordt omgezet om te lezen."

msgid "Read help"
msgstr "Hulp bij read"
