msgid ""
msgstr ""
"Project-Id-Version: Zeitlos text\n"
"Language: nl\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Converting"
msgstr "Omzetten:"

msgid "the file"
msgstr "het bestand"

msgid "Saving"
msgstr "Opslaan:"

msgid "Recover"
msgstr "Herstellen"

msgid ""
"Unsaved changes from a\n"
"session that did not end\n"
"were kept. Recover them?"
msgstr ""
"Niet-opgeslagen wijzigingen\n"
"van een sessie die niet\n"
"afliep zijn bewaard.\n"
"Herstellen?"

#, c-format
msgid ""
"%d character cannot be saved\n"
"as %s. Save as UTF-8\n"
"instead?"
msgid_plural ""
"%d characters cannot be saved\n"
"as %s. Save as UTF-8\n"
"instead?"
msgstr[0] ""
"%d teken kan niet als %s\n"
"worden opgeslagen.\n"
"Als UTF-8 opslaan?"
msgstr[1] ""
"%d tekens kunnen niet als %s\n"
"worden opgeslagen.\n"
"Als UTF-8 opslaan?"

msgid "Encoding"
msgstr "Codering"

msgid "Save failed"
msgstr "Opslaan mislukt"

msgid ""
"The file could not be\n"
"written completely.\n"
"The one on the card is\n"
"as it was."
msgstr ""
"Het bestand kon niet\n"
"helemaal worden geschreven.\n"
"Dat op de kaart is\n"
"ongewijzigd."

#, c-format
msgid ""
"Saved, but as\n"
"%.60s:\n"
"it could not be renamed."
msgstr ""
"Opgeslagen, maar als\n"
"%.60s:\n"
"hernoemen lukte niet."

msgid "Save"
msgstr "Opslaan"

msgid "Export"
msgstr "Exporteren"

msgid ""
"convert could not\n"
"be started."
msgstr ""
"convert kon niet\n"
"starten."

msgid ""
"Could not write the\n"
"copy to convert."
msgstr ""
"De kopie om om te zetten\n"
"kon niet worden geschreven."

#, c-format
msgid ""
"%.40s already exists.\n"
"Replace it?"
msgstr ""
"%.40s bestaat al.\n"
"Vervangen?"

msgid "Save As"
msgstr "Opslaan als"

msgid "Getting ready to print"
msgstr "Afdrukken voorbereiden:"

msgid "Untitled"
msgstr "Naamloos"

#, c-format
msgid "Print %.60s"
msgstr "%.60s afdrukken"

#, c-format
msgid ""
"There was no room in %s\n"
"for the text to print."
msgstr ""
"Er was geen ruimte in %s\n"
"voor de af te drukken tekst."

msgid "Print"
msgstr "Afdrukken"

#, c-format
msgid ""
"The print job could not\n"
"be made in %s."
msgstr ""
"De afdruktaak kon niet\n"
"in %s worden gemaakt."

msgid "print is not on the card."
msgstr "print staat niet op de kaart."

msgid ""
"The print job could not\n"
"be written."
msgstr ""
"De afdruktaak kon niet\n"
"worden geschreven."

msgid "Unsaved changes"
msgstr "Niet-opgeslagen wijzigingen"

msgid ""
"Save changes before\n"
"continuing?"
msgstr ""
"Wijzigingen eerst\n"
"opslaan?"

msgid "Open failed"
msgstr "Openen mislukt"

msgid ""
"That file could not\n"
"be read."
msgstr ""
"Dat bestand kon niet\n"
"worden gelezen."

msgid "Too large"
msgstr "Te groot"

msgid ""
"That file is larger than\n"
"this editor can hold on\n"
"this machine."
msgstr ""
"Dat bestand is groter dan\n"
"deze editor op deze\n"
"machine aankan."

msgid "Opening"
msgstr "Openen:"

msgid ""
"That file is too large for\n"
"this editor once its accented\n"
"letters are converted."
msgstr ""
"Dat bestand wordt te groot\n"
"voor de editor zodra de letters\n"
"met accenten zijn omgezet."

msgid "Copy"
msgstr "Kopiëren"

msgid ""
"Copied, but there is no\n"
"memory to keep all of it:\n"
"a paste gives the first\n"
"4 KB."
msgstr ""
"Gekopieerd, maar er is geen\n"
"geheugen voor alles: plakken\n"
"geeft de eerste 4 KB."

msgid ""
"Too large to cut here:\n"
"there is no memory to\n"
"keep it for the paste.\n"
"Cut less than 4 KB."
msgstr ""
"Te groot om te knippen:\n"
"geen geheugen om het voor\n"
"het plakken te bewaren.\n"
"Knip minder dan 4 KB."

msgid ""
"Too large to cut:\n"
"it could not be undone.\n"
"Cut a smaller part."
msgstr ""
"Te groot om te knippen:\n"
"het kan niet ongedaan\n"
"worden. Knip een kleiner deel."

msgid "Cut"
msgstr "Knippen"

msgid "Full"
msgstr "Vol"

msgid ""
"Only part of the clipboard\n"
"would fit."
msgstr ""
"Maar een deel van het\n"
"klembord zou passen."

msgid "The document is full."
msgstr "Het document is vol."

msgid "blank"
msgstr "leeg"

msgid "end"
msgstr "einde"

msgid "new line"
msgstr "nieuwe regel"

msgid "Empty document"
msgstr "Leeg document"

msgid "End of document"
msgstr "Einde van het document"

msgid "Nothing selected"
msgstr "Niets geselecteerd"

msgid "Finding"
msgstr "Zoeken:"

#, c-format
msgid ""
"\"%.60s\"\n"
"was not found."
msgstr ""
"\"%.60s\"\n"
"is niet gevonden."

msgid "Find"
msgstr "Zoeken"

msgid "Find:"
msgstr "Zoeken:"

msgid "Counting"
msgstr "Tellen:"

msgid "Replacing"
msgstr "Vervangen:"

msgid "Replace"
msgstr "Vervangen"

msgid ""
"The document would not hold\n"
"the replacements."
msgstr ""
"Het document zou de\n"
"vervangingen niet bevatten."

msgid "Replace with:"
msgstr "Vervangen door:"

#, c-format
msgid ""
"%d match for \"%.40s\".\n"
"Replace all of them?\n"
"(No: one at a time.)"
msgid_plural ""
"%d matches for \"%.40s\".\n"
"Replace all of them?\n"
"(No: one at a time.)"
msgstr[0] ""
"%d treffer voor \"%.40s\".\n"
"Alle vervangen?\n"
"(Nee: één voor één.)"
msgstr[1] ""
"%d treffers voor \"%.40s\".\n"
"Alle vervangen?\n"
"(Nee: één voor één.)"

msgid ""
"That many changes cannot\n"
"be undone. Replace all\n"
"anyway?"
msgstr ""
"Zoveel wijzigingen kunnen\n"
"niet ongedaan worden.\n"
"Toch alles vervangen?"

#, c-format
msgid "Replaced %d."
msgstr "%d vervangen."

msgid "Replace this one?"
msgstr "Deze vervangen?"

msgid "the document"
msgstr "het document"

#, c-format
msgid "%d word"
msgid_plural "%d words"
msgstr[0] "%d woord"
msgstr[1] "%d woorden"

#, c-format
msgid "%d character"
msgid_plural "%d characters"
msgstr[0] "%d teken"
msgstr[1] "%d tekens"

#, c-format
msgid "Line %d of %d."
msgstr "Regel %d van %d."

msgid "Go to line:"
msgstr "Ga naar regel:"

msgid "Go to line"
msgstr "Ga naar regel"

#, c-format
msgid ""
"A plain text editor for notes, lists and Markdown.\n"
"\n"
"Ctrl+N/O/S\tNew, open, save\n"
"Ctrl+Shift+S\tSave as\n"
"Ctrl+Q\tClose\n"
"Ctrl+C/X/V\tCopy, cut, paste\n"
"Ctrl+A\tSelect all\n"
"Ctrl+Z/Y\tUndo, redo\n"
"Ctrl+F, F3\tFind, find again\n"
"Ctrl+H\tReplace\n"
"Ctrl+L\tGo to line; counts words\n"
"Ctrl+P\tPrint, or print to a PDF\n"
"\n"
"Shift with the arrows, or a drag, selects. A .docx, .odt or .rtf opens converted, as Markdown in %s (the RAM disk): Save puts it in %s."
msgstr ""
"Een eenvoudige teksteditor voor notities, lijsten en Markdown.\n"
"\n"
"Ctrl+N/O/S\tNieuw, openen, opslaan\n"
"Ctrl+Shift+S\tOpslaan als\n"
"Ctrl+Q\tSluiten\n"
"Ctrl+C/X/V\tKopiëren, knippen, plakken\n"
"Ctrl+A\tAlles selecteren\n"
"Ctrl+Z/Y\tOngedaan maken, opnieuw\n"
"Ctrl+F, F3\tZoeken, verder zoeken\n"
"Ctrl+H\tVervangen\n"
"Ctrl+L\tGa naar regel; telt woorden\n"
"Ctrl+P\tAfdrukken, of afdrukken naar PDF\n"
"\n"
"Shift met de pijlen, of slepen, selecteert. Een .docx, .odt of .rtf opent omgezet, als Markdown in %s (de RAM-schijf): Opslaan zet het in %s."

msgid "Text help"
msgstr "Hulp bij text"
