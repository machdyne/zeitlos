# sw/apps/mausrun -- build rules are shared: sw/common/app.mk, docs/build.md.

APP = mausrun

# zsfx.c, the arcade games' sound engine (docs/sfx.md), is found here
SRC_DIRS = $(COMMON_DIR)/games

OBJS = zeitlos.o zobj.o zgfx.o zcolor.o zfont_data.o zwin.o zgame.o \
	zspeak.o zcfg.o zfsapp.o zsfx.o \
	zsprite.o sprites.o art.o level.o levels_builtin.o phys.o progress.o sound.o mausrun.o

# zgfx.c references the font tables (z_font_5x8 and friends) whenever
# anything draws text, and they live in their own translation unit --
# so an app that draws a single character needs this even though it
# never mentions zfont_data itself. Every other app that draws text
# links it; this one did not, and the link failed with an undefined
# z_font_5x8 rather than with anything pointing at the cause.

# sprites.c/.h are GENERATED by gen_sprites.py and committed, so a
# normal build needs no Python. Re-run the generator by hand after
# editing the art in it; there is deliberately no make rule doing that
# automatically, because a generated file rebuilding itself mid-build
# is how you get a tree that differs from what was committed without
# anyone noticing.
sprites.o: sprites.c sprites.h
	$(CC) $(CFLAGS) -c sprites.c -o sprites.o

# art.c: the card's /data/mausrun/tiles.zsp and sprites.zsp laid over
# the compiled-in art at start, read with sw/common/zsprite.c
art.o: art.c art.h sprites.h
	$(CC) $(CFLAGS) -c art.c -o art.o

sound.o: sound.c sound.h
	$(CC) $(CFLAGS) -c sound.c -o sound.o

level.o: level.c level.h sprites.h
	$(CC) $(CFLAGS) -c level.c -o level.o

# levels_builtin.c is GENERATED by gen_levels.py from the level files
# and committed, as sprites.c is; tests/levelcheck.c checks the two
# agree.
levels_builtin.o: levels_builtin.c level.h
	$(CC) $(CFLAGS) -c levels_builtin.c -o levels_builtin.o

phys.o: phys.c phys.h level.h sprites.h
	$(CC) $(CFLAGS) -c phys.c -o phys.o

progress.o: progress.c progress.h
	$(CC) $(CFLAGS) -c progress.c -o progress.o

# -- host tools: the levels checked and drawn, the parsers tested --

test:
	$(MAKE) -C tests

render:
	$(MAKE) -C tests render

clean: clean-tests
clean-tests:
	$(MAKE) -C tests clean

.PHONY: test render clean-tests

include ../../common/app.mk
