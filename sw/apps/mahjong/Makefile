# sw/apps/mahjong -- mahjong solitaire, a dual app (docs/mahjong_app.md).
#
# Build rules are shared: sw/common/app.mk, docs/build.md.

APP = mahjong
APP_LISTING = 0

# Objects, and why each is linked:
#
#   mj_*: the game (mj_layout, mj_layouts, mj_game), the faces' art
#   (mj_art, generated by gen_tiles.py), the picture (mj_canvas,
#   mj_board) and what input does (mj_play). None does I/O; the host
#   tests below build them as they are.
#
#   zarcade.o, zarcade_sys.o (with zsfx.o, zcfg.o), sui.o, zcolor.o,
#   zflist.o, zedit.o: the screen face -- the table on the arcade
#   runtime's 320x240 screen, in colour, its help on that screen.
#
#   zrng.o, zrand.o, zrand_sys.o: deal numbers from the ChaCha20
#   generator (the deals themselves come from the engine's own, so that
#   a number is the same deal everywhere -- mj_game.h).
#
#   zfsapp.o: the statistics and settings in /data/mahjong/stats.txt,
#   and layout files from /data/mahjong/layouts.
SRC_DIRS = $(COMMON_DIR)/games $(COMMON_DIR)/games/ui
OBJS = zeitlos.o zobj.o zgfx.o zwidget.o zspeak.o zdialog.o zfont_data.o zwin.o zrng.o zfsapp.o \
	zcolor.o zflist.o zedit.o zarcade.o zarcade_sys.o zsfx.o zcfg.o sui.o \
	zrand.o zrand_sys.o \
	mj_layout.o mj_layouts.o mj_game.o mj_art.o mj_canvas.o mj_board.o mj_play.o mj_face.o \
	mj_music.o mahjong.o

HOSTCC ?= cc

# -I ../../common is deliberately absent from the engine's tests: the
# engine includes nothing from Zeitlos, and a shared -I would let a bare
# #include "zgfx.h" pass here and fail on the board (sw/apps/poker's
# Makefile tells that story). The drawing's tests need zfont_data.c
# and nothing else from sw/common.
HOSTFLAGS = -std=gnu99 -Wall -Wextra -no-pie -O2

ENGINESRC = mj_layout.c mj_layouts.c mj_game.c
BOARDSRC  = $(ENGINESRC) mj_art.c mj_canvas.c mj_board.c ../../common/zfont_data.c
PLAYSRC   = $(BOARDSRC) mj_play.c

# Every shipped source, compiled with no -I: the header search the
# target build has.
TARGETSRC = mj_layout.c mj_layouts.c mj_game.c mj_art.c mj_canvas.c mj_board.c \
	mj_play.c mj_face.c mj_music.c mahjong.c

includecheck:
	@for f in $(TARGETSRC); do \
		$(HOSTCC) -std=gnu99 -Wall -DZ_APP_NAME='"mahjong"' -fsyntax-only $$f || exit 1; \
	done
	@echo "includecheck: every target source resolves its headers with no -I"

# rv32i boards have no FPU and link no soft-float by default; one double
# would pull tens of kilobytes in silently. A lexical check, comments and
# strings stripped first -- see sw/apps/poker/Makefile.
NOFLOATSRC = $(TARGETSRC)

nofloat:
	@for f in $(NOFLOATSRC) *.h; do \
		if $(HOSTCC) -fpreprocessed -dD -E $$f 2>/dev/null | \
			sed 's/"[^"]*"//g' | \
			grep -nE '(^|[^_[:alnum:]])(float|double)([^_[:alnum:]]|$$)'; then \
			echo "nofloat: FAILED -- floating point in $$f"; exit 1; \
		fi; \
		if $(HOSTCC) -fpreprocessed -dD -E $$f 2>/dev/null | \
			sed 's/"[^"]*"//g' | grep -nE '[0-9]\.[0-9]'; then \
			echo "nofloat: FAILED -- a decimal literal in $$f"; exit 1; \
		fi; \
	done
	@echo "nofloat: the app is integer-only"

# The definitive form of the check above: the target objects reference
# no soft-float helper. Needs the RISC-V toolchain and a completed
# `make`. Scoped to this app's own objects -- zobj.o's float is the
# shared object system's business (sw/apps/poker/Makefile says why).
APPOBJS = mj_layout.o mj_layouts.o mj_game.o mj_art.o mj_canvas.o mj_board.o \
	mj_play.o mj_face.o mj_music.o mahjong.o

nmcheck:
	@if $(PREFIX)nm $(APPOBJS) | \
		grep -E 'U __(add|sub|mul|div|fix|float|cmp|unord)[ds]f'; then \
		echo "nmcheck: FAILED -- soft-float reached this app's objects"; \
		exit 1; \
	fi
	@echo "nmcheck: no soft-float in this app's target objects"

#   includecheck  headers resolve the way the target build needs
#   nofloat       no floating point reaches an rv32i board
#   engine_test   the parser and its errors; the free rule against a
#                 second implementation from geometry, at every step;
#                 the set; thousands of numbered deals per layout
#                 replayed to an empty table; undo, redo, hints; and
#                 shuffles out of stuck games replayed to the end
#   board_test    the canvas against a pixel-at-a-time reference; the
#                 board's partial repaints against full ones, on every
#                 layout, corner, size and colour depth, through whole
#                 games; hit-testing against the drawn picture
#   play_test     clicks and keys through whole games -- by the keyboard
#                 alone too -- the clock, the statistics file, layouts
#                 that do not parse
#   screen        the screen face through the arcade runtime's host
#                 build: window, colour window, full screen in 64 colours
#                 and in mono, zoom, a turned view, a covered window,
#                 with keys and clicks -- every frame against a full
#                 repaint (AR_HOST_VERIFY)
test: includecheck nofloat
	$(HOSTCC) $(HOSTFLAGS) -o /tmp/mahjong_engine tests/engine_test.c $(ENGINESRC)
	$(HOSTCC) $(HOSTFLAGS) -o /tmp/mahjong_board tests/board_test.c $(BOARDSRC)
	$(HOSTCC) $(HOSTFLAGS) -o /tmp/mahjong_play tests/play_test.c $(PLAYSRC)
	/tmp/mahjong_engine
	/tmp/mahjong_board
	/tmp/mahjong_play
	$(HOSTCC) $(HOSTFLAGS) -I $(COMMON) -DZSFX_HOSTED -o /tmp/mahjong_music \
		tests/music_test.c mj_music.c $(GAMES)/zsfx.c
	/tmp/mahjong_music
	$(MAKE) --no-print-directory screen

# The runtime's host build: zgfx in software (sw/common/tests/zrender.h,
# which tests/screen.c includes), the window layer, zarcade.c itself and
# ar_host.c's framebuffer. -I ../../common for those alone.
COMMON = ../../common
GAMES = $(COMMON)/games
SCREENSRC = $(PLAYSRC) mj_face.c $(COMMON)/zwin.c $(COMMON)/zwidget.c \
	$(COMMON)/tests/zspeak_stub.c $(COMMON)/zobj.c $(COMMON)/zeitlos.c \
	$(GAMES)/zarcade.c $(GAMES)/zsfx.c $(GAMES)/tests/ar_host.c
SCREENFLAGS = $(HOSTFLAGS) -I $(COMMON) -DAR_HOST_TESTS -DZSFX_HOSTED \
	-Wno-unused-parameter -Wno-unused-function -Wno-sign-compare

screen:
	mkdir -p tests/out
	$(HOSTCC) $(SCREENFLAGS) -o /tmp/mahjong_screen tests/screen.c $(SCREENSRC)
	AR_HOST_VERIFY=1 /tmp/mahjong_screen tests/out

# The same, under the sanitizers: an overrun in a neighbour list or a
# canvas row is invisible on the host without them and is whatever came
# next on the board.
SANFLAGS = -std=gnu99 -g -O1 -no-pie -fsanitize=address,undefined -fno-omit-frame-pointer
stress:
	$(HOSTCC) $(SANFLAGS) -o /tmp/mahjong_s_engine tests/engine_test.c $(ENGINESRC)
	$(HOSTCC) $(SANFLAGS) -o /tmp/mahjong_s_board tests/board_test.c $(BOARDSRC)
	$(HOSTCC) $(SANFLAGS) -o /tmp/mahjong_s_play tests/play_test.c $(PLAYSRC)
	ASAN_OPTIONS=detect_leaks=0 /tmp/mahjong_s_engine
	ASAN_OPTIONS=detect_leaks=0 /tmp/mahjong_s_board
	ASAN_OPTIONS=detect_leaks=0 /tmp/mahjong_s_play
	$(HOSTCC) $(SANFLAGS) -I $(COMMON) -DAR_HOST_TESTS -DZSFX_HOSTED \
		-o /tmp/mahjong_s_screen tests/screen.c $(SCREENSRC)
	mkdir -p tests/out
	AR_HOST_VERIFY=1 ASAN_OPTIONS=detect_leaks=0 /tmp/mahjong_s_screen tests/out

# LOOK AT THE OUTPUT before changing the art, the colours or the
# drawing: tests/out/*.png -- the Turtle in 16 and 64 colours, eight,
# and black and white; a game in progress with a selection, a hint and
# the cursor; the dimmed blocked tiles; the view from each corner; the
# close zoom; the desktop face at both sizes; the other layouts. Every
# picture's partial repaints are checked against a full one as well.
# And `screen`'s pictures, the same table as the runtime shows it:
# tests/out/scr_*.
render: screen
	$(HOSTCC) $(HOSTFLAGS) -o /tmp/mahjong_render tests/render.c $(BOARDSRC)
	/tmp/mahjong_render tests/out
	-python3 ../pix/tests/ppm2png.py tests/out

# Re-runs the face generator (and its contact sheets in tests/out).
# Deliberately NOT a dependency of anything: a build that silently
# regenerates committed source hides what changed.
tiles:
	python3 gen_tiles.py

.PHONY: test includecheck nofloat nmcheck stress render screen tiles

include ../../common/app.mk
