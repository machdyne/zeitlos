#, c-format
msgid "%s -- not connected"
msgstr "%s -- inte ansluten"

msgid "ready"
msgstr "klar"

msgid "not running"
msgstr "körs inte"

msgid "not installed"
msgstr "inte installerad"

msgid "Scheme and system commands"
msgstr "Scheme och systemkommandon"

msgid "Unix-style shell, zcc and vi"
msgstr "Unixliknande skal, zcc och vi"

msgid "Boot log and kernel shell"
msgstr "Startlogg och kärnskal"

msgid "port, serial, telnet or ssh"
msgstr "port, serial, telnet eller ssh"

msgid "Tab chooses, Enter connects, or type a target"
msgstr "Tab väljer, Enter ansluter, eller skriv ett mål"

msgid "F12 disconnects  Esc hides  Shift+PgUp scrolls"
msgstr "F12 kopplar ner  Esc döljer  Skift+PgUp rullar"

msgid "auto-connect cancelled"
msgstr "automatisk anslutning avbruten"

#, c-format
msgid "%.40s is not running"
msgstr "%.40s körs inte"

#, c-format
msgid "connecting to %.45s ...  (Esc cancels)"
msgstr "ansluter till %.45s ...  (Esc avbryter)"

#, c-format
msgid "%.30s refused: %.40s"
msgstr "%.30s vägrade: %.40s"

#, c-format
msgid "%.55s refused the connection"
msgstr "%.55s vägrade anslutningen"

#, c-format
msgid "cancelled connecting to %.50s"
msgstr "anslutning till %.50s avbruten"

#, c-format
msgid "no answer from %.50s"
msgstr "inget svar från %.50s"

#, c-format
msgid "could not start %s -- %s"
msgstr "kunde inte starta %s -- %s"

#, c-format
msgid "starting %s"
msgstr "startar %s"

#, c-format
msgid "starting %s...  (Esc cancels)"
msgstr "startar %s...  (Esc avbryter)"

#, c-format
msgid "auto-connect: %.40s  (Esc cancels)"
msgstr "automatiskt: %.40s  (Esc avbryter)"

#, c-format
msgid "%s: %.24s did not appear -- choose below"
msgstr "%s: %.24s dök inte upp -- välj nedan"

msgid "Blank screen"
msgstr "Tom skärm"

msgid "Nothing selected"
msgstr "Inget markerat"

msgid "disconnected (F12)"
msgstr "nedkopplad (F12)"

msgid "choose a shell, or open a connection"
msgstr "välj ett skal eller öppna en anslutning"

msgid "connection closed by the other end"
msgstr "anslutningen stängdes av andra sidan"
