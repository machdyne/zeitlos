#, c-format
msgid "%s -- not connected"
msgstr "%s -- sem ligação"

msgid "ready"
msgstr "pronto"

msgid "not running"
msgstr "parado"

msgid "not installed"
msgstr "não instalado"

msgid "Scheme and system commands"
msgstr "Scheme e comandos do sistema"

msgid "Unix-style shell, zcc and vi"
msgstr "Shell ao estilo Unix, zcc e vi"

msgid "Boot log and kernel shell"
msgstr "Registo de arranque e shell do núcleo"

msgid "port, serial, telnet or ssh"
msgstr "port, serial, telnet ou ssh"

msgid "Tab chooses, Enter connects, or type a target"
msgstr "Tab escolhe, Enter liga, ou escreva um destino"

msgid "F12 disconnects  Esc hides  Shift+PgUp scrolls"
msgstr "F12 desliga  Esc esconde  Shift+PgUp desloca"

msgid "auto-connect cancelled"
msgstr "ligação automática cancelada"

#, c-format
msgid "%.40s is not running"
msgstr "%.40s não está a correr"

#, c-format
msgid "connecting to %.45s ...  (Esc cancels)"
msgstr "a ligar a %.45s ...  (Esc cancela)"

#, c-format
msgid "%.30s refused: %.40s"
msgstr "%.30s recusou: %.40s"

#, c-format
msgid "%.55s refused the connection"
msgstr "%.55s recusou a ligação"

#, c-format
msgid "cancelled connecting to %.50s"
msgstr "ligação a %.50s cancelada"

#, c-format
msgid "no answer from %.50s"
msgstr "sem resposta de %.50s"

#, c-format
msgid "could not start %s -- %s"
msgstr "impossível iniciar %s -- %s"

#, c-format
msgid "starting %s"
msgstr "a iniciar %s"

#, c-format
msgid "starting %s...  (Esc cancels)"
msgstr "a iniciar %s...  (Esc cancela)"

#, c-format
msgid "auto-connect: %.40s  (Esc cancels)"
msgstr "ligação automática: %.40s  (Esc cancela)"

#, c-format
msgid "%s: %.24s did not appear -- choose below"
msgstr "%s: %.24s não apareceu -- escolha abaixo"

msgid "Blank screen"
msgstr "Ecrã vazio"

msgid "Nothing selected"
msgstr "Nada selecionado"

msgid "disconnected (F12)"
msgstr "desligado (F12)"

msgid "choose a shell, or open a connection"
msgstr "escolha uma shell ou abra uma ligação"

msgid "connection closed by the other end"
msgstr "o outro lado fechou a ligação"
