# sw/apps/chess -- build rules are shared: sw/common/app.mk, docs/build.md.

APP = chess

# The engine (ce_*.o) has no I/O of any kind in it, which is what lets
# the host tests below build the SHIPPED sources rather than a copy.
# See ce_core.h's header.

# Objects, and why each is linked:
#
#   zrng.o: The system CSPRNG, seeded from rtl/trng.v where the board has one.
#   chess.c uses it for exactly one thing -- seeding the engine's own
#   generator once per game -- but that one thing is the difference
#   between a hand-rolled entropy recipe and the one the rest of the
#   tree already agreed on. See seed_engine() in chess.c.
#
#   pieces.o: Generated by gen_pieces.py and committed alongside it, so the build
#   needs no Python -- same arrangement as sw/apps/gamedemo's sprites
#   and sw/data/icons. Re-run the generator by hand after editing the
#   art; it is deliberately NOT a make rule, because a build that
#   silently regenerates committed source hides what changed.
OBJS = zeitlos.o zobj.o zgfx.o zfont_data.o zwin.o zrng.o \
	ce_core.o ce_psq.o ce_eval.o ce_search.o ce_book.o \
	pieces.o game.o board_ui.o input.o chess.o

# A .zexe rather than a raw --pad-to binary: the header carries .bss
# as a NUMBER instead of writing it out as literal zeros to be read
# off the SD card on every launch. That matters more here than in most
# apps -- the transposition table alone is 24KB of .bss. See
# sw/common/zexec.h.

# -- host-side tests --
#
# Native cc, no RISC-V toolchain involved, and the REAL sources in
# every target. There is no second copy of the move generator, the
# evaluation or the layout anywhere in this tree.
HOSTCC ?= cc

# Two lists, because the two kinds of test need different things and
# one list for both does not link.
#
# ENGINESRC is pure logic -- no MMIO, no window layer. It must NOT
# have zwin.c, which references the z_fb_* pixel primitives that only
# sw/common/tests/zrender.h supplies; linking it into a test that does
# not include that header fails with a page of undefined references to
# functions the test never calls.
ENGINESRC = ce_core.c ce_psq.c ce_eval.c ce_search.c ce_book.c

# PANELSRC adds the drawing, for the two targets that include
# tests/chess_shim.h and therefore do have software pixel primitives.
# zgfx.c is deliberately absent -- see zrender.h's header for why the
# plotting is stubbed and the layout is not.
PANELSRC = $(ENGINESRC) pieces.c game.c board_ui.c input.c \
	../../common/zwin.c ../../common/zfont_data.c \
	../../common/zobj.c ../../common/zeitlos.c

# -I ../../common is here and NOT in CFLAGS above, deliberately.
#
# The target build has no -I at all: every app in this tree reaches
# sw/common through an explicit "../../common/zwin.h" in the source,
# and this app does the same. Adding -I to CFLAGS would let a bare
# #include "zgfx.h" compile here and nowhere else, which is exactly
# the trap this app fell into once -- the host tests were green while
# `make` failed on the first common header it reached.
#
# The host builds still need it, for a reason that has nothing to do
# with this app's sources: sw/common/tests/zrender.h lives in
# sw/common/tests/ and includes "zgfx.h", which is one directory up
# from it. That is zrender.h's business, not this app's, and it is why
# sw/apps/cal/Makefile carries the same flag.
HOSTFLAGS = -std=gnu99 -Wall -no-pie -O2 -I ../../common

# LOOK at the output before changing the art or the layout.
#
# Five states, because four of them are a nuisance to reach on
# hardware:
#
#   make render                  the opening position
#   make render WHAT=midgame     a piece selected, destinations marked
#   make render WHAT=thinking    the engine's progress indicator
#   make render WHAT=mate        checkmate, with the check frame
#   make render WHAT=narrow      too narrow for the panel
#   make render WHAT=game        the 320x240 full-screen page
WHAT ?= start

render:
	$(HOSTCC) $(HOSTFLAGS) -o /tmp/chess_render tests/render.c $(PANELSRC)
	/tmp/chess_render /tmp/chess.pbm $(WHAT)
	@echo "wrote /tmp/chess.pbm ($(WHAT)) -- other states: make render \
WHAT=midgame|thinking|mate|narrow|game"

# Every source the TARGET build compiles, checked with the host
# compiler and NO -I -- which is the header search the target build
# actually has.
#
# This exists because of a real failure. The host tests carry
# -I ../../common (see above), so a bare #include "zgfx.h" in an app
# source compiled cleanly in every host target and failed on the first
# line of `make`. Four green test binaries and a broken build is a bad
# place to be, and nothing in the test suite could have noticed --
# they all run under the wrong flags by necessity.
#
# -fsyntax-only, so no RISC-V toolchain is needed to run it. It cannot
# catch a genuinely target-only compile error, but header resolution
# is not target-specific and header resolution is what broke.
TARGETSRC = ce_core.c ce_psq.c ce_eval.c ce_search.c ce_book.c pieces.c \
	game.c board_ui.c input.c chess.c

includecheck:
	@for f in $(TARGETSRC); do \
		$(HOSTCC) -std=gnu99 -Wall -fsyntax-only $$f || exit 1; \
	done
	@echo "includecheck: every target source resolves its headers with no -I"

# Unattended.
#
#   includecheck  the headers resolve the way the target build needs
#   perft_test    move generation, against published counts AND a
#                 second generator written in the test
#   core_test     the derived state, the Zobrist key, make/unmake,
#                 notation and the drawing rules
#   search_test   evaluation symmetry, forced mates against a
#                 brute-force solver, aborting, the difficulty ladder
#   test_layout   the board geometry and the repaint
test: includecheck
	$(HOSTCC) $(HOSTFLAGS) -o /tmp/chess_perft tests/perft_test.c $(ENGINESRC)
	$(HOSTCC) $(HOSTFLAGS) -o /tmp/chess_core tests/core_test.c $(ENGINESRC)
	$(HOSTCC) $(HOSTFLAGS) -o /tmp/chess_search tests/search_test.c $(ENGINESRC)
	$(HOSTCC) $(HOSTFLAGS) -o /tmp/chess_layout tests/test_layout.c $(PANELSRC)
	/tmp/chess_perft
	/tmp/chess_core
	/tmp/chess_search
	/tmp/chess_layout

pieces:
	python3 gen_pieces.py

.PHONY: render test pieces includecheck

include ../../common/app.mk
