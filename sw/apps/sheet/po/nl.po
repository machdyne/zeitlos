msgid "No chart: select the data, then F5."
msgstr "Geen grafiek: kies de gegevens, dan F5."

msgid "Nothing to chart in the range."
msgstr "Niets in het bereik om te tekenen."

msgid "No numbers in the range to chart."
msgstr "Geen getallen in het bereik."

msgid "A pie needs some positive numbers."
msgstr "Een taart heeft positieve getallen nodig."

msgid "Sum "
msgstr "Som "

msgid "  Avg "
msgstr "  Gem "

msgid "  Count "
msgstr "  Aantal "

