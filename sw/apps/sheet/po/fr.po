"copie à convertir."

msgid "Save failed"
msgstr "Échec de l'enregistrement"

msgid ""
"Could not open the file\n"
"for writing."
msgstr ""
"Impossible d'ouvrir le fichier\n"
"en écriture."

msgid ""
"The file could not be\n"
"written completely."
msgstr ""
