"copy to convert."
msgstr ""
"Не удалось записать\n"
"копию для конвертации."

msgid "Save failed"
msgstr "Ошибка сохранения"

msgid ""
"Could not open the file\n"
"for writing."
msgstr ""
"Не удалось открыть файл\n"
"для записи."

msgid ""
"The file could not be\n"
"written completely."
msgstr ""
"Не удалось записать\n"
