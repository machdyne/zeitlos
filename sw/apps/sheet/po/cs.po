msgid "No chart: select the data, then F5."
msgstr "Žádný graf: vyberte data, pak F5."

msgid "Nothing to chart in the range."
msgstr "V rozsahu není co zobrazit."

msgid "No numbers in the range to chart."
msgstr "V rozsahu nejsou čísla."

msgid "A pie needs some positive numbers."
msgstr "Koláč potřebuje kladná čísla."

msgid "Sum "
msgstr "Součet "

msgid "  Avg "
msgstr "  Prům. "

msgid "  Count "
msgstr "  Počet "

