Z_MKSYSCALL(EXIT, z_exit)
Z_MKSYSCALL(UI_PRINT, z_ui_print)
Z_MKSYSCALL(UART_GETC, z_uart_getc)
Z_MKSYSCALL(UART_PUTC, z_uart_putc)
Z_MKSYSCALL(UART_RX_EMPTY, z_uart_rx_empty)
Z_MKSYSCALL(UART_TX_FULL, z_uart_tx_full)
Z_MKSYSCALL(MSG_SEND, k_msg_send)
Z_MKSYSCALL(MSG_READ, k_msg_read)
Z_MKSYSCALL(UPTIME, z_uptime)
// new syscalls always go at the END of this list, never inserted in
// the middle -- every id above this point must stay exactly where it
// already was, in every already-flashed kernel, forever. inserting a
// new entry earlier shifts every subsequent Z_MKSYSCALL's enum value
// (Z_SYS_MSG_SEND, etc.) by one, and since z_syscall_id_t is generated
// fresh from whichever syscalls.def each binary happens to be built
// from, an app built against a newer syscalls.def than the currently
// flashed kernel.bin would silently call the WRONG kernel handler for
// every syscall after the insertion point -- not a crash, just quietly
// wrong behavior that looks like unrelated memory corruption. (This
// bit us for real once already, during phase 1 of keyboard/input
// work -- HID_READ_KEY was originally inserted here, ahead of
// MSG_SEND, and got moved to the end for exactly this reason.)
// kernel.bin and every app must always be rebuilt+reflashed together
// after any change to this file, regardless of where the change was made.
Z_MKSYSCALL(HID_READ_KEY, z_hid_read_key)
Z_MKSYSCALL(PID_REGISTER, k_pid_register)
Z_MKSYSCALL(PID_LOOKUP, k_pid_lookup)
Z_MKSYSCALL(GETPID, k_getpid)
