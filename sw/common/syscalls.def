Z_MKSYSCALL(EXIT, z_exit)
Z_MKSYSCALL(UI_PRINT, z_ui_print)
Z_MKSYSCALL(UART_GETC, z_uart_getc)
Z_MKSYSCALL(UART_PUTC, z_uart_putc)
Z_MKSYSCALL(UART_RX_EMPTY, z_uart_rx_empty)
Z_MKSYSCALL(UART_TX_FULL, z_uart_tx_full)
Z_MKSYSCALL(MSG_SEND, k_msg_send)
Z_MKSYSCALL(MSG_READ, k_msg_read)
Z_MKSYSCALL(UPTIME, z_uptime)
// new syscalls always go at the END of this list, never inserted in
// the middle -- every id above this point must stay exactly where it
// already was, in every already-flashed kernel, forever. inserting a
// new entry earlier shifts every subsequent Z_MKSYSCALL's enum value
// (Z_SYS_MSG_SEND, etc.) by one, and since z_syscall_id_t is generated
// fresh from whichever syscalls.def each binary happens to be built
// from, an app built against a newer syscalls.def than the currently
// flashed kernel.bin would silently call the WRONG kernel handler for
// every syscall after the insertion point -- not a crash, just quietly
// wrong behavior that looks like unrelated memory corruption. (This
// bit us for real once already, during phase 1 of keyboard/input
// work -- HID_READ_KEY was originally inserted here, ahead of
// MSG_SEND, and got moved to the end for exactly this reason.)
// kernel.bin and every app must always be rebuilt+reflashed together
// after any change to this file, regardless of where the change was made.
Z_MKSYSCALL(HID_READ_KEY, z_hid_read_key)
Z_MKSYSCALL(PID_REGISTER, k_pid_register)
Z_MKSYSCALL(PID_LOOKUP, k_pid_lookup)
Z_MKSYSCALL(GETPID, k_getpid)
// launches a new process from a named file on the FAT filesystem --
// see k_proc_run() in sw/os/kernel.c for the full writeup. added for
// sw/apps/wm's dock (see docs/window_manager.md), the first thing
// besides the kernel shell that needs to start a process.
Z_MKSYSCALL(PROC_RUN, k_proc_run)
// filesystem access for ordinary apps (not just sh.c/kernel code) --
// see sw/os/fsapi.h for the full design writeup. Added for
// sw/apps/repl's `te` command (docs/editor.md), deliberately general.
Z_MKSYSCALL(FS_SIZE, k_fs_size)
Z_MKSYSCALL(FS_READ, k_fs_read)
Z_MKSYSCALL(FS_WRITE, k_fs_write)
// Files half of the Zeitlos Scheme API (docs/scheme_api.md) needed
// two more: deleting a file, and listing a directory (previously
// print-only, sh.c-only -- see sw/os/fsapi.h's own comment on
// k_fs_list()).
Z_MKSYSCALL(FS_UNLINK, k_fs_unlink)
Z_MKSYSCALL(FS_LIST, k_fs_list)
// chunked file I/O for `tget`/`tput` (docs/scheme_api.md,
// "Networking") -- see sw/common/zfs.h for the full design writeup.
Z_MKSYSCALL(FS_OPEN_WRITE, k_fs_open_write)
Z_MKSYSCALL(FS_OPEN_READ, k_fs_open_read)
Z_MKSYSCALL(FS_READ_CHUNK, k_fs_read_chunk)
Z_MKSYSCALL(FS_WRITE_CHUNK, k_fs_write_chunk)
Z_MKSYSCALL(FS_CLOSE, k_fs_close)
// kills another process outright, from userland -- see
// k_proc_kill_syscall() in sw/os/kernel.c for the full writeup. Added
// for sw/apps/wm's Z_WIN_FLAG_CLOSE_KILLS_OWNER (docs/window_manager.md):
// wm needs to be able to kill a window's owning process when its
// close icon is clicked, the same way k_proc_run() (above) let wm
// start one.
Z_MKSYSCALL(PROC_KILL, k_proc_kill_syscall)
// Directory creation / empty-file creation, previously reachable only
// from sh.c (kernel code, links fs/fs.c directly) via its own `mkdir`
// and `touch` commands. Added for the Scheme API's (mkdir ...) and
// (touch-file ...) -- see docs/scheme_api.md's own "Files" section.
// Thin wrappers over the existing fs_mkdir()/fs_touch() (sw/os/fs/fs.c),
// following every convention the other FS_* handlers here already do.
Z_MKSYSCALL(FS_MKDIR, k_fs_mkdir)
Z_MKSYSCALL(FS_TOUCH, k_fs_touch)
// Repositions an already-open chunked-I/O handle (Z_SYS_FS_OPEN_READ /
// _OPEN_WRITE, see sw/common/zfs.h). Added for sw/apps/repl's `page`
// command (a VT100 pager over files far too large to hold in memory --
// see page.h): scrolling BACKWARDS needs to re-read a region that's
// already behind the current read position, and every existing chunked
// call only ever moves forward. Without this, a page-up in a
// book-sized file would mean closing, reopening, and re-reading from
// byte 0 every time.
Z_MKSYSCALL(FS_SEEK, k_fs_seek)
// A snapshot of the live process table, as DATA rather than as the
// console-only printf() dump k_proc_dump() (sw/os/kernel.c) already
// does for sh.c's `ps`. Added so the Scheme API's (ps) can return a
// real list of lists a caller can filter/sort/act on -- see
// docs/scheme_api.md's own "Processes" section. Same relationship
// k_fs_list() has to fs_list_dir(): the print-only version stays
// exactly as it is, this returns the same information to a caller.
Z_MKSYSCALL(PROC_LIST, k_proc_list)
// Likewise for the kernel's own memory pool (sw/os/mem.c) -- the data
// behind k_mem_dump()/sh.c's `free`, returned instead of printed, so
// the Scheme API's (free) can report the WHOLE picture (kernel pool +
// this process's own Scheme/C heaps) rather than just the part a
// process can see about itself.
Z_MKSYSCALL(MEM_STATS, k_mem_stats)
// Filesystem capacity -- fs_total()/fs_free() (sw/os/fs/fs.c) have
// existed all along but were never reachable from anywhere: no syscall,
// no shell command, nothing in Scheme. This exposes them, for `df` in
// both sh.c and the Scheme API.
Z_MKSYSCALL(FS_DF, k_fs_df)
// Blocks the calling process until a message arrives or a timeout
// elapses, instead of spinning on z_msg_read(). Argument is the
// timeout in kernel ticks (0 = wait indefinitely). See k_proc_wait()
// in sw/os/kernel.c for the lost-wakeup race this has to avoid, and
// Z_PROC_FLAG_BLOCKED in sw/os/kernel.h for why the scheduler needed
// this at all.
Z_MKSYSCALL(PROC_WAIT, k_proc_wait)
// Does a launchable app by this name exist, from the filesystem OR the
// flash core-app archive? Returns its image size, 0 if not. Used by
// wm's dock to show only apps that are actually present. See
// k_exec_exists() in sw/os/fsapi.c.
Z_MKSYSCALL(EXEC_EXISTS, k_exec_exists)
// Virtual phosphor mode -- the display's colour scheme (white/amber/
// green/paper), see rtl/socctl.v's VIDEO register and docs/socctl.md.
//
// These are the FIRST syscalls in this file whose work an app could
// equally well do itself: the register is plain MMIO and nothing stops
// an app writing it, exactly as sw/apps/wm already writes socctl's
// CTRL directly via z_cursor_set_busy(). They exist anyway because the
// display is genuinely shared state -- every process is looking at the
// same screen -- and routing changes through the kernel means there is
// one place to put policy when that starts to matter. Nothing is
// arbitrated today; the honest description is that this is where the
// arbitration would go, not that it already happens.
Z_MKSYSCALL(VIDEO_GET_MODE, k_video_get_mode)
Z_MKSYSCALL(VIDEO_SET_MODE, k_video_set_mode)

// Registers the caller as the process the HID ISR wakes when a
// pointer report arrives (sw/os/hid.c). Lets wm stop polling
// reg_usbN_cursor at 732Hz and block instead -- see
// docs/user_input.md, "Pointer wakeups".
//
// AT THE END, like every other addition here. See the warning above.
Z_MKSYSCALL(HID_PTR_SUBSCRIBE, k_hid_ptr_subscribe)
