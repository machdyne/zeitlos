#!/usr/bin/env python3
#
# Zeitlos release tooling.
#
#   zrelease list                  what can be built
#   zrelease check                 specs vs rtl/boards.vh, flash layout
#   zrelease layout                the flash map, as this tool reads it
#   zrelease sdcard                build only the SD card image
#   zrelease build <version>       build everything into dist/<version>/
#   zrelease verify <version>      re-check what is in dist/<version>/
#   zrelease ship  <version>       create or update the GitHub release
#   zrelease clean                 remove generated files from the tree
#
# Build and ship are separate commands and neither implies the other:
# building is slow and produces something you want to try on real
# hardware first, and publishing is hard to take back.
#
# EVERY command starts by sweeping up generated files left behind by a
# previous run, so a build killed halfway through cannot leave a stale
# rtl/zspec.vh where the ordinary `make BOARD=... flash` might trip
# over it. See release/lib/gen.py.
#

import sys as _sys

# No __pycache__. This tool runs once per invocation, so the bytecode
# cache saves nothing measurable -- and it is written into
# release/lib/, which made `git status` dirty as a side effect of
# running `zrelease check`, which then made `zrelease build` refuse to
# run. A check that its own tooling trips is a check people learn to
# pass --allow-dirty to, which defeats it.
#
# Belt and braces with the .gitignore entry: this way the file is never
# created, so a checkout that predates that entry behaves too.
_sys.dont_write_bytecode = True

import argparse
import gzip
import json
import os
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, os.path.join(HERE, "lib"))

import build as build_mod      # noqa: E402
import gen                     # noqa: E402
import layout as layout_mod    # noqa: E402
import mkfatimg                # noqa: E402
import mkflashimg              # noqa: E402
import notes as notes_mod      # noqa: E402
import ship as ship_mod        # noqa: E402
import spec                    # noqa: E402


def distdir(version):
    return os.path.join(HERE, "dist", version)


def die(msg):
    print("\nzrelease: %s" % msg, file=sys.stderr)
    sys.exit(1)


# ---------------------------------------------------------------------

def cmd_list(args):
    print("targets:\n")
    for name in spec.list_targets(ROOT):
        t = spec.load_target(ROOT, name)
        print("  %-20s %s" % (name, t.description))
        print("  %-20s board %s, %s, nic %s, %d defines"
              % ("", t.board, t.family, t.nic() or "none",
                 len(t.defines)))
        for pm in t.pmods:
            balls = t.pmod_ports[pm.port]
            print("  %-20s port %s: %s (%s)"
                  % ("", pm.port.upper(), pm.name,
                     ", ".join("%s=%s" % (pm.pins[k], balls[k])
                               for k in sorted(pm.pins))))
        print()
    return 0


def cmd_layout(args):
    lay = layout_mod.load(ROOT)
    print("\nflash map, read from sw/bios/bios.c, sw/os/logo.h, "
          "sw/os/zar.h and the Makefile:\n")
    print(layout_mod.describe(lay))
    print("\nall four sources agree.\n")
    return 0


def cmd_check(args):
    problems = []

    print("\nflash layout ...")
    try:
        lay = layout_mod.load(ROOT)
        print("  ok -- 0x%06x bytes, %d regions"
              % (lay["flash_size"], len(lay["regions"])))
    except layout_mod.LayoutError as e:
        problems.append(str(e))
        print("  FAILED")

    print("\narch ...")
    try:
        arch = spec.derive_arch(ROOT)
        print("  ok -- rtl/boards.vh implies %s" % arch)
    except spec.SpecError as e:
        problems.append(str(e))
        print("  FAILED")

    print("\nversion ...")
    try:
        v = build_mod.read_version(ROOT)
        print("  ok -- %s says Z_OS_VERSION %s" % (build_mod.VERSION_H, v))
    except build_mod.BuildError as e:
        problems.append(str(e))
        print("  FAILED")

    print("\nspecs vs rtl/boards.vh ...")
    for name in spec.list_targets(ROOT):
        try:
            t = spec.load_target(ROOT, name)
        except spec.SpecError as e:
            problems.append("%s: %s" % (name, e))
            print("  %-20s FAILED" % name)
            continue
        drift = spec.check_drift(ROOT, t)
        if drift:
            problems.extend(drift)
            print("  %-20s DRIFT" % name)
        else:
            print("  %-20s ok" % name)

    print("\npin constraints ...")
    for name in spec.list_targets(ROOT):
        t = spec.load_target(ROOT, name)
        try:
            rel, _ = gen.merged_lpf(ROOT, t)
        except RuntimeError as e:
            problems.append(str(e))
            print("  %-20s BLOCKED" % name)
            continue
        cov = gen.check_port_coverage(ROOT, t, spec)
        if cov:
            problems.extend("%s: %s" % (name, c) for c in cov)
            print("  %-20s UNCONSTRAINED PORT" % name)
            continue
        if rel is None:
            print("  %-20s ok -- board .lpf unchanged" % name)
        else:
            a, r, m = gen.check_lpf_equivalence(ROOT, t)
            bits = []
            if a:
                bits.append("+%d" % len(a))
            if r:
                bits.append("-%d" % len(r))
            if m:
                bits.append("moved %d" % len(m))
            print("  %-20s ok -- %s vs the board .lpf"
                  % (name, ", ".join(bits) if bits else "identical"))
            for pm in t.pmods:
                print("  %-20s      %s in port %s"
                      % ("", pm.name, pm.port.upper()))

    # The checks above compare text against text. This one runs a real
    # Verilog preprocessor over rtl/boards.vh both ways and compares
    # what a synthesis tool would actually see -- which is what catches
    # a misplaced `ifdef in the ZSPEC guard, or an include that
    # resolved to nothing at all.
    print("\npreprocessor equivalence (ZSPEC vs BOARD_x) ...")
    for name in spec.list_targets(ROOT):
        t = spec.load_target(ROOT, name)
        text = gen.zspec_vh(t, "check", "check")
        try:
            eq = spec.check_equivalence(ROOT, t, text)
        except spec.SpecError as e:
            problems.append(str(e))
            print("  %-20s FAILED" % name)
            continue
        if eq is None:
            print("  %-20s skipped -- iverilog not installed" % name)
        elif eq:
            problems.extend("%s: %s" % (name, p) for p in eq)
            print("  %-20s MISMATCH" % name)
        else:
            print("  %-20s ok" % name)

    # The mkfatimg.py / mkfatimg.sh comparison that used to live here is
    # gone with the duplication it policed: tools/mkfatimg.sh calls
    # `zrelease sdcard` now, so there is one list and nothing to drift.

    print("\ntools ...")
    for tool, why in (("yosys", "synthesis"), ("nextpnr-ecp5", "place+route"),
                      ("ecppack", "bitstream"), ("ecpbram", "BIOS into BRAM"),
                      ("mkfs.fat", "SD image"), ("mcopy", "SD image"),
                      ("gh", "publishing")):
        found = shutil.which(tool)
        print("  %-16s %s" % (tool, found or "MISSING (%s)" % why))

    if problems:
        print("\n%d problem(s):\n" % len(problems))
        for p in problems:
            print("  - %s\n" % p.replace("\n", "\n    "))
        return 1
    print("\nall checks passed.\n")
    return 0


def cmd_clean(args):
    removed, kept = gen.sweep(ROOT, verbose=True)
    if not removed and not kept:
        print("nothing to clean -- the tree has no generated files.")
    if kept:
        print("\n%d file(s) left in place because they were modified."
              % len(kept))
        return 1
    return 0


# ---------------------------------------------------------------------

def cmd_build(args):
    version = build_mod.normalise_version(args.version)
    tree_version = build_mod.read_version(ROOT)

    if tree_version != version:
        if args.bump:
            print("bumping %s: %s -> %s"
                  % (build_mod.VERSION_H, tree_version, version))
            build_mod.bump_version(ROOT, version)
            print("  This is an edit to a tracked file -- commit it.\n")
        else:
            die("%s says Z_OS_VERSION is %r, but you asked to build %r.\n\n"
                "  The version is compiled into the kernel and shown by the "
                "info app, so shipping these mismatched means the release\n"
                "  page and the running system disagree about what it is.\n\n"
                "  Either build %s, or pass --bump to update the header "
                "(then commit it)."
                % (build_mod.VERSION_H, tree_version, version, tree_version))

    targets = args.targets or spec.list_targets(ROOT)
    for name in targets:
        if name not in spec.list_targets(ROOT):
            die("no such target %r. `zrelease list` shows what there is."
                % name)

    lay = layout_mod.load(ROOT)
    commit, dirty = build_mod.git_commit(ROOT)
    out = distdir(version)

    # -- what is already here ------------------------------------------
    #
    # Building is INCREMENTAL into dist/<version>/. Building two targets
    # today, publishing, then adding a third next week under the same
    # version is a normal thing to want, and `ship` already updates an
    # existing release in place -- so a second `build` must add to the
    # directory rather than replace it.
    #
    # It nearly did already, since nothing wipes dist/. But the manifest
    # and the notes were regenerated from THIS RUN's targets only, which
    # would have quietly rewritten a three-target release page to
    # describe one. Merge instead.
    previous = _load_manifest(out)
    prev_targets = {t["target"]: t for t in previous.get("targets", [])}
    if args.resume and prev_targets:
        # -- finish an interrupted release ----------------------------
        #
        # Building a target always rebuilds it, which is the right
        # default: the usual reason to name one is that something it
        # depends on changed. --resume is for the other case, where the
        # release simply did not get all the way through -- a later
        # target missed timing, or the machine was needed for something
        # else.
        #
        # Dropped here rather than at the argument, so it works the same
        # whether the run names targets or takes them all.
        skipped = [t for t in targets if t in prev_targets]
        targets = [t for t in targets if t not in prev_targets]
        if skipped:
            print("\n--resume: skipping %d already built (%s)"
                  % (len(skipped), ", ".join(skipped)))
        if not targets and not args.rebuild_sdcard:
            print("\nnothing left to build in %s.\n"
                  % os.path.relpath(out, ROOT))
            return 0
        if not targets:
            # --rebuild-sdcard is still work. Falling through with an
            # empty target list rebuilds the card and regenerates the
            # notes, README, manifest and checksums from what is
            # already here -- which is the whole point of asking for
            # the card on its own.
            print("\nno targets left; rebuilding the sdcard image only.")

    if prev_targets:
        print("\nalready in %s:" % os.path.relpath(out, ROOT))
        for name in sorted(prev_targets):
            # `targets`, not `args.targets`. Omitting --targets means
            # EVERY target, and this line used to ask whether the name
            # was in the raw argument -- which is None then, so a run
            # that was about to rebuild all five printed "keep" beside
            # all five.
            mark = "will rebuild" if name in targets else "keep"
            print("  %-20s %s" % (name, mark))

    print("\nzeitlos %s" % version)
    print("  commit   %s%s"
          % (commit[:12],
             " (tree is DIRTY: %d file(s))" % len(dirty) if dirty else ""))
    print("  targets  %s" % ", ".join(targets))
    print("  output   %s" % os.path.relpath(out, ROOT))
    # -- one release, one commit ---------------------------------------
    #
    # The kernel and the sdcard image are board-independent and are
    # built ONCE for the whole release, but each target's flash image
    # embeds its own copy of that kernel. Adding a target from a
    # different commit therefore produces a release whose images do not
    # all contain the same kernel -- and sw/common/syscalls.def is
    # compiled into both the kernel and every app, so a mismatched pair
    # calls the wrong handler for every syscall past the point they
    # diverge.
    #
    # Building the rest of a release later from the SAME commit is
    # completely fine and is the case this whole path exists for.
    prev_commit = previous.get("commit")
    if prev_targets and prev_commit and prev_commit != commit:
        if not args.allow_mixed_commits:
            die("%s was built from %s; you are now on %s.\n\n"
                "  Adding a target from a different commit gives a release "
                "whose images do not all contain the\n"
                "  same kernel. sw/common/syscalls.def is compiled into "
                "both the kernel and every app, so a\n"
                "  mismatched pair calls the wrong handler for every "
                "syscall past the point they diverge.\n\n"
                "  Either check out %s and build there, or rebuild every "
                "target from the current commit:\n"
                "    rm -rf %s && release/zrelease build %s\n\n"
                "  --allow-mixed-commits if you have verified nothing "
                "relevant changed between the two."
                % (os.path.relpath(out, ROOT), prev_commit[:12], commit[:12],
                   prev_commit[:12], os.path.relpath(out, ROOT), version))
        print("\n  WARNING: mixing commits -- %s here, %s previously."
              % (commit[:12], prev_commit[:12]))

    if dirty and not args.allow_dirty:
        shown = dirty[:15]
        listing = "\n".join("    %s" % p for p in shown)
        if len(dirty) > len(shown):
            listing += "\n    ... and %d more" % (len(dirty) - len(shown))
        die("the working tree has uncommitted changes:\n\n%s\n\n"
            "  A release built from a dirty tree cannot be reproduced from "
            "its recorded commit, and the\n"
            "  manifest would say it came from %s when it did not. Commit "
            "or stash, or pass --allow-dirty\n"
            "  if this is a test build you are not going to ship.\n\n"
            "  Anything .gitignore covers is already excluded, so nothing "
            "listed above is build output."
            % (listing, commit[:12]))

    if not args.dry_run:
        os.makedirs(out, exist_ok=True)

    # Kernel, apps and the core app archive, once for the whole
    # release. Nothing under sw/ varies by board now that net picks its
    # NIC driver at runtime, so building this per target would compile
    # the same sources four times and give four chances for two targets
    # to differ without anybody meaning them to.
    # Skipped when there is no target to build, which is the
    # --resume --rebuild-sdcard case: the kernel and the ZAR are
    # already in dist/ from the run that made them, and recompiling
    # them here would replace those assets with bytes from a different
    # commit while every image still carried the old ones.
    software = None
    if targets:
        first = spec.load_target(ROOT, targets[0])
        software = build_mod.build_software(
            ROOT, first.core_app_list(), dry=args.dry_run, jobs=args.jobs)

    results = []
    for name in targets:
        t = spec.load_target(ROOT, name)
        drift = spec.check_drift(ROOT, t)
        if drift and not args.allow_drift:
            die("%s: its board spec no longer matches rtl/boards.vh:\n\n  %s"
                "\n\n  A release would then build something other than what "
                "`make BOARD=%s flash` builds.\n  Reconcile them, or pass "
                "--allow-drift if the difference is deliberate."
                % (name, "\n  ".join(drift), t.board))

        results.append(build_mod.build_target(
            ROOT, t, version, out, software,
            dry=args.dry_run,
            allow_timing_fail=args.allow_timing_fail,
            strict_io_timing=args.strict_io_timing,
            keep_generated=args.keep_generated,
            jobs=args.jobs,
            full_image=args.full_image))

        # -- record it NOW, not after the loop -------------------------
        #
        # A target that finishes has its images in dist/ whatever
        # happens to the next one, and `ship` uploads what is in that
        # directory rather than what the manifest lists -- so those
        # files go out either way. What used to get lost was the RECORD
        # of them.
        #
        # The manifest was written once, after every target. A run that
        # stopped part way through -- a later target missing timing is
        # the ordinary way -- never wrote one, so the finished targets
        # existed on disk and nowhere else. Coming back to build the
        # failed one then merged into an empty manifest, and the notes,
        # README and MANIFEST.json described that one target while the
        # others sat in the directory undescribed.
        #
        # Writing after each target makes the manifest always describe
        # what is on disk. NOTES.md and README.txt are still generated
        # once at the end from the merged set, because they are the
        # whole-release view and there is no point rewriting them four
        # times.
        #
        # Interrupting a run is now free: everything that finished is
        # recorded, and the next `build` picks up from there.
        if not args.dry_run:
            _checkpoint(out, version, commit, dirty, prev_targets, results,
                        lay, _ark_commit(args.ark) or previous.get("ark_commit"))

    if args.dry_run:
        print("\n--dry-run: nothing was built.\n")
        return 0

    # -- board-independent artifacts -----------------------------------
    #
    # The kernel and the logo are the same bytes for every target, so
    # they ship once rather than four times. They are already inside
    # each flash image; these are for partial reflashes.
    #
    # Only when something was built. A card-only run
    # (--resume --rebuild-sdcard) leaves these alone deliberately: they
    # are already here from the run that made the images, and replacing
    # them with a fresh compile would publish a kernel that is not the
    # one inside any of them.
    if software:
        shutil.copy2(software["kernel"],
                     os.path.join(out, "zeitlos-kernel.bin"))
        shutil.copy2(software["zar"],
                     os.path.join(out, "zeitlos-apps.zar"))
        shutil.copy2(os.path.join(ROOT, "sw/data/images/zeitlos_fb.bin"),
                     os.path.join(out, "zeitlos-logo.bin"))

    # -- SD cards ------------------------------------------------------
    #
    # One image per variant (mkfatimg.VARIANTS): the same card with a
    # different amount of `ask` corpus on it. Each is kept or rebuilt
    # on its own.
    sdcards = _build_sdcards(args, out, previous)

    ark_commit = _ark_commit(args.ark) or previous.get("ark_commit")

    # -- manifest, notes, checksums ------------------------------------
    #
    # This run's targets replace same-named entries; everything else
    # built earlier under this version is carried forward, so the notes
    # and README.txt describe the whole release rather than the last
    # command that touched it.
    merged = dict(prev_targets)
    for r in results:
        r["commit"] = commit
        merged[r["target"]] = r
    all_targets = [merged[k] for k in sorted(merged)]

    man = notes_mod.manifest(version, commit, bool(dirty), all_targets,
                             sdcards, lay, ark_commit)
    notes_mod.write(os.path.join(out, "MANIFEST.json"), man)
    notes_mod.write(os.path.join(out, "NOTES.md"),
                    notes_mod.notes(version, commit, all_targets, sdcards,
                                    lay))
    notes_mod.write(os.path.join(out, "README.txt"),
                    notes_mod.asset_readme(version, commit, all_targets,
                                           sdcards, lay))

    _write_sums(out)

    print("\n=== %s ===" % version)
    print("  %d target(s): %s"
          % (len(all_targets), ", ".join(t["target"] for t in all_targets)))
    for f in sorted(os.listdir(out)):
        p = os.path.join(out, f)
        print("  %10d  %s" % (os.path.getsize(p), f))
    print("\nbuilt into %s" % os.path.relpath(out, ROOT))
    print("Flash one and try it, then:  release/zrelease ship %s\n" % version)
    return 0


def _checkpoint(out, version, commit, dirty, prev_targets, results,
                lay, ark_commit):
    """Write MANIFEST.json for everything finished so far.

    Called after each target rather than once at the end, so the
    manifest never describes less than what is in the directory. See
    its call site for why that matters.

    Deliberately NOT writing NOTES.md or README.txt: those describe the
    release as a whole and are regenerated from the merged set once the
    run is done. A checkpoint is a record, not a publication.

    The sdcard image is left out of the checkpoint manifest for the
    same reason -- it is built after the targets, so mid-run there is
    nothing true to say about it. The final write puts it in.
    """
    merged = dict(prev_targets)
    for r in results:
        r["commit"] = commit
        merged[r["target"]] = r
    man = notes_mod.manifest(version, commit, bool(dirty),
                             [merged[k] for k in sorted(merged)],
                             None, lay, ark_commit)
    notes_mod.write(os.path.join(out, "MANIFEST.json"), man)


def _load_manifest(out):
    path = os.path.join(out, "MANIFEST.json")
    if not os.path.exists(path):
        return {}
    try:
        with open(path) as f:
            return json.load(f)
    except (ValueError, OSError):
        return {}


def _ark_commit(ark_dir):
    d = ark_dir or os.path.join(ROOT, "sw/data/ark")
    r = subprocess.run(["git", "-C", d, "rev-parse", "HEAD"],
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def _write_sums(out):
    path = os.path.join(out, "SHA256SUMS")
    files = sorted(f for f in os.listdir(out)
                   if f not in ("SHA256SUMS", "NOTES.md"))
    with open(path, "w") as f:
        for name in files:
            f.write("%s  %s\n"
                    % (mkflashimg.sha256(os.path.join(out, name)), name))


# ---------------------------------------------------------------------

# GitHub refuses release assets over 2 GiB. Found at build time, not
# half way through `ship`.
ASSET_MAX_BYTES = 2 * 1024 * 1024 * 1024


def _previous_sdcards(previous):
    """This version's earlier card records, from either manifest shape:
    `sdcards` (a list, one per variant) or the older single `sdcard`."""
    if previous.get("sdcards"):
        return {c["file"]: c for c in previous["sdcards"]}
    if previous.get("sdcard"):
        c = previous["sdcard"]
        return {c["file"]: c}
    return {}


def _gzip(raw):
    gz = raw + ".gz"
    with open(raw, "rb") as f_in, gzip.open(gz, "wb", 9) as f_out:
        shutil.copyfileobj(f_in, f_out, 4 * 1024 * 1024)
    os.unlink(raw)
    return gz


def _build_sdcards(args, out, previous):
    """Build (or keep) every requested card variant. Returns the list
    of card records for the manifest."""
    if args.no_sdcard:
        return []
    spec = getattr(args, "sdcards", None) or \
        ",".join(v[0] for v in mkfatimg.VARIANTS)
    wanted = [k.strip() for k in spec.split(",") if k.strip()]
    for k in wanted:
        try:
            mkfatimg.variant(k)
        except mkfatimg.FatError as e:
            die(str(e))
    prev = _previous_sdcards(previous)
    cards = []
    print("\n=== SD card images ===")
    for key, stem, packs in mkfatimg.VARIANTS:
        if key not in wanted:
            continue
        gzname = stem + ".img.gz"
        gz_existing = os.path.join(out, gzname)

        # -- reuse an image that is already here --
        #
        # mkfs.fat stamps a fresh volume serial every time, so
        # rebuilding produces DIFFERENT BYTES from identical inputs. On
        # a run that only touched one target that would mean new
        # assets, new checksums, and `ship` re-uploading gigabytes for
        # no reason. Nothing on a card is board-specific, so an image
        # built earlier under this version is still correct -- unless
        # sw/ or docs/ changed, which is what --rebuild-sdcard is for.
        if (not args.rebuild_sdcard and os.path.exists(gz_existing)
                and gzname in prev):
            c = prev[gzname]
            print("    keeping %s (%d bytes) -- pass --rebuild-sdcard to "
                  "replace it" % (gzname, c["bytes"]))
            cards.append(c)
            continue

        print("  %s  (%s)" % (gzname, " + ".join(packs)))
        raw = os.path.join(out, stem + ".img")
        try:
            shipped = mkfatimg.build(ROOT, raw, ark_dir=args.ark,
                                     packs=packs)
        except mkfatimg.FatError as e:
            die("SD image %s: %s\n  To release without it: --sdcards %s"
                % (gzname, e, ",".join(k for k in wanted if k != key)
                   or "<none>"))
        image_bytes = os.path.getsize(raw)
        gz = _gzip(raw)
        gz_bytes = os.path.getsize(gz)
        if gz_bytes > ASSET_MAX_BYTES:
            die("%s is %.2f GB compressed; GitHub refuses release assets "
                "over 2 GiB. Ship fewer packs on it, or split the corpus."
                % (gzname, gz_bytes / 1e9))
        print("    %d entries, %.0f MB image, %.1f MB compressed"
              % (len(shipped), image_bytes / 1048576.0, gz_bytes / 1048576.0))
        cards.append({"file": gzname,
                      "variant": key,
                      "packs": list(packs),
                      "bytes": gz_bytes,
                      "image_bytes": image_bytes,
                      "needs_8gb": image_bytes > mkfatimg.CARD_4GB_BYTES,
                      "files": [n for n, _ in shipped]})
    return cards


def cmd_sdcard(args):
    """Just the card. No version, no dist directory, no gateware.

    `build` makes one too, but only as part of a release, which means a
    version number and every target's place-and-route first. Wanting a
    card off the current tree is a different and much more common job.
    """

    out = args.out
    if not os.path.isabs(out):
        out = os.path.join(ROOT, out)

    d = os.path.dirname(out)
    if d:
        os.makedirs(d, exist_ok=True)

    packs = None
    if args.variant:
        try:
            packs = mkfatimg.variant(args.variant)[2]
        except mkfatimg.FatError as e:
            die(str(e))
    try:
        shipped = mkfatimg.build(ROOT, out, ark_dir=args.ark, packs=packs)
    except mkfatimg.FatError as e:
        die("SD image: %s" % e)

    print("\n%s -- %d entries, %.1f MB"
          % (out, len(shipped), os.path.getsize(out) / 1024.0 / 1024.0))

    if args.gzip:
        gz = out + ".gz"
        with open(out, "rb") as f_in, gzip.open(gz, "wb", 9) as f_out:
            shutil.copyfileobj(f_in, f_out)
        print("%s -- %.1f MB" % (gz, os.path.getsize(gz) / 1024.0 / 1024.0))

    return 0


def cmd_verify(args):
    version = build_mod.normalise_version(args.version)
    out = distdir(version)
    if not os.path.isdir(out):
        die("nothing built for %s" % version)

    lay = layout_mod.load(ROOT)
    ok = True

    print("\nverifying %s\n" % os.path.relpath(out, ROOT))

    sums = os.path.join(out, "SHA256SUMS")
    if os.path.exists(sums):
        with open(sums) as f:
            for line in f:
                want, name = line.strip().split("  ", 1)
                p = os.path.join(out, name)
                if not os.path.exists(p):
                    print("  MISSING  %s" % name)
                    ok = False
                elif mkflashimg.sha256(p) != want:
                    print("  CHANGED  %s" % name)
                    ok = False
        print("  checksums checked")

    # Re-read every image and confirm the pieces really are where the
    # layout says. Cheap, and it catches an assembler bug or a truncated
    # write in a way that comparing a checksum against itself cannot.
    for f in sorted(os.listdir(out)):
        if not f.endswith("-flash.img"):
            continue
        with open(os.path.join(out, f), "rb") as fh:
            img = fh.read()
        L = {r.key: r for r in lay["regions"]}
        zoff = L["apps"].offset
        if len(img) <= zoff:
            print("  %s: shorter than the core app offset" % f)
            ok = False
            continue
        if img[zoff:zoff + 4] != b"ZAR1":
            print("  %s: no ZAR1 magic at 0x%06x -- the kernel will find "
                  "no core apps" % (f, zoff))
            ok = False
            continue
        loff = L["logo"].offset
        if img[loff:loff + 4] == b"\xff\xff\xff\xff":
            print("  %s: logo region is erased -- no boot splash" % f)
            ok = False
            continue
        koff = L["kernel"].offset
        if img[koff:koff + 4] == b"\xff\xff\xff\xff":
            print("  %s: kernel region is erased" % f)
            ok = False
            continue
        print("  %-52s ok  (%d bytes)" % (f, len(img)))

    print()
    if not ok:
        print("verification FAILED\n")
        return 1
    print("verification passed.\n")
    return 0


def cmd_ship(args):
    version = build_mod.normalise_version(args.version)
    try:
        ship_mod.ship(ROOT, version, distdir(version), dry=args.dry_run,
                      draft=args.draft, prerelease=args.prerelease,
                      notes_only=args.notes_only, title=args.title)
    except ship_mod.ShipError as e:
        die(str(e))
    return 0


# ---------------------------------------------------------------------

def main(argv):
    p = argparse.ArgumentParser(
        prog="zrelease", description="Zeitlos release builder")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", help="show buildable targets").set_defaults(
        func=cmd_list)
    sub.add_parser("layout", help="show the flash map").set_defaults(
        func=cmd_layout)
    sub.add_parser("check", help="check specs, layout and tools"
                   ).set_defaults(func=cmd_check)
    sub.add_parser("clean", help="remove generated files from the tree"
                   ).set_defaults(func=cmd_clean)

    b = sub.add_parser("build", help="build a release into dist/<version>")
    b.add_argument("version")
    b.add_argument("--targets", nargs="+",
                   help="build only these (default: all)")
    b.add_argument("--jobs", "-j", type=int)
    b.add_argument("--ark", help="ARK checkout (default sw/data/ark)")
    b.add_argument("--no-sdcard", action="store_true")
    b.add_argument("--sdcards",
                   default=",".join(v[0] for v in mkfatimg.VARIANTS),
                   help="card variants to build (default: all of %s). "
                        "arkmedium needs the arkmed pack built first."
                        % ", ".join(v[0] for v in mkfatimg.VARIANTS))
    b.add_argument("--rebuild-sdcard", action="store_true",
                   help="rebuild the sdcard image even if one is already "
                        "in dist/<version>/")
    b.add_argument("--resume", action="store_true",
                   help="skip targets already in dist/<version>/, so an "
                        "interrupted release finishes without redoing the "
                        "place-and-route for the ones that worked")
    b.add_argument("--allow-mixed-commits", action="store_true",
                   help="add targets to a release built from a different "
                        "commit")
    b.add_argument("--full-image", action="store_true",
                   help="pad flash images to the full 2MB")
    b.add_argument("--bump", action="store_true",
                   help="update sw/common/zversion.h to this version")
    b.add_argument("--allow-dirty", action="store_true")
    b.add_argument("--allow-drift", action="store_true")
    b.add_argument("--allow-timing-fail", action="store_true")
    b.add_argument("--strict-io-timing", action="store_true",
                   help="also fail on IO-primitive timing domains "
                        "(TRELLIS_IO_IN and friends), which are advisory "
                        "by default")
    b.add_argument("--keep-generated", action="store_true",
                   help="leave rtl/zspec.vh etc. in place for inspection")
    b.add_argument("--dry-run", action="store_true")
    b.set_defaults(func=cmd_build)

    # The SD card image on its own -- no gateware, no dist/<version>/,
    # no version at all. This is what tools/mkfatimg.sh calls, and what
    # anyone wanting a card without a two-hour place-and-route wants.
    sd = sub.add_parser("sdcard", help="build only the SD card image")
    sd.add_argument("--out", default="images/zeitlos.img",
                    help="where to write it (default images/zeitlos.img)")
    sd.add_argument("--gzip", action="store_true",
                    help="also write <out>.gz")
    sd.add_argument("--ark", help="ARK checkout (default sw/data/ark)")
    sd.add_argument("--variant",
                    choices=[v[0] for v in mkfatimg.VARIANTS],
                    help="one of a release's card variants (default: "
                         "zdocs + arklite, or $ZEITLOS_ASK_PACKS)")
    sd.set_defaults(func=cmd_sdcard)

    v = sub.add_parser("verify", help="re-check a built release")
    v.add_argument("version")
    v.set_defaults(func=cmd_verify)

    s = sub.add_parser("ship", help="create or update the GitHub release")
    s.add_argument("version")
    s.add_argument("--draft", action="store_true")
    s.add_argument("--prerelease", action="store_true")
    s.add_argument("--notes-only", action="store_true",
                   help="update the release text, upload nothing")
    s.add_argument("--title")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(func=cmd_ship)

    args = p.parse_args(argv)

    # Sweep first, always. A previous run that died hard leaves files in
    # the tree, and the most likely next command is the one that wants
    # them gone.
    if args.cmd != "clean":
        gen.sweep(ROOT, verbose=True)

    try:
        return args.func(args)
    except (spec.SpecError, layout_mod.LayoutError, build_mod.BuildError,
            mkflashimg.ImageError, RuntimeError) as e:
        die(str(e))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
