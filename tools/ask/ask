def _resolve(base, p):
    return p if os.path.isabs(p) else os.path.normpath(os.path.join(base, p))


def fetch_root(sp):
    """Where a pack's downloaded corpus lands.

    Under the cache, keyed by pack name, and deliberately NOT inside
    the ark checkout: lib/fetch.py manages that clone and may
    re-checkout a pinned ref, which would delete or conflict with
    anything written there. It is also not inside out/, which is the
    card tree byte for byte.
    """
    return os.path.join(fetch.cache_root(HERE), "dl",
                        sp.get("pack", sp.get("name", sp.name)))


def run_fetches(sp, repos, force=False):
    """Execute every `fetch =` in a recipe. Returns a provenance list."""
    root = fetch_root(sp)
    got = []
    for step in sp.fetches():
        dest = os.path.join(root, step["dest"])
        # "no" never unpacks, "yes" always does, "auto" (the default)
        # decides by looking at what actually arrived.
        #
        # This used to be `step["unpack"] != "no"`, which made "auto"
        # mean "always" -- so a 13.5MB plain text file went to
        # tarfile.open() and came back with "not a gzip file / not a
        # bzip2 file / not an lzma file / invalid header", which says
        # nothing about the real problem.
        mode = step["unpack"]
        unpack = (mode != "no")

        if step["lfs"]:
            # An LFS object inside one of the recipe's repos.
            reponame, _, rel = step["lfs"].partition("/")
            if reponame not in repos:
                raise SystemExit("fetch lfs=%s names no `repo = %s <url>`"
                                 % (step["lfs"], reponame))
            src = os.path.join(repos[reponame]["path"], rel)
            if fetch.is_lfs_pointer(src):
                fetch.lfs_pull(repos[reponame]["path"])
            try:
                fetch.check_lfs(src)
            except fetch.FetchError as e:
                raise SystemExit(str(e))
            if unpack:
                # Stamped by the source's size+mtime, so a re-run is
                # free but a repo that moved to a new ref re-unpacks.
                # Wikipedia is 137MB; doing it on every build would
                # add minutes to a command people run repeatedly.
                st = os.stat(src)
                tag = "%d:%d" % (st.st_size, int(st.st_mtime))
                stamp = os.path.join(dest, ".unpacked")
                if not (os.path.exists(stamp)
                        and open(stamp).read().strip() == tag):
                    fetch.unpack(src, dest, step["strip"])
                    os.makedirs(dest, exist_ok=True)
                    open(stamp, "w").write(tag + "\n")
                else:
                    print("  already unpacked %s" % step["dest"])
            else:
                os.makedirs(os.path.dirname(dest) or ".", exist_ok=True)
                shutil.copyfile(src, dest)
            got.append({"dest": step["dest"], "from": "lfs:" + step["lfs"]})
            continue

        # A plain URL. Archives are downloaded beside the cache and
        # expanded into dest; everything else lands at dest directly.
        urls = [step["url"]]
        if step["alt"]:
            urls.append(step["alt"])

        if unpack:
            arc = os.path.join(root, "_archives",
                               os.path.basename(urls[0].split("?")[0]))
            stamp = dest + "/.unpacked"
            used, fresh = None, False
            last = None
            for ui, u in enumerate(urls):
                try:
                    _p, fresh = fetch.download(u, arc, step["sha256"],
                                               force=force)
                    used = u
                    break
                except fetch.FetchError as e:
                    last = e
                    if ui + 1 < len(urls):
                        print("  %s did not work, trying the alternate" % u)
            if used is None:
                raise SystemExit("fetch failed: %s" % last)

            kind = fetch.sniff(arc)
            if mode == "auto" and kind in ("plain", "html"):
                if kind == "html":
                    raise SystemExit(
                        "fetch failed: %s returned an HTML page, not a "
                        "file.\n  Often a 404 served with a 200. Check the "
                        "URL." % used)
                # Not an archive after all. Place it as a plain file
                # rather than failing: `unpack=auto` is supposed to mean
                # "work it out", and a recipe that names a .txt should
                # not have to also say unpack=no.
                target = dest
                if not os.path.splitext(os.path.basename(dest))[1]:
                    target = os.path.join(
                        dest, os.path.basename(urls[0].split("?")[0]))
                os.makedirs(os.path.dirname(target) or ".", exist_ok=True)
                shutil.copyfile(arc, target)
                print("  %s is not an archive; placed at %s"
                      % (os.path.basename(arc),
                         os.path.relpath(target, root)))
            elif fresh or not os.path.exists(stamp):
                try:
                    fetch.unpack(arc, dest, step["strip"])
                except fetch.FetchError as e:
                    raise SystemExit("fetch failed: %s" % e)
                open(stamp, "w").write(used + "\n")
            else:
                print("  already unpacked %s" % step["dest"])
            got.append({"dest": step["dest"], "from": used})
        else:
            used, last = None, None
            for ui, u in enumerate(urls):
                try:
                    fetch.download(u, dest, step["sha256"], force=force)
                    used = u
                    break
                except fetch.FetchError as e:
                    last = e
                    if ui + 1 < len(urls):
                        print("  %s did not work, trying the alternate" % u)
            if used is None:
                raise SystemExit("fetch failed: %s" % last)
            # A dead URL can answer 200 with an error page. Catching it
            # here means the failure names the URL, instead of turning
            # up later as an adapter that loaded zero documents.
            if fetch.sniff(dest) == "html":
                os.remove(dest)
                raise SystemExit(
                    "fetch failed: %s returned an HTML page, not a file.\n"
                    "  Often a 404 served with a 200. Check the URL." % used)
            got.append({"dest": step["dest"], "from": used})
    return got


def load_recipe(path, update=False):
    sp = spec.Spec(path)
    base = os.path.dirname(os.path.abspath(path))

    # Repositories the recipe names get cloned on demand. No
    # submodules: the corpora are large, they move on their own
    # schedule, and most people building Zeitlos never build a
    # distribution at all.
    repos = sp.repos()
    root = fetch.cache_root(HERE)
    for name, r in repos.items():
        r["path"], r["commit"] = fetch.ensure(
            name, r["url"], r["ref"], root=root, update=update)

    # `@dl/...` resolves inside this pack's downloaded tree, which is
    # populated by `ask fetch` and is not a git checkout.
    repos_and_dl = dict(repos)
    repos_and_dl["dl"] = {"path": fetch_root(sp)}

    docs = []
    used = []
    for adapter, loc, opts in sp.sources():
        full = fetch.resolve(loc, repos_and_dl, base)
        if not os.path.exists(full):
            hint = ("  A `@name/...` location resolves inside the repo "
                    "named by a `repo = name <url>` line; anything else "
                    "resolves against the recipe file.")
            # The common case by far, once a recipe reaches Ark Medium:
            # the payloads are fetched by ark's own build, not by a
            # clone. Say so instead of leaving somebody to work it out.
            if loc.startswith("@dl/"):
                hint = ("  This source comes from a `fetch =` line and has "
                        "not been downloaded yet:\n\n"
                        "      ./tools/ask/ask fetch %s\n\n"
                        "  then build again." % path)
            raise SystemExit(
                "source `%s` points at %s, which does not exist.\n%s"
                % (adapter, full, hint))
        try:
            got = source.load(adapter, full, opts)
        except ValueError as e:
            # An adapter's complaint is a recipe problem, not a bug.
            raise SystemExit("source `%s` (%s):\n  %s" % (adapter, loc, e))
        docs.extend(got)
        used.append({"adapter": adapter, "path": loc, "opts": opts,
                     "docs": len(got),
                     "bytes": sum(len(d.text) for d in got)})
    # Sorted by (source, key) everywhere, so the build is deterministic
    # regardless of the order sources were listed or a directory walk
    # happened to return.
    docs.sort(key=lambda d: (d.source, d.key))
    return sp, docs, used, repos


def build_hash(sp, docs):
    """Identity of this distribution's CONTENT.

    Over the recipe and every document's normalised bytes -- not over
    the output files, and not over the clock. Two builds of the same
    corpus are the same distribution even if they happened a year
    apart, and a single changed article makes a different one.
    """
    h = hashlib.sha256()
    h.update(open(sp.path, "rb").read())
    for d in docs:
        h.update(d.source.encode()); h.update(b"\0")
        h.update(d.key.encode()); h.update(b"\0")
        h.update(d.text.encode("utf-8"))
    return h.hexdigest()


def chunk_and_index(docs, sp):
    target = sp.getint("chunk_chars", segment.TARGET_CHARS)
    chunks = segment.segment_all(docs, target=target)
    texts = [c.embed_text(docs[c.doc].title) for c in chunks]
    return chunks, texts


def pairs_file(sp):
    """Where `pairs = import` reads questions from.

    Defaults to the path `ask genq` writes, so a recipe does not have
    to carry an absolute path that is correct on exactly one machine.
    An explicit `pairs_file =` still wins.
    """
    explicit = sp.get("pairs_file")
    if explicit:
        return explicit if os.path.isabs(explicit) else _resolve(HERE, explicit)
    return os.path.join(fetch.cache_root(HERE), "questions",
                        "%s.jsonl" % sp.get("pack", sp.get("name", sp.name)))


def hint_unused_questions(sp):
    """Say so when generated questions exist but are not being used.

    Generating them takes hours; the recipe edit that puts them to work
    is three lines, and the only sign it was missed is the word `bow`
    in a header line nobody reads. This is exactly the failure that
    makes someone conclude training does not help.
    """
    path = pairs_file(sp)
    if not os.path.exists(path):
        return
    uses_import = "import" in sp.get("pairs", "")
    trained = sp.get("encoder", "bow") == "trained"
    if uses_import and trained:
        return

    n = 0
    for line in open(path, encoding="utf-8"):
        if '"q"' in line:
            n += 1
    print()
    print("  *** %d generated questions exist and are NOT being used ***"
          % n)
    print("      %s" % path)
    print()
    if not trained:
        print("      This recipe has `encoder = %s`; training applies to"
              % sp.get("encoder", "bow"))
        print("      `encoder = trained`.")
    print("      Add to %s:" % sp.path)
    print()
    print("          encoder = trained")
    print("          pairs   = ict,title,import")
    print()
    print("      (pairs_file defaults to the path above; set it only to")
    print("       point somewhere else.)")
    print()
    print("      then:  ./tools/ask/ask train %s" % sp.path)


def enc_cache_path(sp):
    return os.path.join(fetch.cache_root(HERE), "enc",
                        "%s.npz" % sp.get("pack", sp.get("name", sp.name)))


def make_encoder(sp, texts, docs=None, chunks=None, lx=None):
    name = sp.get("encoder", "bow")
    dim = sp.getint("fine_dim", 128)
    vocab = sp.getint("vocab", 4096)
    if name not in embed.BACKENDS:
        raise SystemExit("unknown encoder `%s` (have: %s)"
                         % (name, ", ".join(sorted(embed.BACKENDS))))
    enc = embed.BACKENDS[name](dim=dim, vocab=vocab)

    if name == "trained":
        # Trained weights are CACHED, not retrained on every command.
        # A build, an eval and a query must all use the same encoder or
        # they are measuring different systems, and retraining inside
        # each would be both slow and non-deterministic across them.
        cache = enc_cache_path(sp)
        if os.path.exists(cache):
            enc.load_cache(cache)
            return enc
        if docs is None:
            # eval/query call this without the extras; fall back to the
            # untrained init rather than silently measuring something
            # other than what `ask build` writes.
            raise SystemExit(
                "no trained encoder yet.\n\n"
                "      ./tools/ask/ask train <recipe>\n\n"
                "  Training is a separate step on purpose: it is cached, "
                "so a build, an\n  eval and a query all use the SAME "
                "weights. Retraining inside each\n  would be slow and "
                "would make them measure different systems.\n\n"
                "  Set `encoder = bow` in the recipe for a build with no "
                "training step.")
        opts = {k[6:]: v for k, v in sp.values.items()
                if k.startswith("train_")}
        opts.update({"pairs": sp.get("pairs", "ict,title"),
                     "pairs_file": pairs_file(sp)})
        enc.fit_trained(docs, chunks, texts, lx, opts)
    else:
        enc.fit(texts)
    return enc


