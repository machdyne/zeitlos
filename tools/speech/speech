def cmd_compare(args):
    """
    Scores several versions of the voice on the same frozen material, paired,
    with 95% intervals on every difference. `--ablation` builds session 0's
    variants: the shipped voice with no pack, then each fitted stage added in
    turn. See lib/compare.py.
    """
    from lib import compare as cmp, ledger as ledgerlib
    material, lex, rec, renderer, out, repo, led = _eval_setup(args)
    code = ledgerlib.code_hash(repo)
    variants, notes = [], []
    against = "previous"
    built = os.path.join(HERE, "build", "en", "speech.zspk")
    if args.ablation:
        v, notes = cmp.ablation_variants(built, os.path.join(HERE, "build", "align"),
                                         os.path.join(HERE, "build", "compare"))
        variants += [(n, p, {}, w) for n, p, w in v]
    if getattr(args, "diphone", False):
        inv = os.path.join(HERE, "build", "diphone")
        if not os.path.exists(os.path.join(inv, "units.json")):
            sys.exit("speech: no diphone inventory -- run `speech diphones` first")
        root = fetchlib.cache_root(HERE)
        variants += cmp.diphone_variants(built, inv, os.path.join(HERE, "build", "compare"),
                                         os.path.join(HERE, "build", "align", "rec"),
                                         args.corpus or os.path.join(root, "ljspeech"))
        against = "first"
    if args.session1:
        if not os.path.exists(built):
            sys.exit("speech: no pack at %s -- run `speech build` first" % built)
        variants += cmp.session1_variants(built, os.path.join(HERE, "build", "compare"))
        against = "first"
    for spec in args.packs or []:
        name, _, path = spec.partition("=")
        variants.append((name, path if path != "none" else "", {}, ""))
    if not variants:
        sys.exit("speech: nothing to compare -- --ablation, or --pack NAME=PATH ...")
    for n in notes:
        print("  note: " + n)

    items = score.items_of(material, "all")
    print("== scoring %d variants, %d items each" % (len(variants), len(items)))
    results = []
    for name, path, env, what in variants:
        per = cmp.measure(name, path, env, items, "all", material, rec, lex, renderer,
                          led, code, os.path.join(out, "compare"))
        results.append((name, per, what))
    anchor = cmp.measure_recordings(material, rec, lex, led)

    lines = ["compared on material %s (%s), %s, code %s" % (
        material["version"], material["hash"], rec.label, code), ""]
    lines += cmp.table(results, anchor, against)
    lines += [""] + cmp.target_table(results, lex)
    conf = score.confusions(results[-1][1], lex)
    if conf:
        lines += ["", "sounds most often heard as another, in %s:" % results[-1][0],
                  "  " + ", ".join("%s->%s x%d" % (a, b, n) for (a, b), n in conf[:14])]
    lines += ["", "what each variant adds:"]
    lines += ["  %-26s %s" % (n, w) for n, _, w in results if w]
    report = os.path.join(HERE, "build", "compare",
                          "diphone.txt" if getattr(args, "diphone", False) else
                          "session1b.txt" if args.session1 else "compare.txt")
    os.makedirs(os.path.dirname(report), exist_ok=True)
    with open(report, "w") as f:
        f.write("\n".join(lines) + "\n")
    print()
    print("\n".join(lines))
    print("\n  %s  <- paste this back" % report)


