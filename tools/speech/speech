def cmd_tune(args):
    """
    Tunes the voice against the recogniser, unattended and resumable:
    coordinate search on the dev material, verdict on the held-out test
    material. See lib/tune.py.
    """
    from lib import ledger as ledgerlib
    pk = args.pack or os.path.join(HERE, "build", "en", "speech.zspk")
    if not os.path.exists(pk):
        sys.exit("speech: no pack at %s -- run `speech build` first" % pk)
    material, lex, rec, renderer, out, repo, led = _eval_setup(args)
    tdir = os.path.join(HERE, "build", "tune")
    print("== tuning, at most %d evaluations (log: %s)" % (args.budget, os.path.join(tdir, "log.jsonl")))
    res = tune.run(renderer, pk, material, rec, lex, prosody.table_durations(repo),
                   tdir, budget=args.budget, tag=(ledgerlib.code_hash(repo),
                   ledgerlib.file_hash(pk), material["hash"], rec.label))
    lines = ["tuned against %s, %d evaluations (%d resumed from the log)" % (
        rec.label, res["evals"], res["resumed"]), ""]
    from lib import compare as cmp
    lines += cmp.table([("before", res["test_start"], ""), ("after", res["test_best"], "")], None)
    lines.append("")
    lines.append("changed:")
    for k in sorted(res["best"]):
        if res["best"][k] != res["start"][k]:
            lines.append("  %-11s %4d -> %4d" % (k, res["start"][k], res["best"][k]))
    d = score.paired_ci(res["test_start"], res["test_best"], "sus")
    w = score.paired_ci(res["test_start"], res["test_best"], "word")
    # Both metrics are words correctly identified: up is better.
    better = (d and d[1] > 0) or (w and w[1] > 0)
    worse = (d and d[2] < 0) or (w and w[2] < 0)
    lines.append("")
    if better and not worse:
        lines.append("VERDICT: better on the held-out material, beyond noise.")
        lines.append("tuned pack: %s" % res["pack"])
    else:
        lines.append("VERDICT: no difference beyond noise on the held-out material -- keep")
        lines.append("the pack you have. (The search only keeps what helps on dev; if it")
        lines.append("does not carry over, it fitted the dev sentences, not the voice.)")
    with open(os.path.join(tdir, "tune.txt"), "w") as f:
        f.write("\n".join(lines) + "\n")
    print("\n".join(lines))
    print("\n  %s  <- paste this back" % os.path.join(tdir, "tune.txt"))


