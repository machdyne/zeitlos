def _listen_echo(args):
    """
    A few ordinary sentences, each rendered several ways, to hear where an
    echo comes from: the recording itself, units with the recording's own
    timing and pitch (copy synthesis), units keeping their own pitch, and
    the device's C engine. build/listen/echo/<clip>-N-<how>.wav
    """
    import json, shutil
    from lib import audio, compare as cmp, ledger as ledgerlib
    root = fetchlib.cache_root(HERE)
    repo = os.path.abspath(os.path.join(HERE, "..", ".."))
    cdir = args.corpus or os.path.join(root, "ljspeech")
    rec = os.path.join(HERE, "build", "align", "rec")
    inv = os.path.join(HERE, "build", "diphone")
    mpath = os.path.join(HERE, "build", "eval", "material-%s.json" % evalset.VERSION)
    if not os.path.exists(mpath):
        sys.exit("speech: no frozen material yet -- run `speech compare` once first")
    ords = [o for o in json.load(open(mpath))["ordinary"]
            if os.path.exists(os.path.join(rec, o["id"] + ".phones"))][:4]
    if not ords:
        sys.exit("speech: none of the ordinary sentences has an alignment")
    out = os.path.join(HERE, "build", "listen", "echo")
    shutil.rmtree(out, ignore_errors=True)
    os.makedirs(out)
    built = os.path.join(HERE, "build", "en", "speech.zspk")
    variants = {n: (p, e) for n, p, e, _ in cmp.diphone_variants(
        built, inv, os.path.join(HERE, "build", "compare"), rec, cdir)}
    base_pack, _ = variants["formant, male (shipped)"]
    dev_pack, dev_env = variants["diphone, C engine (device)"]
    py = {"DIPHONE": inv, "ZTTS_VOICE": "female"}
    ways = [("2-copy", base_pack, dict(py, DIPHONE_MODE="copy", DIPHONE_ALIGN=rec, DIPHONE_CORPUS=cdir)),
            ("3-ownpitch", base_pack, dict(py, DIPHONE_MODE="own-pitch")),
            ("4-device", dev_pack, dev_env)]
    renderer = corpus.build_renderer(repo, os.path.join(HERE, "build", "score", "tts_wav"))
    items = [("ord", o["text"], o["id"]) for o in ords]
    for o in ords:
        x = audio.read_wav(os.path.join(cdir, "wavs", o["id"] + ".wav"))
        audio.write_wav(os.path.join(out, "%s-1-original.wav" % o["id"]), x)
    for how, pk, env in ways:
        d = os.path.join(out, "_" + how)
        wavs = score.render(renderer, items, d, pk, env)
        for w, o in zip(wavs, ords):
            os.replace(w, os.path.join(out, "%s-%s.wav" % (o["id"], how)))
        shutil.rmtree(d, ignore_errors=True)
    print("  %d sentences, 4 ways each, in %s" % (len(ords), out))
    print("  1-original   the recording itself")
    print("  2-copy       units, with the recording's own timing and pitch")
    print("  3-ownpitch   units, our timing, each keeping its recorded pitch")
    print("  4-device     the C engine, as the board speaks")
    print("  where the echo first appears says where it comes from")


def cmd_listen(args):
    if getattr(args, "echo", False):
        return _listen_echo(args)
    """
    The listening set (sw/apps/tts/tests/testset.txt) in the formant voice
    and in the diphone voice, side by side, for ears rather than a
    recogniser: build/listen/formant and build/listen/diphone.
    """
    from lib import compare as cmp
    repo = os.path.abspath(os.path.join(HERE, "..", ".."))
    built = os.path.join(HERE, "build", "en", "speech.zspk")
    inv = os.path.join(HERE, "build", "diphone")
    if not os.path.exists(os.path.join(inv, "units.json")):
        sys.exit("speech: no diphone inventory -- run `speech diphones` first")
    names, items = [], []
    for line in open(os.path.join(repo, "sw", "apps", "tts", "tests", "testset.txt")):
        parts = line.rstrip("\n").split("|")
        if len(parts) >= 2 and parts[0].startswith("t_"):
            names.append(parts[0][2:])
            items.append(("ord", parts[1], None))
    renderer = corpus.build_renderer(repo, os.path.join(HERE, "build", "score", "tts_wav"))
    variants = cmp.diphone_variants(built, inv, os.path.join(HERE, "build", "compare"))
    wanted = {"formant, male (shipped)": "formant", "diphone, C engine (device)": "diphone"}
    for name, pack_path, env, _ in variants:
        if name not in wanted:
            continue
        d = os.path.join(HERE, "build", "listen", wanted[name])
        import shutil
        shutil.rmtree(d, ignore_errors=True)
        wavs = score.render(renderer, items, d, pack_path, env)
        for w, n in zip(wavs, names):
            os.replace(w, os.path.join(d, n + ".wav"))
        for f in os.listdir(d):
            if not f.endswith(".wav"):
                os.remove(os.path.join(d, f))
        print("  %-8s %d sentences in %s" % (wanted[name], len(wavs), d))


def main():

