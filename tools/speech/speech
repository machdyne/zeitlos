def cmd_acoustics(args):
    """
    Measures each vowel's formants in the aligned corpus and fits them
    to this voice. Run `speech align` and `speech prosody` first (the
    calibration renders are shared); then `speech build`. See
    lib/acoustics.py and docs/tts_data.md, "Acoustics".
    """

    root = fetchlib.cache_root(HERE)
    cdir = args.corpus or os.path.join(root, "ljspeech")
    out = os.path.join(HERE, "build", "align")
    rec, cal = os.path.join(out, "rec"), os.path.join(out, "calib")
    if not os.path.isdir(rec) or not os.path.isdir(cal):
        sys.exit("speech: run `speech align` and `speech prosody` first")

    repo = os.path.abspath(os.path.join(HERE, "..", ".."))
    clips = corpus.read_metadata(cdir, args.limit)
    print("== measuring formants in %d clips" % len(clips))
    sp = acoustics.measure(clips, rec)
    table = acoustics.table_formants(repo)

    # Two passes. LPC's error depends on pitch -- a high voice's sparse
    # harmonics pull F1 toward them -- so our own voice has to be
    # measured at the speaker's pitch, and at her tract size, for the
    # errors to cancel. The first pass estimates the tract size against
    # the calibration `prosody` already rendered; the second renders
    # our voice again, matched, and fits against that.
    print("  first pass: tract size")
    us0 = acoustics.measure(clips, cal, prefix="t_")
    _, tract0, _ = acoustics.fit(sp, us0, table)
    import numpy as np
    from lib import audio
    f0 = []
    for cid, _, wav in clips[:300]:
        p_ = audio.pitch(audio.read_wav(wav))
        f0.extend(p_[p_ > 0].tolist())
    hz = float(np.median(f0)) if f0 else 110.0
    fpct = max(85, min(120, int(round(tract0 * 100))))
    print("  the speaker: about %.0fHz, formants %d%% of ours; rendering our voice to match"
          % (hz, fpct))
    pitch = max(50, min(300, hz))
    renderer = corpus.build_renderer(repo, os.path.join(out, "tts_wav"))
    base_pack = pack_path_for(HERE)
    order = ["MANIFEST", "PHONES", "LTS", "PROSODY", "FORMANTS", "LEXIDX", "LEXDAT"]

    def pack_with(path, formants_blob):
        secs = pack.read(base_pack) if base_pack else {}
        if not secs:
            return ""
        secs["FORMANTS"] = formants_blob
        pack.write(path, [(k, secs[k]) for k in order if k in secs])
        return path

    # Vowels, against our voice at her pitch and tract with the table's
    # own vowels (no FORMANTS: a pack already fitted must not be
    # calibrated against itself).
    cal2 = os.path.join(out, "calib_voice")
    corpus.render_references(renderer, clips, cal2,
                             pack_with(os.path.join(out, "plain.zspk"), acoustics.serialise({})),
                             wpm=180, pitch=pitch, formants=fpct)
    print("  second pass: vowels")
    us = acoustics.measure(clips, cal2, prefix="t_")
    fitted, tract, notes = acoustics.fit(sp, us, table, tract_done=fpct / 100.0)

    # Consonant loci by analysis-by-synthesis, and with the speaker's
    # fitted vowels in place on our side too: a locus equation depends
    # on which vowels follow the consonant, and comparing against the
    # table's vowels mixed her accent into the consonants.
    print("  consonant loci: our voice with her vowels, then with its loci moved")
    ltab = acoustics.table_loci(repo)
    vblob = acoustics.serialise(fitted)
    cal2b = os.path.join(out, "calib_vowels")
    corpus.render_references(renderer, clips, cal2b,
                             pack_with(os.path.join(out, "vowels.zspk"), vblob),
                             wpm=180, pitch=pitch, formants=fpct)
    cal3 = os.path.join(out, "calib_loci")
    corpus.render_references(renderer, clips, cal3,
                             pack_with(os.path.join(out, "loci_shift.zspk"),
                                       acoustics.shifted_loci(ltab, vowels=fitted)),
                             wpm=180, pitch=pitch, formants=fpct)
    import json
    json.dump({"pitch": pitch, "formants": fpct,
               "pack": os.path.join(out, "vowels.zspk")},
              open(os.path.join(out, "voice_match.json"), "w"))
    lus = acoustics.measure(clips, cal2b, prefix="t_").loci
    lsh = acoustics.measure(clips, cal3, prefix="t_").loci
    loci, lnotes = acoustics.fit_loci(sp.loci, lus, lsh, ltab, tract / (fpct / 100.0))
    fitted.update(loci)
    notes += lnotes

    lines = ["formants fitted to %d clips" % sp.clips, "",
             "%-3s  %-20s %-20s" % ("", "table F1 F2 F3", "fitted")]
    for ph in acoustics.MEASURE:
        if ph not in fitted:
            continue
        t, f = table[ph], fitted[ph]
        for part in ((0, 1) if ph in acoustics.DIPHTHONGS else (0,)):
            tv = t[3 * part:3 * part + 3]
            fv = [f[k] or t[k] for k in range(3 * part, 3 * part + 3)]
            lines.append("%-3s%s %4d %4d %4d   ->   %4d %4d %4d" % (
                ph, "'" if part else " ", tv[0], tv[1], tv[2], fv[0], fv[1], fv[2]))
    if loci:
        lines.append("")
        lines.append("consonant loci  table F2 F3  ->  fitted")
        for c in acoustics.LOCI:
            if c in loci:
                t, f = ltab[c], loci[c]
                lines.append("%-3s            %4d %4d   ->   %4d %4d" % (
                    c, t[1], t[2], f[1] or t[1], f[2] or t[2]))
    lines.append("")
    lines.extend("note: " + n for n in notes)

    with open(os.path.join(out, "formants.txt"), "w") as f:
        f.write("\n".join(lines) + "\n")
    with open(os.path.join(out, "formants.bin"), "wb") as f:
        f.write(acoustics.serialise(fitted))

    print("\n".join(lines))
    print("\n  %s  <- paste this back" % os.path.join(out, "formants.txt"))
    print("  `speech build` will now put these in the pack")


def cmd_source(args):
    """
    Fits the voice source's quality -- open quotient and spectral tilt --
    to the speaker. Run after `speech acoustics`, whose matched voice it
    reuses; then `speech build`. See lib/source.py.
    """

    import json

    root = fetchlib.cache_root(HERE)
    cdir = args.corpus or os.path.join(root, "ljspeech")
    out = os.path.join(HERE, "build", "align")
    rec = os.path.join(out, "rec")
    match = os.path.join(out, "voice_match.json")
    if not os.path.exists(match):
        sys.exit("speech: run `speech acoustics` first (it measures the speaker's voice)")
    m = json.load(open(match))

    repo = os.path.abspath(os.path.join(HERE, "..", ".."))
    clips = corpus.read_metadata(cdir, args.limit or 600)
    print("== the voice source, from %d clips" % len(clips))
    sp, n = source.measure(clips, rec)
    if sp is None:
        sys.exit("speech: no vowels measured")
    print("  the speaker: H1-H2 %.1fdB, H1-A3 %.1fdB (%d vowels)" % (sp[0], sp[1], n))

    renderer = corpus.build_renderer(repo, os.path.join(out, "tts_wav"))
    grid = []
    for oq, tilt in source.GRID:
        d = os.path.join(out, "source_%d_%d" % (oq, tilt))
        os.environ["ZTTS_OPEN"], os.environ["ZTTS_TILT"] = str(oq), str(tilt)
        try:
            corpus.render_references(renderer, clips, d, m["pack"], wpm=180,
                                     pitch=m["pitch"], formants=m["formants"])
        finally:
            os.environ.pop("ZTTS_OPEN", None)
            os.environ.pop("ZTTS_TILT", None)
        v, _ = source.measure(clips, d, prefix="t_")
        grid.append(((oq, tilt), v))
        print("  our voice at open %d%%, tilt %ddB: H1-H2 %.1f, H1-A3 %.1f" % (oq, tilt, v[0], v[1]))

    res = source.fit(sp, grid)
    if res is None:
        sys.exit("speech: the grid did not determine a fit")
    (oq, tilt), notes = res
    lines = ["voice source fitted to %d vowels" % n, "",
             "open quotient  50%% -> %d%%" % oq,
             "spectral tilt   0dB -> %ddB at 3kHz" % tilt, ""]
    lines += ["note: " + x for x in notes]
    with open(os.path.join(out, "source.txt"), "w") as f:
        f.write("\n".join(lines) + "\n")
    json.dump({"open": oq, "tilt": tilt}, open(os.path.join(out, "source.json"), "w"))
    print("\n".join(lines))
    print("  %s  <- paste this back" % os.path.join(out, "source.txt"))


