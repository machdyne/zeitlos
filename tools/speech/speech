    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("sources", help="list a spec's inputs and licences")
    p.add_argument("spec", nargs="?", default="dist/en.spec")
    p.set_defaults(func=cmd_sources)

    p = sub.add_parser("fetch", help="download the inputs")
    p.add_argument("spec", nargs="?", default="dist/en.spec")
    p.add_argument("--mirror", action="store_true", help="use each source's mirror")
    p.add_argument("--only", action="append", help="fetch just this source (repeatable)")
    p.add_argument("--limit", type=int, default=0,
                   help="for corpora: extract at most this many clips")
    p.set_defaults(func=cmd_fetch)

    p = sub.add_parser("build", help="build a pack from what was fetched")
    p.add_argument("spec", nargs="?", default="dist/en.spec")
    p.add_argument("--out", help="output directory (default build/<name>)")
    p.add_argument("--fitted", action="store_true",
                   help="include the fitted prosody, formants and voice source")
    p.add_argument("--no-diphones", action="store_true",
                   help="leave out the recorded voice even if an inventory exists")
    p.set_defaults(func=cmd_build)

    p = sub.add_parser("mirror", help="prepare a source for publishing")
    p.add_argument("source", help="which source (e.g. ljspeech)")
    p.add_argument("spec", nargs="?", default="dist/en.spec")
    p.add_argument("--clips", type=int, default=0,
                   help="cut down to this many clips first (0 = all)")
    p.add_argument("--piece-mb", type=float, default=1800,
                   help="piece size in MB; GitHub caps an asset at 2GB")
    p.add_argument("--repo", default="machdyne/speech-data",
                   help="where it will be published, for the printed commands")
    p.add_argument("--out", help="output directory (default mirror/<source>)")
    p.set_defaults(func=cmd_mirror)

    p = sub.add_parser("align", help="place every phone of a speech corpus in time")
    p.add_argument("--corpus", help="directory with metadata.csv and wavs/ "
                   "(default: the fetched ljspeech)")
    p.add_argument("--limit", type=int, default=0, help="at most this many clips")
    p.add_argument("--jobs", type=int, default=0, help="processes (default: cores - 1)")
    p.set_defaults(func=cmd_align)

    p = sub.add_parser("prosody", help="fit timing and pitch to an aligned corpus")
    p.add_argument("--corpus", help="as for align")
    p.add_argument("--limit", type=int, default=0)
    p.set_defaults(func=cmd_prosody)

    p = sub.add_parser("acoustics", help="fit vowel formants to an aligned corpus")
    p.add_argument("--corpus", help="as for align")
    p.add_argument("--limit", type=int, default=0)
    p.add_argument("--calib", type=int, default=0, help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_acoustics)

    p = sub.add_parser("source", help="fit the voice source to the speaker")
    p.add_argument("--corpus", help="as for align")
    p.add_argument("--limit", type=int, default=0)
    p.set_defaults(func=cmd_source)

    for name, fn, help_ in (("score", cmd_score, "score one pack's intelligibility by machine"),
                            ("compare", cmd_compare, "score several versions, paired, with intervals"),
                            ("tune", cmd_tune, "tune the voice against a recogniser, unattended")):
        p = sub.add_parser(name, help=help_)
        p.add_argument("--asr", default="whisper", help="whisper (GPU) or sphinx (CPU)")
        p.add_argument("--model", default=None, help="whisper model (default medium.en)")
        p.add_argument("--device", default=None, help="cuda (default) or cpu")
        p.add_argument("--corpus", help="for word frequencies and ordinary sentences "
                       "(default: the fetched ljspeech)")
        if name == "compare":
            p.add_argument("--ablation", action="store_true",
                           help="the shipped voice, then each fitted stage in turn")
            p.add_argument("--session1", action="store_true",
                           help="the default pack, then each synthesiser experiment")
            p.add_argument("--session1b", dest="session1", action="store_true",
                           help="the same: session 1b's experiments")
            p.add_argument("--diphone", action="store_true",
                           help="the diphone prototype against the formant voices")
            p.add_argument("--pack", dest="packs", action="append",
                           help="NAME=PATH, repeatable; PATH none for no pack")
        else:
            p.add_argument("--pack", help="default: build/en/speech.zspk")
        if name == "tune":
            p.add_argument("--budget", type=int, default=150, help="evaluations")
        p.set_defaults(func=fn)

    p = sub.add_parser("diphones", help="build the recorded voice's inventory")
    p.add_argument("--corpus", help="as for align")
    p.add_argument("--limit", type=int, default=0)
    p.set_defaults(func=cmd_diphones)

    p = sub.add_parser("listen", help="the listening set in both voices, side by side")
    p.add_argument("--echo", action="store_true",
                   help="a few sentences four ways, to hear where an echo comes from")
    p.add_argument("--corpus", help="as for align")
    p.set_defaults(func=cmd_listen)

    p = sub.add_parser("show", help="what is in a pack")
    p.add_argument("file")
    p.set_defaults(func=cmd_show)


    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
