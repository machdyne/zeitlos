                                          ", built now and frozen" if fresh else ""))
    print("  %d + %d unpredictable sentences, %d + %d words (dev + held-out test), "
          "%d ordinary sentences" % (len(material["dev"]["sus"]), len(material["test"]["sus"]),
                                      len(material["dev"]["words"]), len(material["test"]["words"]),
