from lib.spec import Spec, SpecError

# The phoneme set, in the order sw/apps/tts/phon.c declares it. The
# names go in the pack (PHONES) so the ids in it mean something on the
# other side; a pack naming a phoneme the reader lacks is refused
# there rather than mispronounced.
PHONES = ("IY IH EH AE AA AO UH UW AH ER AX IX EY OW AY AW OY "
          "W Y R L M N NG S Z SH ZH F V TH DH HH P B T D K G CH JH").split()


def load(path):
    if not os.path.isabs(path):
        cand = os.path.join(HERE, path)
        if os.path.exists(cand):
            path = cand
    if not os.path.exists(path):
        sys.exit("speech: no such spec: %s" % path)
    try:
        return Spec(path)
    except SpecError as e:
        sys.exit("speech: %s" % e)


def cmd_sources(args):
    spec = load(args.spec)
    print("%s: %s" % (spec.settings.get("name", "?"),
                      spec.settings.get("description", "")))
    for s in spec.sources:
        print("\n%s (%s)" % (s.name, s.kind))
        print("  licence: %s" % s.licence)
        print("  url:     %s" % (s.url or "(%d Project Gutenberg texts)" % len(s.ids)))
        if s.mirror_kind:
            print("  (the mirror is a %s)" % s.mirror_kind)
        if s.mirror:
            print("  mirror:  %s" % s.mirror)
        for member, saved in s.takes:
            print("  take:    %s -> %s" % (member, saved))
        for bad in s.refuses:
            print("  REFUSE:  %s" % bad)
        if s.note:
            print("  note:    %s" % s.note)


def cmd_fetch(args):

    spec = load(args.spec)
    root = fetchlib.cache_root(HERE)
    os.makedirs(root, exist_ok=True)
    problems = 0

    for s in spec.sources:

        if args.only and s.name not in args.only:
            continue

        print("\n== %s -- %s" % (s.name, s.licence))
        out = os.path.join(root, s.name)
        os.makedirs(out, exist_ok=True)

        try:
            if s.kind == "books":
                # Project Gutenberg plain text, one file per ebook id.
                for i in s.ids:
                    url = "https://www.gutenberg.org/files/%d/%d-0.txt" % (i, i)
                    fetchlib.download(url, os.path.join(out, "%d.txt" % i))
                continue

            url, kind = s.url, s.kind
            parts = []
            if args.mirror and (s.mirror or s.mirror_parts):
                kind = s.mirror_kind or s.kind
                parts = s.mirror_parts
                url = s.mirror or (parts[0] if parts else None)
                print("  using the mirror%s" % (" (%d pieces)" % len(parts) if parts else ""))
            name = url.rstrip("/").split("/")[-1] or (s.name + ".dat")
            name = name.replace(".part01", "")
            target = os.path.join(root, s.name + "-" + name)
            if parts:
                archive = fetchlib.download_parts(parts, target)
            else:
                archive = fetchlib.download(url, target)

            if s.kind == "file":
                continue

            got = fetchlib.extract(archive, kind, out, s.takes, s.refuses,
                                   limit=args.limit)
            print("  extracted %d file(s)" % len(got))
            if not got:
                # The archive downloaded but holds none of the members
                # the spec names -- a repackaged source, not a broken
                # one. Say which, because the fix is a `take` line.
                print("  nothing matched: this copy is laid out differently.")
                print("  Add take lines for it, or use --mirror.")
                problems += 1
                continue
            if not fetchlib.verify(out, s):
                problems += 1

        except fetchlib.FetchError as e:
            print("  FAILED: %s" % e)
            if s.mirror and not args.mirror:
                print("  the mirror is one option: rerun with --mirror")
            problems += 1

    print("\nspeech: cache is %s" % root)
    if problems:
        sys.exit("speech: %d source(s) failed" % problems)


def cmd_build(args):

    spec = load(args.spec)
    root = fetchlib.cache_root(HERE)
    name = spec.settings.get("name", "en")
    out_dir = args.out or os.path.join(HERE, "build", name)
    os.makedirs(out_dir, exist_ok=True)

    mpron = os.path.join(root, "moby", "mpron.txt")
    if not os.path.exists(mpron):
        sys.exit("speech: no %s -- run: speech fetch %s" % (mpron, args.spec))

    print("== lexicon")
    stats = moby.Stats()
    base = dict(moby.read(mpron, stats))
    stats.report()

    full = lexicon.expand(base)
    print("  %d base words, %d with inflections" % (len(base), len(full)))

    ids = {n: i for i, n in enumerate(PHONES)}
    entries = sorted(full.items())
    index, data, count = lexicon.encode(entries, ids)
    print("  index %.0fKB, data %.2fMB" % (len(index) / 1024.0, len(data) / 1e6))

    # -- letter-to-sound rules, for the words the lexicon does not have --
    #
    # Trained on what aligns (see lib/align.py), pruned to a node
    # budget because this one IS resident on the device: it is
    # consulted per letter, which is no place for a seek.
    print("\n== letter-to-sound rules")
    nodes_per_tree = int(spec.settings.get("lts_nodes", "1200"))
    aligned = list(align.aligned(base.items()))
    print("  %d of %d words aligned" % (len(aligned), len(base)))
    trees = lts_train.train(aligned, budget=nodes_per_tree)
    lts_blob = lts_train.serialise(trees, ids)
    print("  %d nodes, %.0fKB" % (sum(lts_train.size(t) for t in trees.values()),
                                  len(lts_blob) / 1024.0))

    # The fitted stages -- prosody, formants, voice source -- only on
    # request: session 0 measured none of them making the voice more
    # intelligible (docs/tts_data.md, "Session 0"), so the default pack is the
    # lexicon and the letter rules, which did.
    # The recorded voice, when `speech diphones` has built an inventory.
    # A tts that predates it ignores the section and keeps its formant
    # voice, like any pack section it does not know.
    dip_blob = b""
    inv_dir = os.path.join(HERE, "build", "diphone")
    if os.path.exists(os.path.join(inv_dir, "units.json")) and not args.no_diphones:
        from lib import diphone as diphonelib
        dip_blob = diphonelib.serialise(inv_dir, PHONES)
        print("== diphones: %.2f MB from %s" % (len(dip_blob) / 1e6, inv_dir))

    fmt_path = os.path.join(HERE, "build", "align", "formants.bin")
    if not args.fitted:
        fmt_path = os.path.join(HERE, "build", "align", "-none-")
    elif os.path.exists(fmt_path):
        print("== formants: from %s" % fmt_path)

    # Prosody fitted to a real speaker, when `speech prosody` has run.
    pros_path = os.path.join(HERE, "build", "align", "prosody.bin" if args.fitted else "-none-")
    # The source fit, merged into the prosody fields when both exist.
    src_json = os.path.join(HERE, "build", "align", "source.json" if args.fitted else "-none-")
    pj = os.path.join(HERE, "build", "align", "prosody.json")
    if os.path.exists(src_json):
        import json
        base = json.load(open(pj)) if os.path.exists(pj) else {"fields": dict(prosody.DEFAULTS), "durs": {}}
        base["fields"].update(json.load(open(src_json)))
        pros_path = os.path.join(HERE, "build", "align", "prosody_source.bin")
        with open(pros_path, "wb") as f:
            f.write(prosody.serialise(base["fields"], base["durs"]))
        print("== source: open %(open)d%%, tilt %(tilt)ddB" % json.load(open(src_json)))
    if os.path.exists(pros_path):
        print("\n== prosody: from %s" % pros_path)
    elif args.fitted:
        print("\n== prosody: none fitted, the device keeps its defaults")
    else:
        print("\n== the default pack: lexicon and letter rules (--fitted adds the fitted stages)")

    manifest = ["zeitlos speech pack", "voice: " + name,
                "built by: tools/speech", "",
                "lexicon: %d entries (%d from the source, the rest inflected)"
                % (count, len(base)),
                "letter-to-sound: %d nodes over 26 trees, %d nodes per tree budget"
                % (sum(lts_train.size(t) for t in trees.values()), nodes_per_tree),
                "", "sources:"]
    for s_ in spec.sources:
        manifest.append("  %s: %s" % (s_.name, s_.licence))
        if s_.url:
            manifest.append("    %s" % s_.url)
        for fname, digest in sorted(s_.sums.items()):
            manifest.append("    %s sha256 %s" % (fname, digest))
        for bad in s_.refuses:
            manifest.append("    EXCLUDED %s" % bad)

    path = os.path.join(out_dir, "speech.zspk")
    size = pack.write(path, [
        ("MANIFEST", ("\n".join(manifest) + "\n").encode("utf-8")),
        ("PHONES", (" ".join(PHONES) + "\n").encode("ascii")),
        ("LTS", lts_blob),
    ] + ([("PROSODY", open(pros_path, "rb").read())] if os.path.exists(pros_path) else []) + (
        [("FORMANTS", open(fmt_path, "rb").read())] if os.path.exists(fmt_path) else []) + [
        ("LEXIDX", index),
        ("LEXDAT", data),
    ] + ([("DIPHONE", dip_blob)] if dip_blob else []))

    print("\n%s: %.2fMB" % (path, size / 1e6))
    print("speech: this pack is a RELEASE artifact -- not committed; see docs/tts_data.md")


def cmd_show(args):

    sections = pack.read(args.file)
    total = sum(len(v) for v in sections.values())
    print("%s: %d sections, %.2fMB" % (args.file, len(sections), total / 1e6))
    for k, v in sections.items():
        print("  %-8s %9d bytes" % (k, len(v)))
    if "MANIFEST" in sections:
        print()
        print(sections["MANIFEST"].decode("utf-8", "replace").rstrip())


def cmd_mirror(args):
    """
    Prepares a source for publishing somewhere we control.

    Downloads it from the original, checks it, optionally cuts it down
    to a workable subset, splits it into publishable pieces and writes
    the provenance beside them. What it does NOT do is publish: that
    needs credentials, and it prints the command instead.

    See docs/tts_data.md, "Open item: mirror the sources", for why this exists.
    """

    spec = load(args.spec)
    src = spec.source(args.source)
    if not src:
        sys.exit("speech: no source %r in %s" % (args.source, args.spec))
    if not src.url:
        sys.exit("speech: source %r has no url to mirror" % args.source)

    root = fetchlib.cache_root(HERE)
    out = args.out or os.path.join(HERE, "mirror", src.name)
    os.makedirs(out, exist_ok=True)

    print("== %s -- %s" % (src.name, src.licence))
    name = src.url.rstrip("/").split("/")[-1]
    archive = fetchlib.download(src.url, os.path.join(root, src.name + "-" + name))

    digest = fetchlib.sha256(archive)
    print("  original sha256 %s" % digest)

    publish = archive
    if args.clips:
        publish = os.path.join(out, name.replace(".tar", "-%d.tar" % args.clips))
        if os.path.exists(publish):
            print("  have %s" % os.path.basename(publish))
        else:
            print("  cutting to %d clips" % args.clips)
            fetchlib.subset_tar(archive, src.kind, publish, args.clips)

    piece = int(args.piece_mb * 1024 * 1024)
    # Nothing to split is the normal case for a subset, and it is not
    # a lesser outcome: one file is one asset and one mirror_part line.
    if piece < 1024:
        sys.exit("speech: --piece-mb must be at least 0.001")
    if os.path.getsize(publish) > piece:
        print("  splitting into %dMB pieces" % args.piece_mb)
        made = fetchlib.split_file(publish, out, piece)
    else:
        import shutil
        dest = os.path.join(out, os.path.basename(publish))
        if os.path.abspath(dest) != os.path.abspath(publish):
            shutil.copyfile(publish, dest)
        made = [dest]
        print("  one piece: %s" % os.path.basename(dest))

    prov = os.path.join(out, "PROVENANCE.md")
    with open(prov, "w") as f:
        f.write("# %s\n\n" % src.name)
        f.write("Licence: %s\n\n" % src.licence)
        f.write("Original: %s\n" % src.url)
        f.write("Original sha256: %s\n\n" % digest)
        if args.clips:
            f.write("This mirror holds the first %d clips and every non-clip file\n"
                    "(transcript, readme) -- enough for the acoustic work, which\n"
                    "needs a few hours rather than all of it.\n\n" % args.clips)
            f.write("Subset sha256: %s\n\n" % fetchlib.sha256(publish))
        f.write("Pieces, to be joined in order:\n\n")
        for m in made:
            f.write("  %s  sha256 %s\n" % (os.path.basename(m), fetchlib.sha256(m)))
        f.write("\nFetched by tools/speech; see docs/tts_data.md.\n")

    print("\n  %s" % out)
    print("  %d file(s) to publish, plus PROVENANCE.md" % len(made))
    print("\nTo publish, and then point the spec at it:")
    # The actual file names, not a glob: an unsplit source has no
    # .part suffix at all, and a glob that matches nothing publishes a
    # release with no data in it.
    print("  gh release create %s-mirror \\" % src.name)
    for m in made:
        print("      %s \\" % m)
    print("      %s \\" % prov)
    print("      --repo %s --notes-file %s" % (args.repo, prov))
    print("  then add to dist/%s.spec, under `source %s`:" %
          (spec.settings.get("name", "en"), src.name))
    for m in made:
        print("      mirror_part https://github.com/%s/releases/download/%s-mirror/%s"
              % (args.repo, src.name, os.path.basename(m)))


def cmd_align(args):
    """
    Places every phone of a speech corpus in time. See lib/corpus.py
    and docs/tts_data.md, "Alignment".
    """

    import time

    root = fetchlib.cache_root(HERE)
    cdir = args.corpus or os.path.join(root, "ljspeech")
    if not os.path.exists(os.path.join(cdir, "metadata.csv")):
        sys.exit("speech: no corpus at %s\n"
                 "  extract one with: speech fetch --only ljspeech --limit 2000"
                 % cdir)

    repo = os.path.abspath(os.path.join(HERE, "..", ".."))
    out = os.path.join(HERE, "build", "align")
    os.makedirs(out, exist_ok=True)

    clips = corpus.read_metadata(cdir, args.limit)
    print("== %d clips from %s" % (len(clips), cdir))
    if not clips:
        sys.exit("speech: nothing to align")

    pack_path = os.path.join(HERE, "build", "en", "speech.zspk")
    if not os.path.exists(pack_path):
        print("  note: no pack at %s -- the reference will use the built-in rules," % pack_path)
        print("        which mispronounce more words; run `speech build` first for better alignment")
        pack_path = ""

    t0 = time.time()
    renderer = corpus.build_renderer(repo, os.path.join(out, "tts_wav"))
    print("  rendering references")
    corpus.render_references(renderer, clips, os.path.join(out, "ref"), pack_path)
    print("  %.0fs" % (time.time() - t0))

    t0 = time.time()
    print("  aligning")
    results, failed = corpus.align_all(clips, os.path.join(out, "ref"),
                                       os.path.join(out, "rec"), args.jobs)
    print("  %.0fs" % (time.time() - t0))

    labels = corpus.write_labels(results, os.path.join(out, "labels"))

    # What to send back: enough to judge the alignment without the audio.
    import numpy as np
    ratios, phone_ms = [], {}
    for cid, phones in results.items():
        speech = [(n, a, b) for n, a, b in phones if not n.startswith("_")]
        if not speech:
            continue
        for n, a, b in speech:
            phone_ms.setdefault(n, []).append(b - a)
    counts = sorted(((len(v), k) for k, v in phone_ms.items()), reverse=True)

    lines = []
    lines.append("aligned %d of %d clips (%d failed)" % (len(results), len(clips), len(failed)))
    reasons = {}
    for why in failed.values():
        reasons[why] = reasons.get(why, 0) + 1
    for why, n in sorted(reasons.items(), key=lambda kv: -kv[1]):
        lines.append("  failed: %s x%d" % (why, n))
    lines.append("phone durations in the recordings (ms): median / 10th-90th percentile / count")
    for n, k in counts:
        v = np.array(phone_ms[k])
        lines.append("  %-3s %4.0f  %4.0f-%-4.0f %6d" % (k, np.median(v), np.percentile(v, 10),
                                                  np.percentile(v, 90), n))
    summary = os.path.join(out, "summary.txt")
    with open(summary, "w") as f:
        f.write("\n".join(lines) + "\n")

    print()
    print("\n".join(lines[:4]))
    print("\n  %s  <- paste this back" % summary)
    print("  %s/  <- Audacity labels for %d clips: open the wav, then" % (os.path.dirname(labels[0]) if labels else out, len(labels)))
    print("     File > Import > Labels, to see the boundaries against the audio")


def aligner_read(path):
    from lib import aligner
    return aligner.read_phones(path)


def pack_path_for(here):
    """
    The pack every CALIBRATION render uses: the built one with anything
    fitted stripped out -- lexicon and letter rules only.

    Calibration means "our voice at its defaults". The built pack, after
    a previous `speech build`, carries the previous run's fitted prosody
    and formants, and rendering with it made each run calibrate against
    the last one's output -- which is how a declination of 14 became 37
    between two runs on the same data.
    """
    p = os.path.join(here, "build", "en", "speech.zspk")
    if not os.path.exists(p):
        return ""
    bare = os.path.join(here, "build", "align", "bare.zspk")
    os.makedirs(os.path.dirname(bare), exist_ok=True)
    secs = pack.read(p)
    keep = ["MANIFEST", "PHONES", "LTS", "LEXIDX", "LEXDAT"]
    pack.write(bare, [(k, secs[k]) for k in keep if k in secs])
    return bare


def cmd_prosody(args):
    """
    Fits phon.c's timing and pitch parameters to an aligned corpus.
    Run `speech align` first; then `speech build` puts the result in
    the pack. See lib/prosody.py and docs/tts_data.md, "Prosody".
    """

    root = fetchlib.cache_root(HERE)
    cdir = args.corpus or os.path.join(root, "ljspeech")
    out = os.path.join(HERE, "build", "align")
    rec = os.path.join(out, "rec")
    if not os.path.isdir(rec):
        sys.exit("speech: no alignments in %s -- run `speech align` first" % rec)

    repo = os.path.abspath(os.path.join(HERE, "..", ".."))
    clips = corpus.read_metadata(cdir, args.limit)

    # Alignments made before the marks carried stress ("AA1") and
    # pause kinds ("_c", "_s") cannot be fitted: every parameter that
    # depends on them would silently keep its default. Check a sample
    # and refuse, rather than produce a table that looks fitted.
    import glob
    sample = sorted(glob.glob(os.path.join(rec, "*.phones")))[:50]
    names = set()
    for path in sample:
        names.update(p[0] for p in aligner_read(path))
    if not any(n[-1:].isdigit() for n in names) or not (names & {"_c", "_s", "_p"}):
        sys.exit("speech: the alignments in %s predate stress and pause marks --\n"
                 "  run `speech align` again, then `speech prosody`" % rec)

    print("== measuring %d clips" % len(clips))
    m = prosody.measure_corpus(clips, rec)
    print("  %d clips with alignments" % m.clips)

    # The same measurement on our own voice, which rendered the same
    # sentences with known settings during `speech align`: how the
    # measurement reads each parameter, to calibrate by.
    # ...rendered at the SPEAKER's rate. A pitch event lasts a fixed
    # number of frames, so the same setting reads differently at a
    # different speed; calibrating at 180wpm against a slower reader
    # over-reads every lift and fall. The rate comes from the
    # alignments: how long the speaker took against the reference.
    import numpy as np
    ratios = []
    for cid, _, _ in clips:
        rp = os.path.join(rec, cid + ".phones")
        fp = os.path.join(out, "ref", "t_%s.phones" % cid)
        if os.path.exists(rp) and os.path.exists(fp):
            a = [p for p in aligner_read(rp) if not p[0].startswith("_")]
            b = [p for p in aligner_read(fp) if not p[0].startswith("_")]
            if a and b:
                ratios.append((a[-1][2] - a[0][1]) / max(1.0, b[-1][2] - b[0][1]))
    ratio = float(np.median(ratios)) if ratios else 1.0
    wpm = max(80, min(450, int(round(180 / ratio))))
    print("  the speaker is %.2fx our 180wpm: calibrating at %dwpm" % (1 / ratio, wpm))
    cal_dir = os.path.join(out, "calib")
    # Always the current renderer: a binary left by an earlier `align`
    # may write an older mark format, or voice things differently.
    renderer = corpus.build_renderer(repo, os.path.join(out, "tts_wav"))
    corpus.render_references(renderer, clips, cal_dir,
                             pack_path_for(HERE), wpm=wpm)
    calib = prosody.measure_corpus(clips, cal_dir, prefix="t_")

    table = prosody.table_durations(repo)
    fields, durs, notes, measured = m.fit(table, calib, rate_ratio=ratio)

    lines = ["prosody fitted to %d clips" % m.clips, ""]
    lines.append("%-12s %7s %7s" % ("parameter", "default", "fitted"))
    for k in prosody.FIELDS:
        if k in ("open", "tilt"):
            continue                        # `speech source` fits these
        # Say which values were measured. A default kept for lack of
        # data must not look like a measurement that agreed with it.
        if k not in measured:
            lines.append("%-12s %7d       -  not measured, default kept" % (k, prosody.DEFAULTS[k]))
            continue
        mark = "" if fields[k] == prosody.DEFAULTS[k] else "  *"
        lines.append("%-12s %7d %7d%s" % (k, prosody.DEFAULTS[k], fields[k], mark))
    lines.append("")
    lines.append("durations, ms (the device's table -> fitted):")
    row = []
    for ph in sorted(table):
        if ph in durs:
            row.append("%s %d->%d" % (ph, table[ph], durs[ph]))
    for i in range(0, len(row), 6):
        lines.append("  " + "   ".join(row[i:i + 6]))
    lines.append("")
    lines.extend("note: " + n for n in notes)

    with open(os.path.join(out, "prosody.txt"), "w") as f:
        f.write("\n".join(lines) + "\n")
    import json
    json.dump({"fields": fields, "durs": durs}, open(os.path.join(out, "prosody.json"), "w"))
