     "GPIO0"
    ],
    "when": "GPIO_PORT0 & GPIO_PORT0_NARROW"
   },
   {
    "block": "wbs_gpio0_i",
    "kind": "io",
    "label": "GPIO0",
    "ports": [
     "GPIO0"
    ],
    "when": "GPIO_PORT0 & !GPIO_PORT0_NARROW"
   },
   {
    "block": "wbs_gpio0_i",
    "kind": "io",
    "label": "GPIO1",
    "ports": [
     "GPIO1"
    ],
    "when": "GPIO_PORT1"
   },
   {
    "block": "wbs_gpio0_i",
    "kind": "io",
    "label": "GPIO2",
    "ports": [
     "GPIO2"
    ],
    "when": "GPIO_PORT2"
   },
   {
    "block": "wbs_gpio0_i",
    "kind": "io",
    "label": "GPIO3",
    "ports": [
     "GPIO3"
    ],
    "when": "GPIO_PORT3"
   },
   {
    "block": "wbs_gpio0_i",
    "kind": "io",
    "label": "LED_B",
    "ports": [
     "LED_B"
    ],
    "when": "always"
   },
   {
    "block": "wbs_qqspi_i",
    "kind": "io",
    "label": "QQSPI_*",
    "ports": [
     "QQSPI_CS1",
     "QQSPI_CS0"
    ],
    "when": "MEM_QQSPI & !MEM_QQSPI_SINGLE"
   },
   {
    "block": "wbs_qqspi_i",
    "kind": "io",
    "label": "QQSPI_*",
    "ports": [
     "QQSPI_SS",
     "QQSPI_SCK",
     "QQSPI_MOSI",
     "QQSPI_MISO",
     "QQSPI_SIO2",
     "QQSPI_SIO3"
    ],
    "when": "MEM_QQSPI"
   },
   {
    "block": "wbs_rom0_i",
    "kind": "io",
    "label": "CSPI_*",
    "ports": [
     "CSPI_SS_FLASH",
     "CSPI_MISO",
     "CSPI_MOSI"
    ],
    "when": "MEM_ROM"
   },
   {
    "block": "wbs_rom0_i",
    "kind": "io",
    "label": "CSPI_SCK",
    "ports": [
     "CSPI_SCK"
    ],
    "when": "MEM_ROM & !FPGA_ECP5"
   },
   {
    "block": "wbs_spieth0_i",
    "kind": "io",
    "label": "ETH_*",
    "ports": [
     "ETH_SS",
     "ETH_MISO",
     "ETH_MOSI",
     "ETH_SCLK",
     "ETH_INT"
    ],
    "when": "SPI_ETH"
   },
   {
    "block": "wbs_spisd0_i",
    "kind": "io",
    "label": "SD_*",
    "ports": [
     "SD_SS",
     "SD_MISO",
     "SD_MOSI",
     "SD_SCK"
    ],
    "when": "SPI_SDCARD"
   },
   {
    "block": "wbs_sram_i",
    "kind": "io",
    "label": "SRAM_*",
    "ports": [
     "SRAM_D",
     "SRAM_A",
     "SRAM1_CE",
     "SRAM0_CE",
     "SRAM1_OE",
     "SRAM0_OE",
     "SRAM1_WE",
     "SRAM0_WE",
     "SRAM1_UB",
     "SRAM0_UB",
     "SRAM1_LB",
     "SRAM0_LB"
    ],
    "when": "MEM_SRAM"
   },
   {
    "block": "wbs_uart0_i:uart_wb",
    "kind": "io",
    "label": "UART0_*",
    "ports": [
     "UART0_TX",
     "UART0_RX"
    ],
    "when": "UART0"
   },
   {
    "block": "wbs_uart0_i:usb_cdc_uart",
    "kind": "io",
    "label": "usb_ufp_*",
    "ports": [
     "usb_ufp_dp",
     "usb_ufp_dm",
     "usb_ufp_pull"
    ],
    "when": "USB_CDC"
   },
   {
    "block": "wbs_uart1_i",
    "kind": "io",
    "label": "UART1_*",
    "ports": [
     "UART1_TX",
     "UART1_RX"
    ],
    "when": "UART1"
   },
   {
    "block": "wbs_usb0_i",
    "kind": "io",
    "label": "usb_host_*",
    "ports": [
     "usb_host_dp",
     "usb_host_dm"
    ],
    "when": "USB_HID"
   },
   {
    "block": "wbs_usb1_i",
    "kind": "io",
    "label": "usb_host_*",
    "ports": [
     "usb_host_dp",
     "usb_host_dm"
    ],
    "when": "USB_HID"
   },
   {
    "block": null,
    "kind": "unused",
    "label": "CLK_100",
    "ports": [
     "CLK_100"
    ],
    "when": "OSC100"
   },
   {
    "block": null,
    "kind": "clock",
    "label": "CLK_25",
    "ports": [
     "CLK_25"
    ],
    "when": "OSC25"
   },
   {
    "block": null,
    "kind": "clock",
    "label": "CLK_48",
    "ports": [
     "CLK_48"
    ],
    "when": "OSC48"
   },
   {
    "block": null,
    "kind": "unused",
    "label": "CLK_50",
    "ports": [
     "CLK_50"
    ],
    "when": "OSC50"
   },
   {
    "block": null,
    "kind": "io",
    "label": "LED_G",
    "ports": [
     "LED_G"
    ],
    "when": "LED_RGB"
   },
   {
    "block": null,
    "kind": "io",
    "label": "wifi_en_*",
    "ports": [
     "wifi_en",
     "wifi_gpio0",
     "flash_holdn",
     "flash_wpn",
     "LED1",
     "LED2",
     "usb_fpga_pu_dp",
     "usb_fpga_pu_dn",
     "SD_DAT1",
     "SD_DAT2"
    ],
    "when": "BOARD_ULX3S"
   }
  ],
  "secondary": [
   {
    "iface": "wb_",
    "target": "wbs_vram_i",
    "tree": {
     "blocks": [
      {
       "id": "varb0_i",
       "when": "ARBITER"
      }
     ],
     "bypass": true,
     "iface": "s_",
     "inputs": [
      {
       "node": {
        "blocks": [
         {
          "id": "wbm_cpu0_i:zeitlos32_wb",
          "when": "CPU_ZEITLOS32"
         },
         {
          "id": "wbm_cpu0_i:picorv32_wb",
          "when": "!CPU_ZEITLOS32"
         }
        ],
        "bypass": false,
        "iface": "wbm_",
        "kind": "master"
       },
       "port": "m0_"
      },
      {
       "node": {
        "blocks": [
         {
          "id": "wbm_gpu0_i",
          "when": "GPU_RASTER"
         }
        ],
        "bypass": false,
        "iface": "m_",
        "kind": "master"
       },
       "port": "m1_"
      },
      {
       "node": {
        "blocks": [
         {
          "id": "wbm_blit0_i",
          "when": "GPU_BLIT"
         }
        ],
        "bypass": false,
        "iface": "m_",
        "kind": "master"
       },
       "port": "m2_"
      }
     ],
     "kind": "arbiter"
    }
   }
  ],
  "top": "rtl/sysctl.v",
  "virtual_windows": [
   {
    "base": "0x80000000",
    "block": "mtu_i",
    "mask": "0xF0000000",
    "when": "always"
   }
  ]
 }
}
