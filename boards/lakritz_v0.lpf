# PMOD A ball map (github.com/machdyne/lakritz), duplicated in
# machine-readable form as pmod.a in release/hw/boards/lakritz.spec.
# This is Lakritz's ONLY PMOD connector, which is why the console and
# a GPIO port are mutually exclusive here -- see the GPIO block below.
#
#   pin   ball      pin   ball
#   1     B11       7     A11
#   2     B12       8     A12
#   3     B13       9     A13
#   4     B14       10    A14

# PMOD A (GPIO)
#
# Commented out because uncommenting it alone would put GPIO0[1] and
# UART0_TX on B12, and GPIO0[2] and UART0_RX on B13. A hand build needs
# `UART0 commented out of rtl/boards.vh's BOARD_LAKRITZ block AND
# `GPIO_PORT0 uncommented there; the console then goes to
# rtl/uart_null.v and the machine comes up on HDMI only.
#
# The supported path is `./release/zrelease build lakritz_gpio`, which
# does all of that from one spec file. The release build generates its
# own constraints from release/hw/pmods/gpio.spec and ignores these.
#
# Bit order is PMOD pin order -- bits 0-3 are pins 1-4, bits 4-7 are
# pins 7-10. PULLMODE=UP is a deliberate choice, not a default; see
# release/hw/pmods/gpio.spec. See docs/gpio.md.
#LOCATE COMP "GPIO0[0]" SITE "B11";				# PMODA1
#IOBUF PORT "GPIO0[0]" IO_TYPE=LVCMOS33 PULLMODE=UP;
#LOCATE COMP "GPIO0[1]" SITE "B12";				# PMODA2
#IOBUF PORT "GPIO0[1]" IO_TYPE=LVCMOS33 PULLMODE=UP;
#LOCATE COMP "GPIO0[2]" SITE "B13";				# PMODA3
#IOBUF PORT "GPIO0[2]" IO_TYPE=LVCMOS33 PULLMODE=UP;
#LOCATE COMP "GPIO0[3]" SITE "B14";				# PMODA4
#IOBUF PORT "GPIO0[3]" IO_TYPE=LVCMOS33 PULLMODE=UP;
#LOCATE COMP "GPIO0[4]" SITE "A11";				# PMODA7
#IOBUF PORT "GPIO0[4]" IO_TYPE=LVCMOS33 PULLMODE=UP;
#LOCATE COMP "GPIO0[5]" SITE "A12";				# PMODA8
#IOBUF PORT "GPIO0[5]" IO_TYPE=LVCMOS33 PULLMODE=UP;
#LOCATE COMP "GPIO0[6]" SITE "A13";				# PMODA9
#IOBUF PORT "GPIO0[6]" IO_TYPE=LVCMOS33 PULLMODE=UP;
#LOCATE COMP "GPIO0[7]" SITE "A14";				# PMODA10
#IOBUF PORT "GPIO0[7]" IO_TYPE=LVCMOS33 PULLMODE=UP;

LOCATE COMP "UART0_TX" SITE "B12";
IOBUF PORT "UART0_TX" IO_TYPE=LVCMOS33;
LOCATE COMP "UART0_RX" SITE "B13";
IOBUF PORT "UART0_RX" IO_TYPE=LVCMOS33;

# AUDIO -- 1-bit stereo sigma-delta DAC (rtl/audio_out.v's audio_sd).
# Enabled by `AUDIO + `AUDIO_SD in rtl/boards.vh. See docs/audio.md.
LOCATE COMP "AUDIO_L" SITE "M3";
IOBUF PORT "AUDIO_L" IO_TYPE=LVCMOS33;
LOCATE COMP "AUDIO_R" SITE "N1";
IOBUF PORT "AUDIO_R" IO_TYPE=LVCMOS33;

# COMPOSITE VIDEO -- 4-bit R-2R DAC into a 75R series resistor and an
# RCA socket. See docs/composite.md for the ladder values, the timing
# derivation and the levels.
#
# Renamed from VIDEO_D0..D3 to COMP_DAC[3:0] to match rtl/sysctl.v's
# port, which is a bus rather than four separate signals. Same four
# pins; only the name changed.
#
# STILL COMMENTED OUT, and deliberately, even though the port now
# exists and the gateware is written. `GPU_COMPOSITE is off by default
# in rtl/boards.vh, and on a build without it rtl/sysctl.v does not
# declare COMP_DAC at all -- so a live LOCATE here would reference a
# port the top module does not have on every ordinary Lakritz build.
#
# Uncomment these AND `GPU_COMPOSITE together. They are two halves of
# one change and neither is useful alone: the define without the pins
# fails to place, and the pins without the define constrain a port
# that is not there.
#
# Note composite is MUTUALLY EXCLUSIVE with `GPU_DDMI, which Lakritz
# defines. Enabling composite means commenting that out as well --
# rtl/sysctl.v enforces this by suppressing the DDMI port declarations
# on a composite build, so the failure is a loud one at place-and-route
# rather than a board quietly driving HDMI pins with 15.7kHz sync.
#
#LOCATE COMP "COMP_DAC[0]" SITE "P1";
#IOBUF PORT "COMP_DAC[0]" IO_TYPE=LVCMOS33;
#LOCATE COMP "COMP_DAC[1]" SITE "R1";
#IOBUF PORT "COMP_DAC[1]" IO_TYPE=LVCMOS33;
#LOCATE COMP "COMP_DAC[2]" SITE "P2";
#IOBUF PORT "COMP_DAC[2]" IO_TYPE=LVCMOS33;
#LOCATE COMP "COMP_DAC[3]" SITE "N4";
#IOBUF PORT "COMP_DAC[3]" IO_TYPE=LVCMOS33;
