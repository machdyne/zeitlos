BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=2.4 MASTER_SPI_PORT=DISABLE SLAVE_SPI_PORT=DISABLE SLAVE_PARALLEL_PORT=DISABLE CONFIG_MODE=SPI_SERIAL;

LOCATE COMP "CLK_48" SITE "A7";
IOBUF  PORT "CLK_48" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "CLK_48" 48 MHZ;

# RMII reference clock, Sergei has no 50MHz osc; must be provided by SOC
LOCATE COMP "ETH_REFCLK" SITE "C7";
IOBUF PORT "ETH_REFCLK" IO_TYPE=LVCMOS33;
FREQUENCY PORT "ETH_REFCLK" 50 MHZ;

LOCATE COMP "LED_B" SITE "P1";
IOBUF PORT "LED_B" IO_TYPE=LVCMOS33;

LOCATE COMP "CSPI_SS_FLASH" SITE "N8";
IOBUF PORT "CSPI_SS_FLASH" IO_TYPE=LVCMOS33;
LOCATE COMP "CSPI_MISO" SITE "T7";
IOBUF PORT "CSPI_MISO" IO_TYPE=LVCMOS33;
LOCATE COMP "CSPI_MOSI" SITE "T8";
IOBUF PORT "CSPI_MOSI" IO_TYPE=LVCMOS33;

# PMOD A ball map. Six pins, four of them signals -- so a GPIO port
# here is half width. Duplicated in machine-readable form as pmod.a in
# release/hw/boards/sergei_ml1.spec.
#
#   pin   ball
#   1     A13     also the optical S/PDIF output, below -- and it
#                   reaches the connector THROUGH that transmitter's
#                   series resistor, so as a GPIO it is output-only:
#                   the load holds it low against the internal
#                   pull-up and it can never read high. Measured, not
#                   assumed. See release/targets/sergei_gpio.spec.
#   2     R12
#   3     T13
#   4     T14

# Optical SPDIF audio output (shared with PMOD_A1)
LOCATE COMP "AUD_OPTICAL" SITE "A13";
IOBUF PORT "AUD_OPTICAL" IO_TYPE=LVCMOS33;

# PMOD A (GPIO, 4 pins)
#
# Commented out because pin 1 IS the line above: A13 carries either the
# optical output or GPIO0[0], never both.
#
# A HAND BUILD NEEDS THREE EDITS, NOT TWO, and the third is easy to
# miss:
#
#   1. comment out `AUDIO_SPDIF in rtl/boards.vh's BOARD_SERGEI_ML1
#   2. uncomment `GPIO_PORT0 and `GPIO_PORT0_NARROW there
#   3. COMMENT OUT THE AUD_OPTICAL LOCATE ABOVE, and uncomment the
#      four lines below
#
# Miss (3) and two COMPs claim A13. Removing `AUDIO_SPDIF deletes the
# PORT but not this file's constraint on it, and a LOCATE naming a
# port that no longer exists is a warning rather than an error -- so
# the build still completes and GPIO0[0] is the pin that quietly does
# not work.
#
# The release path has none of this: `./release/zrelease build
# sergei_gpio` generates the four constraints and drops the
# AUD_OPTICAL one automatically, because a PMOD spec takes over every
# ball in its port.
#
# The supported path is `./release/zrelease build sergei_gpio`, which
# generates these from release/hw/pmods/gpio4.spec and drops the
# AUD_OPTICAL constraint above automatically.
#LOCATE COMP "GPIO0[0]" SITE "A13";				# PMODA1
#IOBUF PORT "GPIO0[0]" IO_TYPE=LVCMOS33 PULLMODE=UP;
#LOCATE COMP "GPIO0[1]" SITE "R12";				# PMODA2
#IOBUF PORT "GPIO0[1]" IO_TYPE=LVCMOS33 PULLMODE=UP;
#LOCATE COMP "GPIO0[2]" SITE "T13";				# PMODA3
#IOBUF PORT "GPIO0[2]" IO_TYPE=LVCMOS33 PULLMODE=UP;
#LOCATE COMP "GPIO0[3]" SITE "T14";				# PMODA4
#IOBUF PORT "GPIO0[3]" IO_TYPE=LVCMOS33 PULLMODE=UP;

# UART Debug
LOCATE COMP "UART0_TX" SITE "B3";
IOBUF PORT "UART0_TX" IO_TYPE=LVCMOS33;
LOCATE COMP "UART0_RX" SITE "A2";
IOBUF PORT "UART0_RX" IO_TYPE=LVCMOS33;

# SD Card SPI (dedicated SD card pins)
LOCATE COMP "SD_SCK" SITE "L3";
IOBUF PORT "SD_SCK" IO_TYPE=LVCMOS33  PULLMODE=NONE;
LOCATE COMP "SD_MOSI" SITE "M1";
IOBUF PORT "SD_MOSI" IO_TYPE=LVCMOS33  PULLMODE=NONE;
LOCATE COMP "SD_SS" SITE "L2";
IOBUF PORT "SD_SS" IO_TYPE=LVCMOS33  PULLMODE=NONE;
LOCATE COMP "SD_MISO" SITE "L1"; 
IOBUF PORT "SD_MISO" IO_TYPE=LVCMOS33  PULLMODE=NONE;
LOCATE COMP "SD_D1" SITE "M2";
IOBUF PORT "SD_D1" IO_TYPE=LVCMOS33  PULLMODE=NONE;
LOCATE COMP "SD_D2" SITE "M3";
IOBUF PORT "SD_D2" IO_TYPE=LVCMOS33  PULLMODE=NONE;

# RMII Ethernet (LAN8720A PHY, no MDIO/MDC -- PHY mode/address is set
# by the strap pull-ups below, sampled when ETH_RST_N is released)
LOCATE COMP "ETH_RXD[0]" SITE "E4";
IOBUF PORT "ETH_RXD[0]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "ETH_RXD[1]" SITE "D4";
IOBUF PORT "ETH_RXD[1]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "ETH_TXD[0]" SITE "E6";
IOBUF PORT "ETH_TXD[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "ETH_TXD[1]" SITE "D6";
IOBUF PORT "ETH_TXD[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "ETH_TX_EN" SITE "C5";
IOBUF PORT "ETH_TX_EN" IO_TYPE=LVCMOS33;
LOCATE COMP "ETH_CRS_DV" SITE "A5";
IOBUF PORT "ETH_CRS_DV" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "ETH_RST_N" SITE "B5";
IOBUF PORT "ETH_RST_N" IO_TYPE=LVCMOS33;

# USB Host
LOCATE COMP "usb_host_dp[0]" SITE "A9";
IOBUF PORT "usb_host_dp[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "usb_host_dp[1]" SITE "C8";
IOBUF PORT "usb_host_dp[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "usb_host_dm[0]" SITE "A10";
IOBUF PORT "usb_host_dm[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "usb_host_dm[1]" SITE "B8";
IOBUF PORT "usb_host_dm[1]" IO_TYPE=LVCMOS33;

# SDRAM
LOCATE COMP "sdram_clock" SITE "F16";
IOBUF PORT "sdram_clock" IO_TYPE=LVTTL33;
LOCATE COMP "serial_tx" SITE "B4";
IOBUF PORT "serial_tx" IO_TYPE=LVCMOS33;
LOCATE COMP "serial_rx" SITE "C4";
IOBUF PORT "serial_rx" IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_a[0]" SITE "M13";
IOBUF PORT "sdram_a[0]" IO_TYPE=LVTTL33;
LOCATE COMP "sdram_a[1]" SITE "M14";
IOBUF PORT "sdram_a[1]" IO_TYPE=LVTTL33;
LOCATE COMP "sdram_a[2]" SITE "L14";
IOBUF PORT "sdram_a[2]" IO_TYPE=LVTTL33;
