## lebkuchen_v0.ccf
##
## Machdyne Lebkuchen -- GateMate CCGM1A1 + RP2040 supervisor.
## Board facts, pinout derivation and port status: docs/lebkuchen.md
##
## Pins below were extracted from the KiCad sources in the lebkuchen
## repo: pcb/lebkuchen_v0/lebkuchen.kicad_pcb (pad -> net) joined
## against the CCGM1A1 library symbol in lebkuchen.kicad_sch
## (ball -> GateMate pin name). The net name each one carries is in
## the comment.

## CLOCK
##
## There is no oscillator for the FPGA. CLK_48 is RP2040 GPIO23
## (clk_gpout1) at 48MHz, from the RP2040's USB PLL; the only crystal
## on the board is the RP2040's 12MHz part. The FPGA therefore has no
## clock at all until supervisor firmware enables GPOUT1.
##
## This also makes sys_clk a firmware constant on this board, since
## rtl/sysctl.v assigns sys_clk = CLK_48 with no PLL in between.

Net "CLK_48"  Loc = "IO_SB_A7" | SCHMITT_TRIGGER=true;    # /CLKRP

## LED

Net "LED_B"   Loc = "IO_WC_A0";                           # /LED

## UART0 -- to the RP2040, which bridges it to USB CDC.
## Net names are from the RP2040's point of view.

Net "UART0_RX" Loc = "IO_SA_A8";                          # /UART_TX
Net "UART0_TX" Loc = "IO_SA_B8";                          # /UART_RX

## MAIN MEMORY -- 8MB QSPI PSRAM, APS6404L-SQN-SN, ONE chip.
## Hence `MEM_QQSPI_SINGLE in rtl/boards.vh: no chip-select decode.

Net "QQSPI_SS"   Loc = "IO_NA_A1";                        # /RAM_SS
Net "QQSPI_SCK"  Loc = "IO_NA_B1";                        # /RAM_SCK
Net "QQSPI_MOSI" Loc = "IO_NA_A3";                        # /RAM_MOSI
Net "QQSPI_MISO" Loc = "IO_NA_B0";                        # /RAM_MISO
Net "QQSPI_SIO2" Loc = "IO_NA_B2";                        # /RAM_IO2
Net "QQSPI_SIO3" Loc = "IO_NA_A2";                        # /RAM_IO3

## CSPI -- the FPGA's dedicated SPI CONFIGURATION pins, reused as user
## IO once the FPGA is in user mode.
##
## SPI_D2, SPI_D3 and SPI_FWD (balls R2, R1, R4) are NOT CONNECTED, so
## this bus is x1 only. That is exactly what rtl/spiflashro.v uses
## (command 0x03, single bit), so nothing is lost.
##
## There is no flash on the FPGA's side of this board: the 4MB NOR part
## is the RP2040's own boot flash. The supervisor emulates a NOR flash
## here to serve the `MEM_ROM window at 0x1000_0000.

Net "CSPI_SS_FLASH" Loc = "IO_WA_A8";                     # /CSPI_SS
Net "CSPI_SCK"      Loc = "IO_WA_B8";                     # /CSPI_SCK
Net "CSPI_MOSI"     Loc = "IO_WA_B7";                     # /CSPI_MOSI
Net "CSPI_MISO"     Loc = "IO_WA_A7";                     # /CSPI_MISO

## MICROSD -- 1-bit SPI mode, through the LSF0108 level shifter.
## The RP2040 sits on these same nets (its GPIO8-11), so bus ownership
## has to be arbitrated if the supervisor ever reads the card.

Net "SD_SS"   Loc = "IO_WB_B2";                           # /SD_SS
Net "SD_MOSI" Loc = "IO_WB_A2";                           # /SD_MOSI
Net "SD_MISO" Loc = "IO_WB_B5";                           # /SD_MISO
Net "SD_SCK"  Loc = "IO_WB_A5";                           # /SD_SCK

## USB HOST -- two ports, through the LSF0108.
## Index 0 is the port the schematic calls USB2, index 1 is USB1.

Net "usb_host_dp[0]" Loc = "IO_WB_B0";                    # /USB2_DP
Net "usb_host_dm[0]" Loc = "IO_WB_A0";                    # /USB2_DN
Net "usb_host_dp[1]" Loc = "IO_WB_B1";                    # /USB1_DP
Net "usb_host_dm[1]" Loc = "IO_WB_A1";                    # /USB1_DN

## VGA
##
## This is an RGB332 resistor DAC, not one pin per channel. Until
## rtl/gpu/gpu_video.v grows a wide output path (`GPU_VGA_RGB332 --
## see docs/lebkuchen.md), the single-bit VGA_R/VGA_G/VGA_B drive the
## MOST significant bit of each channel, which is the brightest a
## 1-bit-per-channel mapping can manage.
##
## NOTE this corrects the previous revision of this file, which had
## VGA_R on IO_EB_A4 (actually VGA_G0) and VGA_G on IO_EB_B5 (actually
## VGA_R0) -- red and green crossed, and both on their channel's LEAST
## significant bit, so white rendered as a dim off-colour grey.
##
## Full ladder, for when the wide path lands:
##   red    MSB->LSB  IO_EB_B4  IO_EB_A5  IO_EB_B5
##   green  MSB->LSB  IO_EB_A2  IO_EB_B2  IO_EB_A4
##   blue   MSB->LSB  IO_EB_B3  IO_EB_A3

Net "VGA_HS" Loc = "IO_EB_A0";                            # /VGA_HS
Net "VGA_VS" Loc = "IO_EB_B0";                            # /VGA_VS
Net "VGA_R"  Loc = "IO_EB_B4";                            # /VGA_R2
Net "VGA_G"  Loc = "IO_EB_A2";                            # /VGA_G2
Net "VGA_B"  Loc = "IO_EB_B3";                            # /VGA_B1

## WIRED ON THE BOARD, NOT YET USED BY THE GATEWARE
##
## Audio, 3.5mm TRRS tip/ring1, wants a sigma-delta stage (`AUDIO_SD):
##   AUDIO_L  IO_EB_A8      /AUDIO_L
##   AUDIO_R  IO_EB_B8      /AUDIO_R
##
## Composite video, 4-bit DAC on TRRS ring2:
##   COMP_DAC[3]  IO_NB_A8  /VIDEO_D3
##   COMP_DAC[2]  IO_NB_A6  /VIDEO_D2
##   COMP_DAC[1]  IO_NB_B8  /VIDEO_D1
##   COMP_DAC[0]  IO_NB_B6  /VIDEO_D0
##
## NOT available despite appearances: the schematic carries nets named
## /PMOD_D1, /PMOD_D2, /PMOD_D9 and /PMOD_D10 on IO_SB_B0, IO_SB_A0,
## IO_SA_A2 and IO_SA_A1. There is no PMOD socket on Lebkuchen and
## those nets go nowhere. Do not plan a `GPIO_PORT0 around them.
