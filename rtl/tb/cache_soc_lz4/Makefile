# rtl/tb/cache_soc_lz4: lz4.hex for rtl/tb/tb_cache_soc.v (+prog=...
# +expect=<ORIG_FNV from blob.h>). blob.h is generated by gen.py.
PREFIX ?= riscv64-unknown-elf-
CFLAGS = -march=rv32im -mabi=ilp32 -O2 -ffreestanding -nostdlib -fno-builtin \
	-fno-pic -mcmodel=medany -Wall -I../../../sw/common

lz4.hex: lz4.elf
	$(PREFIX)objcopy -O binary $< lz4.bin
	python3 -c "import sys,struct; d=open('lz4.bin','rb').read(); d+=b'\0'*(-len(d)%4); \
	[print('%08x'%struct.unpack('<I',d[i:i+4])[0]) for i in range(0,len(d),4)]" > $@

lz4.elf: start.S lz4.c blob.h link.ld
	$(PREFIX)gcc $(CFLAGS) -T link.ld -o $@ start.S lz4.c

clean:
	rm -f lz4.elf lz4.bin lz4.hex
